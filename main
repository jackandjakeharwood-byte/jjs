			if (atmosphere_effect) then atmosphere_effect.Glare = value; end;
		end;
	});

	other_visuals:add_slider("atmosphere_offset", {
		text = "offset";
		default = 0;
		min = 0;
		max = 1;
		rounding = 3;
		compact = true;
		callback = function(value)
			if (atmosphere_effect) then atmosphere_effect.Offset = value; end;
		end;
	});

	other_visuals:add_toggle("skybox_enabled", {
		text = "skybox";
		default = false;
		callback = function(enabled)
			if (enabled) then
				local preset = Options.skybox_value and Options.skybox_value.value or "black storm";
				apply_skybox(preset);
			else
				restore_skybox();
			end;
		end;
	});

	other_visuals:add_dropdown("skybox_value", {
		text = "skybox";
		default = "black storm";
		values = {"stormy", "blue space", "pink", "black storm", "realistic"};
		callback = function(value)
			if (Toggles.skybox_enabled and Toggles.skybox_enabled.value) then
				apply_skybox(value);
			end;
		end;
	});

	other_visuals:add_toggle("weather_enabled", {
		text = "weather";
		default = false;
		callback = function(enabled)
			if (enabled) then
				local wtype = Options.weather_type and Options.weather_type.value or "rain";
				create_weather(wtype);
			else
				destroy_weather();
			end;
			update_weather_connection();
		end;
	}):add_color_picker("weather_color", {
		default = color3_fromrgb(255, 255, 255);
		title = "weather color";
		transparency = 0;
		callback = function(value)
			if (weather_emitter) then
				weather_emitter.Color = colorsequence_new(value);
			end;
		end;
	});

	other_visuals:add_dropdown("weather_type", {
		text = "type";
		default = "rain";
		values = {"rain", "snow", "light rain"};
		callback = function(value)
			if (Toggles.weather_enabled and Toggles.weather_enabled.value) then
				create_weather(value);
			end;
		end;
	});

	other_visuals:add_slider("weather_rate", {
		text = "weather rate";
		default = 100;
		min = 1;
		max = 100;
		rounding = 0;
		compact = true;
		callback = function(value)
			if (weather_emitter) then
				weather_emitter.Rate = 1000 * (value / 100);
			end;
		end;
	});

	other_visuals:add_toggle("background_noise_enabled", {
		text = "background noise";
		default = false;
		callback = function(enabled)
			if (ambient_sound) then
				ambient_sound:Destroy();
				ambient_sound = nil;
			end;
			if (enabled) then
				local stype = Options.background_noise_sound and Options.background_noise_sound.value or "night";
				local sid = sound_presets[stype];
				if (sid) then
					ambient_sound = instance_new("Sound");
					ambient_sound.SoundId = sid;
					ambient_sound.Volume = (Options.background_noise_volume and Options.background_noise_volume.value or 25) / 65;
					ambient_sound.Looped = true;
					ambient_sound.Name = "\0";
					ambient_sound.Parent = gethui();
					ambient_sound:Play();
				end;
			end;
		end;
	});

	other_visuals:add_dropdown("background_noise_sound", {
		text = "sound";
		default = "night";
		values = {"windy winter", "thunderstorm", "light rain", "night", "day"};
		callback = function(value)
			if (ambient_sound) then
				local sid = sound_presets[value];
				if (sid) then
					ambient_sound.SoundId = sid;
					ambient_sound:Stop();
					ambient_sound:Play();
				end;
			end;
		end;
	});

	other_visuals:add_slider("background_noise_volume", {
		text = "volume";
		default = 25;
		min = 0;
		max = 100;
		rounding = 0;
		compact = true;
		callback = function(value)
			if (ambient_sound) then
				ambient_sound.Volume = value / 65;
			end;
		end;
	});

	other_visuals:add_toggle("motion_blur_enabled", {
		text = "motion blur";
		default = false;
		callback = function(enabled)
			if (blur_effect) then
				blur_effect:Destroy();
				blur_effect = nil;
			end;
			last_look_vector = nil;
			smoothed_blur = 0;
			if (enabled) then
				blur_effect = instance_new("BlurEffect");
				blur_effect.Size = 0;
				blur_effect.Parent = lighting;
			end;
			update_world_visuals_binding();
		end;
	});

	other_visuals:add_slider("motion_blur_intensity", {
		text = "blur intensity";
		default = 25;
		min = 0;
		max = 100;
		rounding = 1;
		compact = true;
	});

	other_visuals:add_toggle("aspect_ratio_enabled", {
