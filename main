	task_spawn(function()
		local content_provider = game:GetService("ContentProvider");
		local preload_instances = {};

		for _, preset in pairs(skybox_presets) do
			for _, url in pairs(preset) do
				local s = instance_new("Sky");
				s.SkyboxUp = url;
				preload_instances[#preload_instances + 1] = s;
			end;
		end;

		for _, preset in pairs(weather_presets) do
			if (preset.Texture) then
				local d = instance_new("Decal");
				d.Texture = preset.Texture;
				preload_instances[#preload_instances + 1] = d;
			end;
		end;

		for _, sound_id in pairs(sound_presets) do
			local s = instance_new("Sound");
			s.SoundId = sound_id;
			preload_instances[#preload_instances + 1] = s;
		end;

		if (#preload_instances > 0) then
			content_provider:PreloadAsync(preload_instances);
		end;

		for _, inst in pairs(preload_instances) do
			inst:Destroy();
		end;
	end);

	local visual_conns = {};
	local function manage_lighting(prop, class_name, object, default, toggle_name, direct_val)
		object = object or lighting;
		toggle_name = toggle_name or prop;
		local toggle = Toggles[toggle_name]
		local value_obj = Options[class_name]

		local conn_key = prop .. (object ~= lighting and object.Name or "");
		if visual_conns[conn_key] then
			visual_conns[conn_key]:Disconnect();
			visual_conns[conn_key] = nil;
		end;

		local is_active = toggle and (toggle.value ~= nil and toggle.value or toggle.Value);
		if is_active then
			local function force()
				local cur_active = toggle and (toggle.value ~= nil and toggle.value or toggle.Value);
				if cur_active then
					local val = direct_val;
					if val == nil and value_obj then
						val = (value_obj.value ~= nil and value_obj.value or value_obj.Value);
					end;
					if val ~= nil and object[prop] ~= val then
						object[prop] = val;
					end;
				end;
			end;

			force();
			visual_conns[conn_key] = object:GetPropertyChangedSignal(prop):Connect(force);
		else
			if toggle ~= nil and default ~= nil then
				object[prop] = default;
			end;
		end;
	end;

	local stored_atmosphere = atmosphere_effect;
	local function ensure_atmosphere()
		local atmos = lighting:FindFirstChild("atmosphere") or lighting:FindFirstChildOfClass("Atmosphere") or stored_atmosphere;
		if not atmos then
			atmos = instance_new("Atmosphere");
			atmos.Name = "atmosphere";
			stored_atmosphere = atmos;
		end;
		if atmos.Parent ~= lighting then
			atmos.Parent = lighting;
		end;
		return atmos;
	end;

	local function update_fog_and_atmosphere()
		local atmos = lighting:FindFirstChild("atmosphere") or lighting:FindFirstChildOfClass("Atmosphere") or stored_atmosphere;

		local legacy_active = (Toggles.FogEnd and (Toggles.FogEnd.value ~= nil and Toggles.FogEnd.value or Toggles.FogEnd.Value))
			or (Toggles.FogStart and (Toggles.FogStart.value ~= nil and Toggles.FogStart.value or Toggles.FogStart.Value))
			or (Toggles.FogColor and (Toggles.FogColor.value ~= nil and Toggles.FogColor.value or Toggles.FogColor.Value));

		if legacy_active then
			if atmos then
				atmos.Parent = nil;
			end;
		else
			local atmos_toggle = Toggles.atmosphere;
			local atmos_active = atmos_toggle and (atmos_toggle.value ~= nil and atmos_toggle.value or atmos_toggle.Value);
			if atmos_active then
				ensure_atmosphere();
			else
				if atmos then
					if original_atmosphere_existed then
						atmos.Parent = lighting;
						atmos.Density = original_atmosphere.Density;
					else
						atmos.Parent = nil;
					end;
				end;
			end;
		end;
	end;

	local function apply_fog()
		local atmos_toggle = Toggles.atmosphere;
		local is_active = atmos_toggle and (atmos_toggle.value ~= nil and atmos_toggle.value or atmos_toggle.Value);
		update_fog_and_atmosphere();
		if is_active then
			local atmos = ensure_atmosphere();
			manage_lighting("Density", "Density", atmos, original_atmosphere.Density, "atmosphere");
			manage_lighting("Decay", "DecayColor", atmos, original_atmosphere.Decay, "atmosphere");
			manage_lighting("Color", "AtmosColor", atmos, original_atmosphere.Color, "atmosphere");
			manage_lighting("Offset", "AtmosphereOffset", atmos, original_atmosphere.Offset, "atmosphere");
			manage_lighting("Glare", "Glare", atmos, original_atmosphere.Glare, "atmosphere");
			manage_lighting("Haze", "Haze", atmos, original_atmosphere.Haze, "atmosphere");
		end;
	end;

	local function apply_skybox()
		if visual_conns["Skybox"] then
			visual_conns["Skybox"]:Disconnect();
			visual_conns["Skybox"] = nil;
		end;

		local sky = lighting:FindFirstChildOfClass("Sky");
		if not sky then return; end;

		local function force()
			local sky_opt = Options.Skybox or Options.skybox_value;
			local sky_value = sky_opt and (sky_opt.value or sky_opt.Value);
			local preset = sky_value and skybox_presets[sky_value] or original_sky;
			if preset then
				for p, v in pairs(preset) do
					if sky[p] ~= v then sky[p] = v; end;
				end;
			end;
		end;

		force();
		visual_conns["Skybox"] = sky.Changed:Connect(force);
	end;

	local function apply_ambience()
		local outdoor_val = Options.OutdoorAmbientColor and (Options.OutdoorAmbientColor.value or Options.OutdoorAmbientColor.Value)
			or (Options.AmbientColor and (Options.AmbientColor.value or Options.AmbientColor.Value));
		manage_lighting("OutdoorAmbient", "OutdoorAmbientColor", lighting, OldAmbience, "Ambient", outdoor_val);
		manage_lighting("Ambient", "AmbientColor", lighting, OldAmbience2, "Ambient");
	end;

	local function apply_colorshift_bottom()
		manage_lighting("ColorShift_Bottom", "ColorShift_BottomColor", lighting, OldBottom, "ColorShift_Bottom");
	end;

	local function apply_colorshift_top()
		manage_lighting("ColorShift_Top", "ColorShift_TopColor", lighting, OldTop, "ColorShift_Top");
	end;

	local function apply_legacy_fog_color()
		manage_lighting("FogColor", "FogColorValue", lighting, OldFogColor, "FogColor");
		update_fog_and_atmosphere();
	end;

	local function apply_fog_end()
		manage_lighting("FogEnd", "FogEndValue", lighting, OldFogEnd, "FogEnd");
		update_fog_and_atmosphere();
	end;

	local function apply_fog_start()
		manage_lighting("FogStart", "FogStartValue", lighting, OldFogStart, "FogStart");
		update_fog_and_atmosphere();
	end;

	local function apply_clock()
		manage_lighting("ClockTime", "Time", lighting, OldClock, "ClockTime");
	end;

	local color_corr_conn = nil;
	local function get_color_correction()
		if not color_correction or not color_correction.Parent or not color_correction:IsDescendantOf(lighting) then
			color_correction = lighting:FindFirstChildOfClass("ColorCorrectionEffect");
			if not color_correction then
				color_correction = instance_new("ColorCorrectionEffect");
				color_correction.Name = "CustomColorCorrection";
				color_correction.Parent = lighting;
			end;
			if color_corr_conn then
				color_corr_conn:Disconnect();
				color_corr_conn = nil;
			end;
			color_corr_conn = color_correction.AncestryChanged:Connect(function(_, parent)
				if not parent or parent ~= lighting then
					color_correction = nil;
					task_defer(apply_colorcorrection);
				end;
			end);
		end;
		return color_correction;
	end;

	local function apply_colorcorrection()
		local cc = get_color_correction();
		if not cc then return; end;

		local cc_toggle = Toggles.ColorCorrection;
		if cc_toggle and (cc_toggle.value or cc_toggle.Value) then
			cc.TintColor = (Options.ColorCorrectionColor and (Options.ColorCorrectionColor.value or Options.ColorCorrectionColor.Value)) or color3_fromrgb(255, 255, 255);
		else
			cc.TintColor = OldCorrection or (original_lighting and original_lighting.tint_color) or color3_fromrgb(255, 255, 255);
		end;

		local sat_toggle = Toggles.saturation_enabled;
		if sat_toggle and (sat_toggle.value or sat_toggle.Value) then
			cc.Saturation = Options.saturation_value and Options.saturation_value.value or 0;
		else
			cc.Saturation = (original_lighting and original_lighting.saturation) or 0;
		end;

		local con_toggle = Toggles.contrast_enabled;
		if con_toggle and (con_toggle.value or con_toggle.Value) then
			cc.Contrast = Options.contrast_value and Options.contrast_value.value or 0;
		else
			cc.Contrast = (original_lighting and original_lighting.contrast) or 0;
		end;
	end;

	local function apply_brightness()
		manage_lighting("Brightness", "BrightnessValue", lighting, OldBrightness, "Brightness");
	end;

	local function apply_environmental()
		manage_lighting("EnvironmentDiffuseScale", "EnvironmentValue", lighting, OldDiffuse, "Environmental");
		manage_lighting("EnvironmentSpecularScale", "EnvironmentValue", lighting, OldDiffuse2, "Environmental");
	end;

	local function apply_exposure()
		manage_lighting("ExposureCompensation", "ExposureValue", lighting, OldExposure, "Exposure");
	end;

	local function create_weather(weather_type)
		if (weather_part) then
			weather_part:Destroy();
			weather_part = nil;
			weather_emitter = nil;
		end;

		weather_part = instance_new("Part");
		weather_part.Size = vector3_new(40, 40, 85);
		weather_part.CanCollide = false;
		weather_part.Massless = true;
		weather_part.CastShadow = false;
		weather_part.Transparency = 1;
		weather_part.Anchored = true;
		weather_part.Name = "\0";
		weather_part.Parent = workspace;

		local preset = weather_presets[weather_type];
		if (not preset) then return; end;

		weather_emitter = instance_new("ParticleEmitter");
		for prop, val in pairs(preset) do
			weather_emitter[prop] = val;
		end;

		local color = (Options.WeatherColor and (Options.WeatherColor.value or Options.WeatherColor.Value))
			or (Options.weather_color and (Options.weather_color.value or Options.weather_color.Value))
			or color3_fromrgb(255, 255, 255);
		weather_emitter.Color = colorsequence_new(color);
		weather_emitter.Parent = weather_part;
	end;

	local function destroy_weather()
		if (weather_part) then
			weather_part:Destroy();
			weather_part = nil;
			weather_emitter = nil;
		end;
	end;

	local function update_weather()
		local enabled = Toggles.weather_enabled and (Toggles.weather_enabled.value or Toggles.weather_enabled.Value);
		local weather_type = (Options.Weather and (Options.Weather.value or Options.Weather.Value))
			or (Options.weather_type and (Options.weather_type.value or Options.weather_type.Value));

		if enabled and weather_type then
			create_weather(weather_type);
		else
			destroy_weather();
		end;
		update_weather_connection();
	end;

	update_weather_connection = LPH_NO_VIRTUALIZE(function()
		local enabled = Toggles.weather_enabled and (Toggles.weather_enabled.value or Toggles.weather_enabled.Value);
		if enabled then
			if not weather_connection then
				weather_connection = create_connection(runservice.Heartbeat, LPH_JIT(function(dt)
					if (weather_part and weather_part.Parent) then
						weather_part.CFrame = cframe_new(camera.CFrame.Position + vector3_new(0, 20, 0));
					end;
				end));
			end;
		else
			if weather_connection then
				disconnect_connection(weather_connection);
				weather_connection = nil;
			end;
		end;
	end);

	local world_visuals_bound = false;
	update_world_visuals_binding = LPH_NO_VIRTUALIZE(function()
		local motion_blur = Toggles.motion_blur_enabled and (Toggles.motion_blur_enabled.value or Toggles.motion_blur_enabled.Value);
		local aspect_ratio = Toggles.aspect_ratio_enabled and (Toggles.aspect_ratio_enabled.value or Toggles.aspect_ratio_enabled.Value);
		local need_bind = motion_blur or aspect_ratio;

		if need_bind then
			if not world_visuals_bound then
				world_visuals_bound = true;
				runservice:BindToRenderStep("world_visuals_render", enum.RenderPriority.Camera.Value + 1, function(dt)
					if (Toggles.motion_blur_enabled and (Toggles.motion_blur_enabled.value or Toggles.motion_blur_enabled.Value) and blur_effect) then
						local look = camera.CFrame.LookVector;
						if (last_look_vector) then
							local intensity = (Options.motion_blur_intensity and (Options.motion_blur_intensity.value or Options.motion_blur_intensity.Value)) or 25;
							local delta = (look - last_look_vector).Magnitude * (intensity * 110) * dt;
							smoothed_blur = smoothed_blur + (delta - smoothed_blur) * math_min(dt * 900, 1);
							blur_effect.Size = smoothed_blur;
						end;
						last_look_vector = look;
					else
						last_look_vector = nil;
						smoothed_blur = 0;
					end;
					if (Toggles.aspect_ratio_enabled and (Toggles.aspect_ratio_enabled.value or Toggles.aspect_ratio_enabled.Value)) then
						local v = (Options.aspect_ratio_value and (Options.aspect_ratio_value.value or Options.aspect_ratio_value.Value)) or 1;
						camera.CFrame = camera.CFrame * cframe_new(0, 0, 0, 1, 0, 0, 0, v, 0, 0, 0, 1);
					end;
				end);
			end;
		else
			if world_visuals_bound then
				world_visuals_bound = false;
				runservice:UnbindFromRenderStep("world_visuals_render");
				last_look_vector = nil;
				smoothed_blur = 0;
			end;
		end;
	end);

	atmosphere_tab:add_toggle("atmosphere", {
		text = "atmosphere";
		default = false;
		callback = apply_fog;
	}):add_color_picker("AtmosColor", {
		default = color3_fromrgb(255, 255, 255);
		title = "atmosphere color";
		transparency = 0;
		callback = apply_fog;
	}):add_color_picker("DecayColor", {
		default = color3_fromrgb(120, 120, 120);
		title = "decay color";
		transparency = 0;
		callback = apply_fog;
	});

	atmosphere_tab:add_slider("Density", {
		text = "density";
		default = 0.35;
		min = 0;
		max = 1;
		rounding = 2;
		compact = true;
		tooltip = "Atmosphere Density";
		callback = apply_fog;
	});

	atmosphere_tab:add_slider("Glare", {
		text = "glare";
		default = 10;
		min = 0;
		max = 10;
		rounding = 2;
		compact = true;
		tooltip = "Atmosphere Glare";
		callback = apply_fog;
	});

	atmosphere_tab:add_slider("Haze", {
		text = "haze";
		default = 1;
		min = 0;
		max = 10;
		rounding = 2;
		compact = true;
