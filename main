		default = 1;
		min = 0.1;
		max = 1.2;
		rounding = 2;
		compact = true;
	});

	other_visuals:add_toggle("disable_rendering", {
		text = "disable rendering";
		default = false;
		callback = function(enabled)
			runservice:Set3dRenderingEnabled(not enabled);
		end;
