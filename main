end;

do
	local self_highlight = nil;
	local self_highlight_char_conn = nil;
	local self_material_char_conn = nil;
	local self_material_active = false;
	local particle_aura_conn = nil;
	local particle_aura_active = false;
	local aura_particles = {};

	local body_part_names = {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "HumanoidRootPart", "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot"};

	local original_part_data = {};

	local particle_aura_assets = {
		["starlight"] = "rbxassetid://134645216613107";
		["heavenly"] = "rbxassetid://139300897520961";
		["ribbon"] = "rbxassetid://132069507632161";
		["sakura"] = "rbxassetid://81755778619404";
		["angel"] = "rbxassetid://97658130917593";
		["wind"] = "rbxassetid://80694081850877";
		["flow"] = "rbxassetid://119913533725648";
		["star"] = "rbxassetid://73754563740680";
	};

	local particle_aura_cache = {};
	local current_aura_model = nil;

	local function load_aura(name)
		if (particle_aura_cache[name]) then
			return particle_aura_cache[name];
		end;
		local asset_id = particle_aura_assets[name];
		if (not asset_id) then return nil; end;
		local model = game:GetObjects(asset_id)[1];
		if (model) then
			particle_aura_cache[name] = model;
			return model;
		end;
		return nil;
	end;

	local function recolor_aura_model(model, color_value)
		if (not model) then return; end;
		local color_seq = colorsequence_new(color_value);
		for _, desc in ipairs(model:GetDescendants()) do
			local cn = desc.ClassName;
			if (cn == "PointLight") then
				desc.Color = color_value;
			elseif (cn == "ParticleEmitter" or cn == "Beam" or cn == "Trail") then
				desc.Color = color_seq;
			end;
		end;
	end;

	local function clear_aura_particles()
		for i = 1, #aura_particles do
			if (aura_particles[i] and aura_particles[i].Parent) then
				aura_particles[i]:Destroy();
			end;
			aura_particles[i] = nil;
		end;
		aura_particles = {};
	end;

	local apply_aura = LPH_NO_VIRTUALIZE(function()
		clear_aura_particles();
		if (not particle_aura_active or not current_aura_model) then return; end;
		local char = localplayer.Character;
		if (not char) then return; end;
		local hrp = char:FindFirstChild("HumanoidRootPart");
		if (not hrp) then return; end;

		local cloned = current_aura_model:Clone();
		for _, part in ipairs(cloned:GetChildren()) do
			local target = char:FindFirstChild(part.Name);
			if (target) then
				for _, child in ipairs(part:GetChildren()) do
					child.Name = "\0\0";
					child.Parent = target;
					aura_particles[#aura_particles + 1] = child;
				end;
			else
				part:Destroy();
			end;
		end;
		cloned:Destroy();
	end);

	local apply_self_highlight = LPH_JIT(function()
		if (not self_highlight) then return; end;
		local char = localplayer.Character;
		if (not char) then return; end;
		self_highlight.Adornee = char;
	end);

	local apply_self_material = LPH_NO_VIRTUALIZE(function()
		if (not self_material_active) then return; end;
		local char = localplayer.Character;
		if (not char) then return; end;

		local material_name = Options.self_material_type and Options.self_material_type.value or "Neon";
		local mat = enum.Material[material_name] or enum.Material.Neon;
		local col = Options.self_material_color and Options.self_material_color.value or color3_fromrgb(249, 217, 255);
		local trans = Options.self_material_transparency and Options.self_material_transparency.transparency or 0.2;

		for _, name in ipairs(body_part_names) do
			local part = char:FindFirstChild(name);
			if (part and part:IsA("BasePart")) then
				if (not original_part_data[part]) then
					original_part_data[part] = {
						material = part.Material;
						color = part.Color;
						transparency = part.Transparency;
					};
				end;
				if (part.Name == "HumanoidRootPart" or part.Transparency >= 1) then
				else
					part.Material = mat;
					part.Color = col;
					part.Transparency = trans;
				end;
			end;
		end;

		for _, child in ipairs(char:GetChildren()) do
			if (child:IsA("Accessory")) then
				local handle = child:FindFirstChild("Handle");
				if (handle and handle:IsA("MeshPart")) then
					if (not original_part_data[handle]) then
						original_part_data[handle] = {
							material = handle.Material;
							color = handle.Color;
							transparency = handle.Transparency;
							texture_id = handle.TextureID;
						};
					end;
					handle.Material = mat;
					handle.TextureID = "";
					handle.Color = col;
					handle.Transparency = trans;
				end;
			end;
		end;

		local shirt = char:FindFirstChildOfClass("Shirt");
		if (shirt and shirt.ShirtTemplate ~= "") then
			if (not shirt:GetAttribute("_orig_shirt")) then
				shirt:SetAttribute("_orig_shirt", shirt.ShirtTemplate);
			end;
			shirt.ShirtTemplate = "";
		end;

		local pants = char:FindFirstChildOfClass("Pants");
		if (pants and pants.PantsTemplate ~= "") then
			if (not pants:GetAttribute("_orig_pants")) then
				pants:SetAttribute("_orig_pants", pants.PantsTemplate);
			end;
			pants.PantsTemplate = "";
		end;
	end);

	local restore_self_material = LPH_JIT(function()
		local char = localplayer.Character;
		if (not char) then
			original_part_data = {};
			return;
		end;

		for part, data in pairs(original_part_data) do
			if (part and part.Parent) then
				part.Material = data.material;
				part.Color = data.color;
				part.Transparency = data.transparency;
				if (data.texture_id and part:IsA("MeshPart")) then
					part.TextureID = data.texture_id;
				end;
			end;
		end;
		original_part_data = {};

		local shirt = char:FindFirstChildOfClass("Shirt");
		if (shirt) then
			local orig = shirt:GetAttribute("_orig_shirt");
			if (orig) then
				shirt.ShirtTemplate = orig;
				shirt:SetAttribute("_orig_shirt", nil);
			end;
		end;

		local pants = char:FindFirstChildOfClass("Pants");
		if (pants) then
			local orig = pants:GetAttribute("_orig_pants");
			if (orig) then
				pants.PantsTemplate = orig;
				pants:SetAttribute("_orig_pants", nil);
			end;
		end;
	end);

	self_visuals:add_toggle("self_highlight_enabled", {
		text = "character highlight";
		default = false;
		callback = function(enabled)
			if (self_highlight_char_conn) then
				self_highlight_char_conn:Disconnect();
				self_highlight_char_conn = nil;
			end;

			if (self_highlight) then
				self_highlight:Destroy();
