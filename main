					TargetInfo.last_font = nil;
					TargetInfo.last_font_size = nil;
					TargetInfo.last_settings_version = -1;

					local init_font = ESP.Font;
					local init_font_size = get_scaled_fontsize();
					for i = 1, #text_labels do
						local obj = text_labels[i];
						obj.TextSize = init_font_size;
						if init_font then
							obj.FontFace = init_font;
						end;
					end;
					TargetInfo.last_font = init_font;
					TargetInfo.last_font_size = init_font_size;

					ESP.Targets[Target] = TargetInfo;

					TargetCount = TargetCount + 1;
					TargetList[TargetCount] = TargetInfo;
					TargetInfo.ListIndex = TargetCount;
				end;

				TargetInfo.Update = LPH_JIT_MAX(function(dt)
					local TargetHolder = Objects.TargetHolder;

					if (not cached_settings.LocalPlayer) and Target == Client then
						if TargetInfo.HolderVisible then
							TargetInfo.HolderVisible = false;
							TargetHolder.Visible = false;
						end;
						return;
					end;

					local char = CharacterObjects.Character;
					if not char then
						if TargetInfo.HolderVisible then
							TargetInfo.HolderVisible = false;
							TargetHolder.Visible = false;
						end;
						return;
					end;

					local hrp = CharacterObjects.HumanoidRootPart;
					if not hrp or hrp.Parent == nil then
						if is_player then
							hrp = FindFirstChild(char, "HumanoidRootPart");
							CharacterObjects.HumanoidRootPart = hrp;
						else
							hrp = Target:IsA("BasePart") and Target or char.PrimaryPart;
							CharacterObjects.HumanoidRootPart = hrp;
						end;
						if not hrp or hrp.Parent == nil then
							if TargetInfo.HolderVisible then
								TargetInfo.HolderVisible = false;
								TargetHolder.Visible = false;
							end;
							return;
						end;
					end;

					if is_player and not CharacterObjects.Humanoid then
						CharacterObjects.Humanoid = CharacterObjects.Character:FindFirstChildWhichIsA("Humanoid");
						if not CharacterObjects.Humanoid then
							if TargetInfo.HolderVisible then
								TargetInfo.HolderVisible = false;
								TargetHolder.Visible = false;
							end;
							return;
						end;
					end;

					local rootpos = hrp.Position;
					local dx = cur_cam_pos.X - rootpos.X;
					local dy = cur_cam_pos.Y - rootpos.Y;
					local dz = cur_cam_pos.Z - rootpos.Z;
					local dist_sq = dx * dx + dy * dy + dz * dz;
					if dist_sq > cached_settings.MaxDistanceSq then
						if TargetInfo.HolderVisible then
							TargetInfo.HolderVisible = false;
							TargetHolder.Visible = false;
						end;
						return;
					end;

					local parts = cached_settings.BoxIncludeAccessories and CharacterObjects.AllParts or CharacterObjects.BodyParts;
					if Target:IsA("BasePart") then
						parts = { Target };
					end;

					local boxwidth, boxheight, boxposx, boxposy, onscreen = calculate_box(Target, hrp, parts);
					if not onscreen then
						if TargetInfo.HolderVisible then
							TargetInfo.HolderVisible = false;
							TargetHolder.Visible = false;
						end;
						return;
					end;

					local current_fontsize = get_scaled_fontsize();
					local current_font = ESP.Font;
					if TargetInfo.last_font ~= current_font or TargetInfo.last_font_size ~= current_fontsize then
						TargetInfo.last_font = current_font;
						TargetInfo.last_font_size = current_fontsize;
						local text_labels = TargetInfo.text_labels;
						for i = 1, #text_labels do
							local obj = text_labels[i];
							obj.TextSize = current_fontsize;
							if current_font then
								obj.FontFace = current_font;
							end;
						end;
					end;

					local settings_changed = (TargetInfo.last_settings_version ~= ESP.settings_version);
					if settings_changed then
						TargetInfo.last_settings_version = ESP.settings_version;
					end;

					local bw = math_floor(boxwidth);
					local bh = math_floor(boxheight);
					local bx = math_floor(boxposx);
					local by = math_floor(boxposy);

					if not TargetInfo.HolderVisible then
						TargetInfo.HolderVisible = true;
						TargetHolder.Visible = true;
					end;

					if bx ~= TargetInfo.LastBoxX or by ~= TargetInfo.LastBoxY or bw ~= TargetInfo.LastBoxW or bh ~= TargetInfo.LastBoxH then
						TargetInfo.LastBoxX = bx;
						TargetInfo.LastBoxY = by;
						TargetInfo.LastBoxW = bw;
						TargetInfo.LastBoxH = bh;
						TargetHolder.Position = udim2_fromoffset(bx, by);
						TargetHolder.Size = udim2_fromoffset(bw, bh);
						TargetInfo.BoxSizeChanged = true;
					else
						TargetInfo.BoxSizeChanged = false;
					end;

					if cached_settings.BoxEnabled then
						if not TargetInfo.BoxVisible then
							TargetInfo.BoxVisible = true;
							Objects.BoxOutlineHolder.Visible = true;
							Objects.BoxInlineHolder.Visible = true;
						end;

						if TargetInfo.BoxSizeChanged then
							local cachedSize = udim2_fromoffset(bw, bh);
							Objects.BoxOutlineHolder.Size = cachedSize;
							Objects.BoxInlineHolder.Size = udim2_fromoffset(bw + 2, bh + 2);
							if cached_settings.FillEnabled then
								Objects.BoxFill.Size = cachedSize;
							end;
						end;

						if settings_changed then
							Objects.BoxInlineGradient.Color = cached_settings.BoxInlineColorSeq;
							Objects.BoxInlineGradient.Transparency = cached_settings.BoxTransSeq;
							Objects.BoxOutlineGradient.Transparency = cached_settings.BoxTransSeq;
							if Objects.BoxInlineGradient.Rotation ~= cached_settings.BoxRotation then
								Objects.BoxInlineGradient.Rotation = cached_settings.BoxRotation;
								Objects.BoxOutlineGradient.Rotation = cached_settings.BoxRotation;
							end;
						end;

						if cached_settings.GlowEnabled then
							if not TargetInfo.GlowVisible then
								TargetInfo.GlowVisible = true;
								Objects.BoxGlow.ImageTransparency = 0;
							end;
							if settings_changed then
								Objects.BoxGlowGradient.Rotation = cached_settings.GlowRotation;
								Objects.BoxGlowGradient.Color = cached_settings.GlowColorSeq;
								Objects.BoxGlowGradient.Transparency = cached_settings.GlowTransSeq;
							end;
						else
							if TargetInfo.GlowVisible then
								TargetInfo.GlowVisible = false;
								Objects.BoxGlow.ImageTransparency = 1;
							end;
						end;

						if cached_settings.FillEnabled then
							if not TargetInfo.FillVisible then
								TargetInfo.FillVisible = true;
								Objects.BoxFill.Visible = true;
								Objects.BoxFill.Size = udim2_fromoffset(bw, bh);
							end;
							if settings_changed then
								Objects.BoxFillGradient.Rotation = cached_settings.FillRotation;
								Objects.BoxFillGradient.Color = cached_settings.FillColorSeq;
								Objects.BoxFillGradient.Transparency = cached_settings.FillTransSeq;
							end;
						else
							if TargetInfo.FillVisible then
								TargetInfo.FillVisible = false;
								Objects.BoxFill.Visible = false;
							end;
						end;
					else
						if TargetInfo.BoxVisible then
							TargetInfo.BoxVisible = false;
							Objects.BoxOutlineHolder.Visible = false;
							Objects.BoxInlineHolder.Visible = false;
							if TargetInfo.FillVisible then
								TargetInfo.FillVisible = false;
								Objects.BoxFill.Visible = false;
							end;
						end;
						if TargetInfo.GlowVisible then
							TargetInfo.GlowVisible = false;
							Objects.BoxGlow.ImageTransparency = 1;
						end;
					end;

					if cached_settings.HpBarEnabled then
						local targetVal = cached_settings.HpBarType(Target, TargetInfo);
						local disp = TargetInfo.HpBarDisp or targetVal;
						local diff = targetVal - disp;
						if math_abs(diff) < 0.002 then
							disp = targetVal;
						else
							disp = disp + diff * math_min(dt * 6, 1);
						end;
						TargetInfo.HpBarDisp = disp;

						local holder = Objects[cached_settings.HpBarPosition .. "BarHolder"];
						if not TargetInfo.HpBarHolderVisible then
							TargetInfo.HpBarHolderVisible = true;
							holder.Visible = true;
						end;

						if settings_changed or not TargetInfo.HpBarLayoutReady then
							TargetInfo.HpBarLayoutReady = true;
							local is_vert = (cached_settings.HpBarPosition == "Left" or cached_settings.HpBarPosition == "Right");
							if Objects.HealthBarOutline.Parent ~= holder then
								Objects.HealthBarOutline.Parent = holder;
							end;
							Objects.HealthBarOutline.Size = is_vert and UDim2_0_1_1_0 or UDim2_1_0_0_1;
							Objects.HealthBar.AnchorPoint = is_vert and Vec2_0_1 or Vec2_0_0;
							Objects.HealthBar.Position = is_vert and UDim2_0_0_1_0 or UDim2_0_0_0_0;
							Objects.HealthBarGradient.Rotation = is_vert and 90 or -180;
							Objects.HealthBarGradient.Color = cached_settings.HpBarColorSeq;
						end;

						if math_abs(disp - TargetInfo.LastAppliedHpDisp) >= 0.002 then
							TargetInfo.LastAppliedHpDisp = disp;
							local is_vert = (cached_settings.HpBarPosition == "Left" or cached_settings.HpBarPosition == "Right");
							Objects.HealthBar.Size = is_vert and udum2_new(0, 1, disp, 0) or udum2_new(disp, 0, 0, 1);
							Objects.HealthBarGradient.Offset = is_vert and vector2_new(0, disp - 1) or vector2_new(1 - disp, 0);
						end;
					else
						if TargetInfo.HpBarHolderVisible then
							TargetInfo.HpBarHolderVisible = false;
							Objects[cached_settings.HpBarPosition .. "BarHolder"].Visible = false;
						end;
					end;

					if cached_settings.HpBarTextEnabled then
						local textVal, textVis = cached_settings.HpBarTextType(Target, TargetInfo);
						local intVal = math_floor(textVal);
						if intVal ~= TargetInfo.LastHpTextInt then
							TargetInfo.LastHpTextInt = intVal;
							TargetInfo.LastHpTextStr = tostring(intVal) .. cached_settings.HpBarTextEnding;
							Objects.HealthBarText.Text = TargetInfo.LastHpTextStr;
						end;

						if settings_changed then
							local textObj = Objects.HealthBarText;
							textObj.TextColor3 = cached_settings.HpBarTextColor;
							textObj.TextTransparency = cached_settings.HpBarTextTrans;
							Objects.HealthBarTextStroke.Transparency = cached_settings.HpBarTextTrans;

							if cached_settings.HpBarTextFollow then
								if textObj.Parent ~= Objects.HealthBar then
									textObj.Parent = Objects.HealthBar;
									textObj.ZIndex = 10;
								end;
								local is_vert = (cached_settings.HpBarPosition == "Left" or cached_settings.HpBarPosition == "Right");
								textObj.TextXAlignment = is_vert and enum.TextXAlignment.Center or enum.TextXAlignment.Right;
								textObj.AnchorPoint = is_vert and Vec2_05_0 or Vec2_0_05;
							else
								local targetParent = Objects[cached_settings.HpBarTextPosition .. "TextHolder"];
								if textObj.Parent ~= targetParent then
									textObj.Parent = targetParent;
								end;
								textObj.TextXAlignment = TextAlignments[cached_settings.HpBarTextPosition];
								textObj.AnchorPoint = Vec2_0_0;
							end;
						end;

						local shouldVis = (not cached_settings.HpBarTextFollow) or textVis;
						if TargetInfo.HpTextVisible ~= shouldVis then
							TargetInfo.HpTextVisible = shouldVis;
							Objects.HealthBarText.Visible = shouldVis;
						end;
					else
						if TargetInfo.HpTextVisible then
							TargetInfo.HpTextVisible = false;
							Objects.HealthBarText.Visible = false;
						end;
					end;

					if cached_settings.ArmBarEnabled then
						local targetVal = cached_settings.ArmBarType(Target, TargetInfo);
						local disp = TargetInfo.ArmBarDisp or targetVal;
						local diff = targetVal - disp;
						if math_abs(diff) < 0.002 then
							disp = targetVal;
						else
							disp = disp + diff * math_min(dt * 6, 1);
						end;
						TargetInfo.ArmBarDisp = disp;

						local holder = Objects[cached_settings.ArmBarPosition .. "BarHolder"];
						if not TargetInfo.ArmBarHolderVisible then
							TargetInfo.ArmBarHolderVisible = true;
							holder.Visible = true;
						end;

						if settings_changed or not TargetInfo.ArmBarLayoutReady then
							TargetInfo.ArmBarLayoutReady = true;
							local is_vert = (cached_settings.ArmBarPosition == "Left" or cached_settings.ArmBarPosition == "Right");
							if Objects.ArmorBarOutline.Parent ~= holder then
								Objects.ArmorBarOutline.Parent = holder;
							end;
							Objects.ArmorBarOutline.Size = is_vert and UDim2_0_1_1_0 or UDim2_1_0_0_1;
							Objects.ArmorBar.AnchorPoint = is_vert and Vec2_0_1 or Vec2_0_0;
							Objects.ArmorBar.Position = is_vert and UDim2_0_0_1_0 or UDim2_0_0_0_0;
							Objects.ArmorBarGradient.Rotation = is_vert and 90 or -180;
							Objects.ArmorBarGradient.Color = cached_settings.ArmBarColorSeq;
						end;

						if math_abs(disp - TargetInfo.LastAppliedArmDisp) >= 0.002 then
							TargetInfo.LastAppliedArmDisp = disp;
							local is_vert = (cached_settings.ArmBarPosition == "Left" or cached_settings.ArmBarPosition == "Right");
							Objects.ArmorBar.Size = is_vert and udum2_new(0, 1, disp, 0) or udum2_new(disp, 0, 0, 1);
							Objects.ArmorBarGradient.Offset = is_vert and vector2_new(0, disp - 1) or vector2_new(1 - disp, 0);
						end;
					else
						if TargetInfo.ArmBarHolderVisible then
							TargetInfo.ArmBarHolderVisible = false;
							Objects[cached_settings.ArmBarPosition .. "BarHolder"].Visible = false;
						end;
					end;

					if cached_settings.ArmBarTextEnabled then
						local textVal, textVis = cached_settings.ArmBarTextType(Target, TargetInfo);
						local intVal = math_floor(textVal);
						if intVal ~= TargetInfo.LastArmTextInt then
							TargetInfo.LastArmTextInt = intVal;
							TargetInfo.LastArmTextStr = tostring(intVal) .. cached_settings.ArmBarTextEnding;
							Objects.ArmorBarText.Text = TargetInfo.LastArmTextStr;
						end;

						if settings_changed then
							local textObj = Objects.ArmorBarText;
							textObj.TextColor3 = cached_settings.ArmBarTextColor;
							textObj.TextTransparency = cached_settings.ArmBarTextTrans;
							Objects.ArmorBarTextStroke.Transparency = cached_settings.ArmBarTextTrans;

							if cached_settings.ArmBarTextFollow then
								if textObj.Parent ~= Objects.ArmorBar then
									textObj.Parent = Objects.ArmorBar;
									textObj.ZIndex = 10;
								end;
								local is_vert = (cached_settings.ArmBarPosition == "Left" or cached_settings.ArmBarPosition == "Right");
								textObj.TextXAlignment = is_vert and enum.TextXAlignment.Center or enum.TextXAlignment.Right;
								textObj.AnchorPoint = is_vert and Vec2_05_0 or Vec2_0_05;
							else
								local targetParent = Objects[cached_settings.ArmBarTextPosition .. "TextHolder"];
								if textObj.Parent ~= targetParent then
									textObj.Parent = targetParent;
								end;
								textObj.TextXAlignment = TextAlignments[cached_settings.ArmBarTextPosition];
								textObj.AnchorPoint = Vec2_0_0;
							end;
						end;

						local shouldVis = (not cached_settings.ArmBarTextFollow) or textVis;
						if TargetInfo.ArmTextVisible ~= shouldVis then
							TargetInfo.ArmTextVisible = shouldVis;
							Objects.ArmorBarText.Visible = shouldVis;
						end;
					else
						if TargetInfo.ArmTextVisible then
							TargetInfo.ArmTextVisible = false;
							Objects.ArmorBarText.Visible = false;
						end;
					end;

					if cached_settings.NameEnabled then
						if settings_changed then
							local textObj = Objects.TargetName;
							local parent = Objects[cached_settings.NamePosition .. "TextHolder"];
							if textObj.Parent ~= parent then
								textObj.Parent = parent;
							end;
							textObj.TextXAlignment = TextAlignments[cached_settings.NamePosition];
							textObj.TextColor3 = cached_settings.NameColor;
							textObj.TextTransparency = cached_settings.NameTransparency;
							Objects.TargetNameStroke.Transparency = cached_settings.NameTransparency;
							TargetInfo.RawName = is_player and (cached_settings.NameUseDisplay and Target.DisplayName or Target.Name) or Target.Name;
							TargetInfo.FormattedName = get_font_type(TargetInfo.RawName);
							textObj.Text = TargetInfo.FormattedName;
						end;

						if not TargetInfo.NameVisible then
							TargetInfo.NameVisible = true;
							Objects.TargetName.Visible = true;
							if not TargetInfo.FormattedName then
								TargetInfo.RawName = is_player and (cached_settings.NameUseDisplay and Target.DisplayName or Target.Name) or Target.Name;
								TargetInfo.FormattedName = get_font_type(TargetInfo.RawName);
								Objects.TargetName.Text = TargetInfo.FormattedName;
							end;
						end;
					else
						if TargetInfo.NameVisible then
							TargetInfo.NameVisible = false;
							Objects.TargetName.Visible = false;
						end;
					end;

					if cached_settings.DistEnabled then
						if settings_changed then
							local textObj = Objects.Distance;
							local parent = Objects[cached_settings.DistPosition .. "TextHolder"];
							if textObj.Parent ~= parent then
								textObj.Parent = parent;
							end;
							textObj.TextXAlignment = TextAlignments[cached_settings.DistPosition];
							textObj.TextColor3 = cached_settings.DistColor;
							textObj.TextTransparency = cached_settings.DistTransparency;
							Objects.DistanceStroke.Transparency = cached_settings.DistTransparency;
							TargetInfo.LastDistInt = -1;
						end;

						local distance = math_sqrt(dist_sq);
						local distInt = math_floor(distance);
						if distInt ~= TargetInfo.LastDistInt then
							TargetInfo.LastDistInt = distInt;
							TargetInfo.LastDistStr = tostring(distInt) .. cached_settings.DistEnding;
							Objects.Distance.Text = TargetInfo.LastDistStr;
						end;

						if not TargetInfo.DistVisible then
							TargetInfo.DistVisible = true;
							Objects.Distance.Visible = true;
						end;
					else
						if TargetInfo.DistVisible then
							TargetInfo.DistVisible = false;
							Objects.Distance.Visible = false;
						end;
					end;

					if cached_settings.WeapEnabled then
						if settings_changed then
							local textObj = Objects.Weapon;
							local parent = Objects[cached_settings.WeapPosition .. "TextHolder"];
							if textObj.Parent ~= parent then
								textObj.Parent = parent;
							end;
							textObj.TextXAlignment = TextAlignments[cached_settings.WeapPosition];
							textObj.TextColor3 = cached_settings.WeapColor;
							textObj.TextTransparency = cached_settings.WeapTransparency;
							Objects.WeaponStroke.Transparency = cached_settings.WeapTransparency;
						end;

						local curTool = TargetInfo.CurrentTool;
						if TargetInfo.LastWeapStr ~= curTool then
							TargetInfo.LastWeapStr = curTool;
							Objects.Weapon.Text = curTool;
						end;

						if not TargetInfo.WeapVisible then
							TargetInfo.WeapVisible = true;
							Objects.Weapon.Visible = true;
						end;
					else
						if TargetInfo.WeapVisible then
							TargetInfo.WeapVisible = false;
							Objects.Weapon.Visible = false;
						end;
					end;

					if cached_settings.FlagsEnabled then
						if settings_changed then
							local textObj = Objects.Flags;
							local parent = Objects[cached_settings.FlagsPosition .. "TextHolder"];
							if textObj.Parent ~= parent then
								textObj.Parent = parent;
							end;
							textObj.TextXAlignment = TextAlignments[cached_settings.FlagsPosition];
							textObj.TextColor3 = cached_settings.FlagsColor;
							textObj.TextTransparency = cached_settings.FlagsTransparency;
							Objects.FlagsStroke.Transparency = cached_settings.FlagsTransparency;
						end;

						local flagsStr = cached_settings.FlagsType(Target, TargetInfo);
						if TargetInfo.LastFlagsStr ~= flagsStr then
							TargetInfo.LastFlagsStr = flagsStr;
							Objects.Flags.Text = flagsStr;
						end;

						if not TargetInfo.FlagsVisible then
							TargetInfo.FlagsVisible = true;
							Objects.Flags.Visible = true;
						end;
					else
						if TargetInfo.FlagsVisible then
							TargetInfo.FlagsVisible = false;
							Objects.Flags.Visible = false;
						end;
					end;
				end);

				function TargetInfo.Remove()
					for _, Object in Objects do
						Object:Destroy();
					end;
					for key, val in pairs(ObjectsTable) do
						if val == Objects then
							ObjectsTable[key] = nil;
						end;
					end;
					if TargetInfo.CharacterConnection then
						TargetInfo.CharacterConnection:Disconnect();
						TargetInfo.CharacterConnection = nil;
					end;
					if TargetInfo.HealthConnection then
						TargetInfo.HealthConnection:Disconnect();
						TargetInfo.HealthConnection = nil;
					end;
					if ToolConnection.Added then
						ToolConnection.Added:Disconnect();
						ToolConnection.Added = nil;
					end;
					if ToolConnection.ItemChanged then
						ToolConnection.ItemChanged:Disconnect();
						ToolConnection.ItemChanged = nil;
					end;
					if ToolConnection.Removed then
						ToolConnection.Removed:Disconnect();
						ToolConnection.Removed = nil;
					end;
					if ToolConnection.InfoChildAdded then
						ToolConnection.InfoChildAdded:Disconnect();
						ToolConnection.InfoChildAdded = nil;
					end;
					if ToolConnection.InfoChildRemoved then
						ToolConnection.InfoChildRemoved:Disconnect();
						ToolConnection.InfoChildRemoved = nil;
					end;
					if ToolConnection.ItemRenamed then
						ToolConnection.ItemRenamed:Disconnect();
						ToolConnection.ItemRenamed = nil;
					end;

					local idx = TargetInfo.ListIndex;
					if idx then
						local last = TargetList[TargetCount];
						TargetList[idx] = last;
						if last then
							last.ListIndex = idx;
						end;
						TargetList[TargetCount] = nil;
						TargetCount = TargetCount - 1;
						TargetInfo.ListIndex = nil;
					end;

					ESP.Targets[Target] = nil;
				end;
			end;

			TargetInfo.Init();
		end;

		function ESP.RemoveTarget(NewTarget)
			local ti = ESP.Targets[NewTarget];
			if ti then
				ti.Remove();
			end;
		end;

		function ESP.Unload()
			for _, Connection in ESP.Connections do
				Connection:Disconnect();
			end;
			for _, Object in ESP.Objects do
				Object:Destroy();
			end;
			getgenv().Fonts = nil;
		end;
	end;

	do
		for _, Player in Players:GetPlayers() do
			ESP.AddTarget(Player);
		end;

		local chars = workspace:FindFirstChild("Characters");
		if (chars) then
			for _, model in chars:GetChildren() do
				if (model ~= localplayer.Character and model.Name == "Dummy") then
					ESP.AddTarget(model);
				end;
			end;

			add_connection(chars.ChildAdded, LPH_JIT(function(model)
				if (model ~= localplayer.Character and model.Name == "Dummy") then
					ESP.AddTarget(model);
				end;
			end));

			add_connection(chars.ChildRemoved, LPH_JIT(function(model)
				ESP.RemoveTarget(model);
			end));
		end;

		add_connection(Players.PlayerAdded, LPH_JIT(function(Player)
			ESP.AddTarget(Player);
		end));

		add_connection(Players.PlayerRemoving, LPH_JIT(function(Player)
			ESP.RemoveTarget(Player);
		end));

		local esp_bound = false;
		update_esp_binding = LPH_NO_VIRTUALIZE(function()
			local enabled = cached_settings.Enabled and (
				cached_settings.BoxEnabled or
				cached_settings.GlowEnabled or
				cached_settings.FillEnabled or
				cached_settings.HpBarEnabled or
				cached_settings.ArmBarEnabled or
				cached_settings.NameEnabled or
				cached_settings.DistEnabled or
				cached_settings.WeapEnabled or
				cached_settings.FlagsEnabled
			);
			if enabled then
				if not esp_bound then
					esp_bound = true;
					runservice:BindToRenderStep("ESP_Update", enum.RenderPriority.Camera.Value + 1, function(dt)
						cur_cam = Camera;
						if not cur_cam then return; end;
						cur_cam_pos = cur_cam.CFrame.Position;
						local cam_fov = cur_cam.FieldOfView;
						local vp = cur_cam.ViewportSize;
						local fov_scale = CONST_TAN_35 / math_tan(cam_fov * DEG_TO_RAD_HALF);
						cur_precomputed_scale = vp.Y * fov_scale * 0.5;

						for i = 1, TargetCount do
							local ti = TargetList[i];
							if ti and ti.Update then
								ti.Update(dt);
							end;
						end;
					end);
				end;
			else
				if esp_bound then
					esp_bound = false;
					runservice:UnbindFromRenderStep("ESP_Update");
					for i = 1, TargetCount do
						local ti = TargetList[i];
						if ti and ti.HolderVisible then
							ti.HolderVisible = false;
							if ti.Objects and ti.Objects.TargetHolder then
								ti.Objects.TargetHolder.Visible = false;
							end;
						end;
					end;
				end;
			end;
		end);

		update_esp_binding();
	end;
end;

