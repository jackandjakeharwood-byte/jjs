	local function cd_add_conn(scope, conn)
		if scope == nil then
			table.insert(cd_global_connections, conn);
			return;
		end;

		cd_connections[scope] = cd_connections[scope] or {};
		table.insert(cd_connections[scope], conn);
	end;

	local function cd_cleanup_player(player)
		if cd_connections[player] then
			for _, conn in ipairs(cd_connections[player]) do
				conn:Disconnect();
			end;
		end;
		cd_connections[player] = nil;
		cd_initialized_players[player] = nil;
	end;

	local function cd_disconnect_all(tbl)
		for _, conn in ipairs(tbl) do
			if typeof(conn) == "RBXScriptConnection" then
				conn:Disconnect();
			elseif typeof(conn) == "table" and conn.Disconnect then
				conn:Disconnect();
			end;
		end;
		table.clear(tbl);
	end;

	local function cd_destroy_character(character)
		local data = cd_character_data[character];
		if not data then return; end;

		cd_disconnect_all(data.connections);

		for _, cooldown_data in pairs(data.cooldowns or {}) do
			if cooldown_data.tween then
				cooldown_data.tween:Cancel();
			end;
		end;

		if data.special_tween then
			data.special_tween:Cancel();
		end;

		if data.reveal then data.reveal:Destroy(); end;
		if data.stun_gui then data.stun_gui:Destroy(); end;

		cd_character_data[character] = nil;
	end;

	local function cd_setup_stun(character, data)
		if not character or character.Name == "Dummy" then return; end;

		local player = players:GetPlayerFromCharacter(character);
		if not player or player == localplayer then return; end;

		local hrp = character:FindFirstChild("HumanoidRootPart");
		if not hrp then return; end;

		if not stun_template_cache then
			local dummy = workspace:WaitForChild("Characters"):WaitForChild("Dummy");
			local dummy_hrp = dummy:WaitForChild("HumanoidRootPart");
			local template = dummy_hrp:WaitForChild("Stunna");

			repeat task.wait() until template and template:IsDescendantOf(game);

			stun_template_cache = template:Clone();
			stun_template_cache.Name = "_cachedstun";

			local visual = stun_template_cache:FindFirstChild("Visual");
			if visual then visual:Destroy(); end;

			stun_template_cache.Parent = gethui();
		end;

		if data.stun_gui then data.stun_gui:Destroy(); end;

		local gui = stun_template_cache:Clone();
		gui.Name = "StunGui";
		gui.Parent = hrp;

		data.stun_gui = gui;

		local indicator = gui:FindFirstChildWhichIsA("GuiObject", true);
		if not indicator then
			gui:Destroy();
			return;
		end;

		local info_conns = {};

		local function clear_info_conns()
			for _, conn in ipairs(info_conns) do
				conn:Disconnect();
			end;
			table.clear(info_conns);
		end;

		local stun_conns = {};

		local function clear_stun_conns()
			for _, conn in ipairs(stun_conns) do
				conn:Disconnect();
			end;
			table.clear(stun_conns);
		end;

		local function update()
			if not (Toggles.stun_checker and Toggles.stun_checker.value) then
				gui.Enabled = false;
				return;
			end;

			gui.Enabled = true;

			local stunned = false;

			if character:GetAttribute("Stun") == true then
				stunned = true;
			else
				local info = character:FindFirstChild("Info");
				if info then
					local stun_val = info:FindFirstChild("Stun");
					if stun_val then
						stunned = true;
					end;
				end;
			end;

			indicator.BackgroundColor3 = stunned and Color3.fromRGB(255,0,0) or Color3.fromRGB(0,255,0);
		end;

		local function hook_stun_val(stun_val)
			clear_stun_conns();
			if stun_val:IsA("ValueBase") then
				table.insert(stun_conns, stun_val:GetPropertyChangedSignal("Value"):Connect(update));
			end;
		end;

		local function hook_info(info)
			clear_info_conns();

			local function process_child(child)
				if child.Name == "Stun" then
					hook_stun_val(child);
					update();
				end;
			end;

			local function remove_child(child)
				if child.Name == "Stun" then
					clear_stun_conns();
					update();
				end;
			end;

			for _, child in ipairs(info:GetChildren()) do
				process_child(child);
			end;

			table.insert(info_conns, info.ChildAdded:Connect(process_child));
			table.insert(info_conns, info.ChildRemoved:Connect(remove_child));
		end;

		local info = character:FindFirstChild("Info");
		if info then hook_info(info); end;

		update();

		table.insert(data.connections, character:GetAttributeChangedSignal("Stun"):Connect(update));

		table.insert(data.connections, character.ChildAdded:Connect(function(child)
			if child.Name == "Info" then
				hook_info(child);
				update();
			end;
		end));

		table.insert(data.connections, character.ChildRemoved:Connect(function(child)
			if child.Name == "Info" then
				clear_info_conns();
				clear_stun_conns();
				update();
			end;
		end));

		table.insert(data.connections, {
			Disconnect = function()
				clear_info_conns();
				clear_stun_conns();
			end;
		});
	end;

	local FULL_GRADIENT = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(1, 0.33333334, 0)),
		ColorSequenceKeypoint.new(1, Color3.new(1, 1, 0.49803922))
	});
	local NOT_FULL_GRADIENT = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(1, 0.6666667, 1)),
		ColorSequenceKeypoint.new(1, Color3.new(0.6666667, 1, 1))
	});

	local function cd_setup_overheat(character, data)
		if not character or character.Name == "Dummy" then return; end;
		local player = players:GetPlayerFromCharacter(character);
		if not player or player == localplayer then return; end;

		local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("HumanoidRootPart");
		if not torso then return; end;
		local hrp = character:FindFirstChild("HumanoidRootPart") or torso;

		local overheat_conns = {};
		local info_conns = {};

		local function clear_info_conns()
			for _, c in ipairs(info_conns) do c:Disconnect(); end;
			table.clear(info_conns);
		end;

		local function clear_overheat_conns()
			for _, c in ipairs(overheat_conns) do c:Disconnect(); end;
			table.clear(overheat_conns);
		end;

		local function update()
			local moveset = character:GetAttribute("Moveset");
			local info = character:FindFirstChild("Info");
			local overheat_val = info and info:FindFirstChild("Overheat");
			local val = overheat_val and overheat_val:IsA("NumberValue") and overheat_val.Value or 0;

			if moveset ~= "Ryu" or val <= 0 then
				if data.overheat_gui then
					data.overheat_gui:Destroy();
					data.overheat_gui = nil;
				end;
				return;
			end;

			if not data.overheat_gui then
				local buildup = game:GetService("ReplicatedStorage").Utils.Ryu:FindFirstChild("Buildup");
				if not buildup then return; end;
				data.overheat_gui = buildup:Clone();
				data.overheat_gui.Adornee = hrp;
				data.overheat_gui.Parent = hrp;
				data.overheat_gui.StudsOffset = Vector3.new(-6, 0, 0);
				
				local bg = data.overheat_gui:FindFirstChild("BG");
				if bg then bg.BackgroundTransparency = 0.5; end;

				local bar_frame = data.overheat_gui:FindFirstChild("Bar");
				if bar_frame then
					bar_frame.BackgroundColor3 = Color3.new(0.6666667, 0.33333334, 1);
					bar_frame.BorderColor3 = Color3.new(0, 0, 0);
					bar_frame.BackgroundTransparency = 1;
					
					local inner_bar = bar_frame:FindFirstChild("Bar");
					if inner_bar then
						inner_bar.BackgroundTransparency = 0;
					end;
				end;

				if data.update_visibility then
					data.update_visibility();
				end;
			end;

			local bar = data.overheat_gui:FindFirstChild("Bar");
			if not bar then return; end;
			local inner_bar = bar:FindFirstChild("Bar");
			if not inner_bar then return; end;
			
			local pct = math.clamp(val / 50, 0.001, 1);
			bar.Size = UDim2.new(1, 0, pct, 0);
			inner_bar.Size = UDim2.new(1, 0, 1 / pct, 0);

			local overheat_grad = inner_bar:FindFirstChild("Overheat");
			local normal_grad = inner_bar:FindFirstChild("UIGradient");

			if val >= 50 then
				if overheat_grad then
					overheat_grad.Color = FULL_GRADIENT;
					overheat_grad.Enabled = true;
				end;
				if normal_grad then normal_grad.Enabled = false; end;
			else
				if normal_grad then
					normal_grad.Color = NOT_FULL_GRADIENT;
					normal_grad.Enabled = true;
				end;
				if overheat_grad then overheat_grad.Enabled = false; end;
			end;
		end;

		local function hook_overheat_val(val_obj)
			clear_overheat_conns();
			if val_obj:IsA("NumberValue") then
				table.insert(overheat_conns, val_obj:GetPropertyChangedSignal("Value"):Connect(update));
			end;
		end;

		local function hook_info(info)
			clear_info_conns();

			local function process_child(child)
				if child.Name == "Overheat" then
					hook_overheat_val(child);
					update();
				end;
			end;

			local function remove_child(child)
				if child.Name == "Overheat" then
					clear_overheat_conns();
					update();
				end;
			end;

			for _, child in ipairs(info:GetChildren()) do
				process_child(child);
			end;

			table.insert(info_conns, info.ChildAdded:Connect(process_child));
			table.insert(info_conns, info.ChildRemoved:Connect(remove_child));
		end;

		local info = character:FindFirstChild("Info");
		if info then hook_info(info); end;

		update();

		table.insert(data.connections, character:GetAttributeChangedSignal("Moveset"):Connect(update));

		table.insert(data.connections, character.ChildAdded:Connect(function(child)
			if child.Name == "Info" then
				hook_info(child);
				update();
			end;
		end));

		table.insert(data.connections, character.ChildRemoved:Connect(function(child)
			if child.Name == "Info" then
				clear_info_conns();
				clear_overheat_conns();
				update();
			end;
		end));

		table.insert(data.connections, {
			Disconnect = function()
				clear_info_conns();
				clear_overheat_conns();
				if data.overheat_gui then
					data.overheat_gui:Destroy();
					data.overheat_gui = nil;
				end;
			end;
		});
	end;

	local function cd_setup_character(character)
		local player = players:GetPlayerFromCharacter(character);
		local hrp = character:FindFirstChild("HumanoidRootPart");

		if not player or player == localplayer or not hrp then
			return;
		end;

		cd_destroy_character(character);

		local data = {
			connections = {};
			move_frames = {};
			cooldowns = {};
		};

		cd_character_data[character] = data;

		local reveal = game.ReplicatedStorage.Utils.Reveal:Clone();
		reveal.Parent = hrp;

		data.reveal = reveal;

		local moveset_gui = reveal:WaitForChild("Moveset");
		local moveset_folder = character:WaitForChild("Moveset");
		local item_template = reveal.Handle.Item;

		local function apply_cooldown(move, frame)
			local cooldown_frame = frame:FindFirstChild("Cooldown");
			if not cooldown_frame then return; end;

			local cd = data.cooldowns[move];
			if not cd then return; end;

			if cd.tween then cd.tween:Cancel(); end;

			if not cd.orig_color then
				cd.orig_color = cooldown_frame.BackgroundColor3;
				cd.orig_trans = cooldown_frame.BackgroundTransparency;
			end;

			local is_confiscated = move.Name == "-" and move:GetAttribute("Confiscated");

			if is_confiscated then
				cooldown_frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0);
				cooldown_frame.BackgroundTransparency = 0.5;

				local tip = move:GetAttribute("Tip");
				if type(tip) == "number" and tip > 0 then
					if not cd.confiscate_max or tip > cd.confiscate_max then
						cd.confiscate_max = tip;
					end

					cooldown_frame.Size = UDim2.new(1, 0, math.clamp(tip / cd.confiscate_max, 0, 1), 0);

					cd.tween = tweenservice:Create(
						cooldown_frame,
						TweenInfo.new(tip, Enum.EasingStyle.Linear),
						{Size = UDim2.new(1, 0, 0, 0)}
					);
					cd.tween:Play();
				else
					cooldown_frame.Size = UDim2.new(1, 0, 0, 0);
				end;
				return;
			else
				cd.confiscate_max = nil;
				cooldown_frame.BackgroundColor3 = cd.orig_color;
				cooldown_frame.BackgroundTransparency = cd.orig_trans;
			end;

			local duration = move.Value;
			local last_use = move:GetAttribute("LastUse");

			if typeof(last_use) ~= "number" then
				cooldown_frame.Size = UDim2.new(1,0,0,0);
				return;
			end;

			local remaining = duration - (workspace:GetServerTimeNow() - last_use);

			if remaining <= 0 then
				cooldown_frame.Size = UDim2.new(1,0,0,0);
				return;
			end;

			cooldown_frame.Size = UDim2.new(1,0, math.clamp(remaining/duration,0,1), 0);

			cd.tween = tweenservice:Create(
				cooldown_frame,
				TweenInfo.new(remaining, Enum.EasingStyle.Linear),
				{Size = UDim2.new(1,0,0,0)}
			);

			cd.tween:Play();
		end;

		local function create_move(move)
			if not move:IsA("NumberValue") then return; end;

			local frame = item_template:Clone();
			frame.Name = move.Name;
			frame.Parent = moveset_gui;

			local namelabel = Instance.new("TextLabel");
			namelabel.Name = "MoveName";
			namelabel.Size = UDim2.new(1, 0, 1, 0);
			namelabel.Position = UDim2.new(0, 0, 0, 0);
			namelabel.BackgroundTransparency = 1;
			namelabel.Text = move.Name;
			namelabel.TextScaled = true;
			namelabel.TextColor3 = Color3.fromRGB(255, 255, 255);
			namelabel.TextStrokeTransparency = 0.5;
			namelabel.FontFace = Font.new("rbxassetid://12187375716", Enum.FontWeight.Regular, Enum.FontStyle.Normal);
			namelabel.ZIndex = frame.ZIndex + 2;
			namelabel.Parent = frame;

			data.move_frames[move] = frame;
			data.cooldowns[move] = {};

			apply_cooldown(move, frame);

			table.insert(data.connections, move:GetAttributeChangedSignal("LastUse"):Connect(function()
				apply_cooldown(move, frame);
			end));

			table.insert(data.connections, move:GetPropertyChangedSignal("Value"):Connect(function()
				apply_cooldown(move, frame);
			end));

			table.insert(data.connections, move:GetAttributeChangedSignal("Confiscated"):Connect(function()
				apply_cooldown(move, frame);
			end));

			table.insert(data.connections, move:GetAttributeChangedSignal("Tip"):Connect(function()
				apply_cooldown(move, frame);
			end));

			table.insert(data.connections, move:GetPropertyChangedSignal("Name"):Connect(function()
				namelabel.Text = move.Name;
				apply_cooldown(move, frame);
			end));
		end;

		local function rebuild_moves()
			for _, cd in pairs(data.cooldowns) do
				if cd.tween then cd.tween:Cancel(); end;
			end;

			for _, v in ipairs(moveset_gui:GetChildren()) do
				if v:IsA("Frame") then v:Destroy(); end;
			end;

			table.clear(data.move_frames);
			table.clear(data.cooldowns);

			local moves = {};

			for _, move in ipairs(moveset_folder:GetChildren()) do
				if move:IsA("NumberValue") then
					table.insert(moves, move);
				end;
			end;

			table.sort(moves, function(a,b)
				return (a:GetAttribute("Key") or math.huge) < (b:GetAttribute("Key") or math.huge);
			end);

			for _, move in ipairs(moves) do
				create_move(move);
			end;
		end;

		rebuild_moves();

		table.insert(data.connections, moveset_folder.ChildAdded:Connect(rebuild_moves));
		table.insert(data.connections, moveset_folder.ChildRemoved:Connect(rebuild_moves));

		cd_setup_stun(character, data);
		cd_setup_overheat(character, data);

		local ult_container = reveal:FindFirstChild("Ult", true);
		local ult_fill = ult_container and ult_container:FindFirstChild("Fill", true);

		local evasive_frame = reveal:FindFirstChild("Evasive", true);
		local evas_fill = evasive_frame and evasive_frame:FindFirstChild("Fill", true);

		local special_clone;
		local special_fill;
		local orig_size, orig_pos;

		if evasive_frame then
			orig_size = evasive_frame.Size;
			orig_pos = evasive_frame.Position;

			special_clone = evasive_frame:Clone();
			special_clone.Name = "Special";
			special_clone.Parent = reveal;

			special_fill = special_clone:FindFirstChild("Fill");
			if special_fill then
				special_fill.BackgroundColor3 = Color3.fromRGB(0, 120, 255);
			end;

			data.special = special_clone;
			data.special_fill = special_fill;
		end;

		local function update_visibility()
			local cdviewer_on = Toggles.cooldown_viewer_toggle and Toggles.cooldown_viewer_toggle.value;
			local evasive_on = cdviewer_on and (Toggles.evasive_cdviewer and Toggles.evasive_cdviewer.value) or false;
			local special_on = cdviewer_on and (Toggles.special_cdviewer and Toggles.special_cdviewer.value) or false;

			moveset_gui.Visible = cdviewer_on and (Toggles.cooldowns_cdviewer and Toggles.cooldowns_cdviewer.value) or false;

			if ult_container then
				ult_container.Visible = cdviewer_on and (Toggles.ultimate_cdviewer and Toggles.ultimate_cdviewer.value) or false;
			end;

			if evasive_frame then
				evasive_frame.Visible = evasive_on;
			end;

			if special_clone then
				special_clone.Visible = special_on;
			end;

			if data.stun_gui then
				data.stun_gui.Enabled = Toggles.stun_checker and Toggles.stun_checker.value or false;
			end;

			if data.overheat_gui then
				data.overheat_gui.Enabled = cdviewer_on and true or false;
			end;

			if evasive_frame and special_clone and orig_size and orig_pos then
				if evasive_on and special_on then
					special_clone.Size = UDim2.new(
						orig_size.X.Scale,
						orig_size.X.Offset,
						orig_size.Y.Scale * 0.51,
						0
					);
					special_clone.Position = orig_pos;

					evasive_frame.Size = UDim2.new(
						orig_size.X.Scale,
						orig_size.X.Offset,
						orig_size.Y.Scale * 0.45,
						0
					);
					evasive_frame.Position = UDim2.new(
						orig_pos.X.Scale,
						orig_pos.X.Offset,
						orig_pos.Y.Scale + (orig_size.Y.Scale * 0.55),
						0
					);
				elseif evasive_on then
					evasive_frame.Size = orig_size;
					evasive_frame.Position = orig_pos;
				elseif special_on then
					special_clone.Size = orig_size;
					special_clone.Position = orig_pos;
				end;
			end;
		end;

		data.update_visibility = update_visibility;

		local function update_ult()
			if not ult_fill then return; end;
			ult_fill.Size = UDim2.new(1, 0, math.clamp((player:GetAttribute("Ultimate") or 0) / 100, 0, 1), 0);
		end;

		local evas_gradient = evas_fill and evas_fill:FindFirstChildOfClass("UIGradient");
		if evas_fill and not evas_gradient then
			evas_gradient = Instance.new("UIGradient");
			evas_gradient.Name = "EvasGradient";
			evas_gradient.Rotation = 0;
			evas_gradient.Parent = evas_fill;
		end;

		--[[local EVAS_GRADIENT_SEQ = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0, 0.333333),
			NumberSequenceKeypoint.new(0.498039, 0, 1),
			NumberSequenceKeypoint.new(1, 1, 0),
		});--]]
		local EVAS_ALIVE_BG  = Color3.fromRGB(0, 85, 127);
		local EVAS_DEAD_BG   = Color3.fromRGB(40, 40, 40);
		local EVAS_FILL_BORDER = Color3.fromRGB(0, 0, 0);

		if evasive_frame then
			evasive_frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255);
			evasive_frame.BorderColor3 = Color3.fromRGB(0, 0, 0);
			evasive_frame.BackgroundTransparency = 0.6000000238418579;
			evasive_frame.BorderSizePixel = 2;
		end;

		--[[if evas_gradient then
			evas_gradient.Transparency = EVAS_GRADIENT_SEQ;
			evas_gradient.Enabled = true;
		end;--]]

		local function update_evade()
			if not evas_fill then return; end;
			local pct = math.clamp((character:GetAttribute("Evade") or 0) / 50, 0, 1);
			evas_fill.Size = UDim2.new(1, 0, pct, 0);

			local char_humanoid = character:FindFirstChildOfClass("Humanoid");
			local is_dead = char_humanoid and char_humanoid.Health <= 0;
			local info_folder = character:FindFirstChild("Info");
			local has_no_death = info_folder and info_folder:FindFirstChild("NoDeath") ~= nil;

			if is_dead and not has_no_death then
				evas_fill.BackgroundColor3 = EVAS_DEAD_BG;
			else
				evas_fill.BackgroundColor3 = EVAS_ALIVE_BG;
			end;
			evas_fill.BackgroundTransparency = 0;
			evas_fill.BorderColor3 = EVAS_FILL_BORDER;
		end;

		local function apply_special_cooldown()
			if not special_clone then
				return;
			end;

			local fill = data.special_fill;

			if not fill then
				fill = Instance.new("Frame");
				fill.Name = "Fill";
				fill.Size = UDim2.fromScale(1, 1);
				fill.BorderSizePixel = 0;
				fill.Parent = special_clone;

				data.special_fill = fill;
			end;

			local gradient = fill:FindFirstChild("Gradient");

			if not gradient then
				gradient = Instance.new("UIGradient");
				gradient.Name = "Gradient";
				gradient.Parent = fill;
			end;

			if data.special_tween then
				data.special_tween:Cancel();
				data.special_tween = nil;
			end;

			local duration = character:GetAttribute("M2_CD");
			local last_use = character:GetAttribute("LastM2");

			local moveset = character:GetAttribute("Moveset");

			if typeof(moveset) ~= "string" or moveset == "" then
				moveset = "Default";
			end;

			local style = SPECIAL_READY_STYLES[moveset];

			if not style then
				style = SPECIAL_READY_STYLES.Default;
			end;

			fill.BackgroundColor3 = style.Color;
			fill.BackgroundTransparency = 0;

			if style.Gradient then
				gradient.Enabled = true;
				gradient.Color = style.Gradient;
				gradient.Transparency = NumberSequence.new(0);
			else
				gradient.Enabled = false;
			end;

			if typeof(duration) ~= "number" or typeof(last_use) ~= "number" then
				fill.Size = UDim2.new(1,0,1,0);
				return;
			end;

			local remaining = duration - (workspace:GetServerTimeNow() - last_use);

			if remaining <= 0 then
				fill.Size = UDim2.new(1,0,1,0);
				return;
			end;

			fill.Size = UDim2.new(1,0,0,0);

			data.special_tween = tweenservice:Create(
				fill,
				TweenInfo.new(
					remaining,
					Enum.EasingStyle.Linear
				),
				{
					Size = UDim2.new(1,0,1,0)
				}
			);

			data.special_tween:Play();
		end;

		update_ult();
		update_evade();
		apply_special_cooldown();
		update_visibility();

		table.insert(data.connections, player:GetAttributeChangedSignal("Ultimate"):Connect(update_ult));
		table.insert(data.connections, character:GetAttributeChangedSignal("Evade"):Connect(update_evade));
		table.insert(data.connections, character:GetAttributeChangedSignal("LastM2"):Connect(apply_special_cooldown));
		table.insert(data.connections, character:GetAttributeChangedSignal("M2_CD"):Connect(apply_special_cooldown));
		table.insert(data.connections, character:GetAttributeChangedSignal("Moveset"):Connect(apply_special_cooldown));

		local evade_info_conns = {};
		local function hook_evade_info(info)
			for _, c in ipairs(evade_info_conns) do c:Disconnect(); end;
			table.clear(evade_info_conns);
			table.insert(evade_info_conns, info.ChildAdded:Connect(function(c)
				if c.Name == "NoDeath" then update_evade(); end;
			end));
			table.insert(evade_info_conns, info.ChildRemoved:Connect(function(c)
				if c.Name == "NoDeath" then update_evade(); end;
			end));
		end;

		local existing_info = character:FindFirstChild("Info");
		if existing_info then hook_evade_info(existing_info); end;

		table.insert(data.connections, character.ChildAdded:Connect(function(child)
			if child.Name == "Info" then
				hook_evade_info(child);
				update_evade();
			end;
		end));

		table.insert(data.connections, {
			Disconnect = function()
				for _, c in ipairs(evade_info_conns) do c:Disconnect(); end;
				table.clear(evade_info_conns);
			end;
		});

		local char_hum = character:FindFirstChildOfClass("Humanoid");
		if char_hum then
			table.insert(data.connections, char_hum.HealthChanged:Connect(update_evade));
		end;
	end;

	local function cd_update_all_visibility()
		for _, data in pairs(cd_character_data) do
			if data.update_visibility then
				data.update_visibility();
			end;
		end;
	end;

	local cd_char_added_conn = nil;
	local cd_char_removed_conn = nil;

	local function cd_start()
		for _, character in ipairs(workspace.Characters:GetChildren()) do
			task.spawn(cd_setup_character, character);
		end;

		cd_char_added_conn = workspace.Characters.ChildAdded:Connect(function(character)
			task.spawn(cd_setup_character, character);
		end);

		cd_char_removed_conn = workspace.Characters.ChildRemoved:Connect(function(character)
			cd_destroy_character(character);
		end);
	end;

	local function cd_stop()
		if cd_char_added_conn then
			cd_char_added_conn:Disconnect();
			cd_char_added_conn = nil;
		end;

		if cd_char_removed_conn then
			cd_char_removed_conn:Disconnect();
			cd_char_removed_conn = nil;
		end;

		for character, _ in pairs(cd_character_data) do
			cd_destroy_character(character);
		end;
	end;

	local function cd_check_should_run()
		local cdviewer_on = Toggles.cooldown_viewer_toggle and Toggles.cooldown_viewer_toggle.value;
		local stun_on = Toggles.stun_checker and Toggles.stun_checker.value;
		return cdviewer_on or stun_on;
	end;

	local cd_running = false;

	local function cd_evaluate()
		local should_run = cd_check_should_run();

		if should_run and not cd_running then
			cd_running = true;
			cd_start();
		elseif not should_run and cd_running then
			cd_running = false;
			cd_stop();
		else
			cd_update_all_visibility();
		end;
	end;

	if Toggles.cooldown_viewer_toggle then
		Toggles.cooldown_viewer_toggle:on_changed(cd_evaluate);
	end;

	if Toggles.cooldowns_cdviewer then
		Toggles.cooldowns_cdviewer:on_changed(cd_update_all_visibility);
	end;

	if Toggles.ultimate_cdviewer then
		Toggles.ultimate_cdviewer:on_changed(cd_update_all_visibility);
	end;

	if Toggles.evasive_cdviewer then
		Toggles.evasive_cdviewer:on_changed(cd_update_all_visibility);
	end;

	if Toggles.special_cdviewer then
		Toggles.special_cdviewer:on_changed(cd_update_all_visibility);
	end;

	if Toggles.stun_checker then
		Toggles.stun_checker:on_changed(cd_evaluate);
	end;

	local rk_connections = {};
	local rk_initialized = {};
	local original_display_names = {};

	local function rk_add_conn(player, conn)
		rk_connections[player] = rk_connections[player] or {};
		table.insert(rk_connections[player], conn);
	end;

	local function rk_cleanup_player(player)
		if rk_connections[player] then
			for _, conn in ipairs(rk_connections[player]) do
				conn:Disconnect();
			end;
		end;
		rk_connections[player] = nil;
		rk_initialized[player] = nil;

		if original_display_names[player] then
			pcall(function()
				player.DisplayName = original_display_names[player];
			end);
			original_display_names[player] = nil;

			local leaderstats = player:FindFirstChild("leaderstats");
			if leaderstats then
				local old_parent = leaderstats.Parent;
				leaderstats.Parent = nil;
				leaderstats.Parent = old_parent;
			end;
		end;
	end;

	local function update_player_name(player)
		if not player:IsDescendantOf(players) then return; end;

		local has_star = string.match(player.DisplayName, "^⭐") ~= nil;
		local leaderstats = player:FindFirstChild("leaderstats");
		local is_hidden_kills = leaderstats and leaderstats:GetAttribute("HiddenKills") == true;
		local should_have_star = Toggles.reveal_kills and Toggles.reveal_kills.value and Toggles.mark_hidden_kills and Toggles.mark_hidden_kills.value and is_hidden_kills;

		if should_have_star then
			if not has_star then
				if not original_display_names[player] then
					original_display_names[player] = player.DisplayName;
				end;
				player.DisplayName = "⭐" .. player.DisplayName;

				local leaderstats = player:FindFirstChild("leaderstats");
				if leaderstats then
					local old_parent = leaderstats.Parent;
					leaderstats.Parent = nil;
					leaderstats.Parent = old_parent;
				end;
			end;
		else
			if has_star then
				local orig = original_display_names[player] or string.gsub(player.DisplayName, "^⭐", "");
				pcall(function()
					player.DisplayName = orig;
				end);
				original_display_names[player] = nil;

				local leaderstats = player:FindFirstChild("leaderstats");
				if leaderstats then
					local old_parent = leaderstats.Parent;
					leaderstats.Parent = nil;
					leaderstats.Parent = old_parent;
				end;
			end;
		end;
	end;

	local function rk_setup_hidden(player, leaderstats)
		local current_hidden = nil;
		local hidden_hooks = {};

		local function disconnect_hidden_hooks()
			for _, conn in ipairs(hidden_hooks) do
				conn:Disconnect();
			end;
			table.clear(hidden_hooks);
		end;

		local function process(child)
			if not child:IsA("ValueBase") then return; end;

			local function do_process()
				if child.Parent ~= leaderstats then
					task.defer(function()
						if child.Parent ~= leaderstats then
							local existing = leaderstats:FindFirstChild(child.Name);
							if existing and existing ~= child then
								existing:Destroy();
							end;
							child.Parent = leaderstats;
						end;
					end);
				end;
			end;

			do_process();
			local name_conn; name_conn = child:GetPropertyChangedSignal("Name"):Connect(function()
				do_process();
			end);
			rk_add_conn(player, name_conn);
			local parent_conn; parent_conn = child:GetPropertyChangedSignal("Parent"):Connect(function()
				do_process();
			end);
			rk_add_conn(player, parent_conn);
		end;

		local function hook_hidden(hidden)
			if current_hidden == hidden then return; end;

			current_hidden = hidden;
			disconnect_hidden_hooks();

			for _, child in ipairs(hidden:GetChildren()) do
				process(child);
			end;

			local child_added_conn = hidden.ChildAdded:Connect(function(child)
				process(child);
				task.defer(function()
					if child.Parent == hidden then
						child.Parent = leaderstats;
					end;
				end);
			end);
			table.insert(hidden_hooks, child_added_conn);
			rk_add_conn(player, child_added_conn);

			local ancestry_conn = hidden.AncestryChanged:Connect(function(_, parent)
				if not parent then
					current_hidden = nil;
					disconnect_hidden_hooks();
				end;
			end);
			table.insert(hidden_hooks, ancestry_conn);
			rk_add_conn(player, ancestry_conn);
		end;

		local function try_find_hidden()
			local hidden = leaderstats:FindFirstChild("Hidden");
			if hidden and hidden:IsA("Folder") then
				hook_hidden(hidden);
			end;
		end;

		try_find_hidden();

		rk_add_conn(player, leaderstats.ChildAdded:Connect(function(child)
			if child:IsA("Folder") then
				if child.Name == "Hidden" then
					hook_hidden(child);
				else
					local name_conn;
					name_conn = child:GetPropertyChangedSignal("Name"):Connect(function()
						if child.Name == "Hidden" then
							hook_hidden(child);
							name_conn:Disconnect();
						end;
					end);
					rk_add_conn(player, name_conn);
				end;
			end;
		end));

		rk_add_conn(player, leaderstats.ChildRemoved:Connect(function(child)
			if child == current_hidden then
				current_hidden = nil;
				disconnect_hidden_hooks();
			end;
		end));
	end;

	local function rk_setup_leaderstats(player)
		local function setup(child)
			if child.Name == "leaderstats" then
				rk_setup_hidden(player, child);
				rk_add_conn(player, child:GetAttributeChangedSignal("HiddenKills"):Connect(function()
					task.spawn(update_player_name, player);
				end));
				task.spawn(update_player_name, player);
			else
				local name_conn;
				name_conn = child:GetPropertyChangedSignal("Name"):Connect(function()
					if child.Name == "leaderstats" then
						rk_setup_hidden(player, child);
						rk_add_conn(player, child:GetAttributeChangedSignal("HiddenKills"):Connect(function()
							task.spawn(update_player_name, player);
						end));
						task.spawn(update_player_name, player);
						name_conn:Disconnect();
					end;
				end);
				rk_add_conn(player, name_conn);
			end;
		end;

		local leaderstats = player:FindFirstChild("leaderstats");
		if leaderstats then
			setup(leaderstats);
		end;

		if not rk_initialized[player] then
			rk_initialized[player] = true;
			rk_add_conn(player, player.ChildAdded:Connect(setup));
		end;
	end;

	local rk_player_added_conn = nil;
	local rk_player_removing_conn = nil;

	local function rk_start()
		for _, player in ipairs(players:GetPlayers()) do
			task.spawn(rk_setup_leaderstats, player);
		end;

		rk_player_added_conn = players.PlayerAdded:Connect(function(player)
			task.spawn(function()
				rk_setup_leaderstats(player);
				local leaderstats = player:FindFirstChild("leaderstats");
				if not leaderstats then
					local child = player:WaitForChild("leaderstats", 10);
					if not child then return; end;
				end;
				update_player_name(player);
			end);
		end);

		rk_player_removing_conn = players.PlayerRemoving:Connect(function(player)
			rk_cleanup_player(player);
			rk_initialized[player] = nil;
		end);
	end;

	local function rk_stop()
		if rk_player_added_conn then
			rk_player_added_conn:Disconnect();
			rk_player_added_conn = nil;
		end;

		if rk_player_removing_conn then
			rk_player_removing_conn:Disconnect();
			rk_player_removing_conn = nil;
		end;

		for player, _ in pairs(rk_initialized) do
			rk_cleanup_player(player);
		end;

		table.clear(rk_initialized);
	end;

	local rk_running = false;

	if Toggles.reveal_kills then
		Toggles.reveal_kills:on_changed(function()
			local enabled = Toggles.reveal_kills.value;

			if enabled and not rk_running then
				rk_running = true;
				rk_start();
			elseif not enabled and rk_running then
				rk_running = false;
				rk_stop();
			end;
			for _, player in ipairs(players:GetPlayers()) do
				task.spawn(update_player_name, player);
			end;
		end);
	end;

	if Toggles.mark_hidden_kills then
		Toggles.mark_hidden_kills:on_changed(function()
			for _, player in ipairs(players:GetPlayers()) do
				task.spawn(update_player_name, player);
			end;
		end);
	end;

	local rc_connections = {};
	local rc_initialized = {};

	local function rc_add_conn(player, conn)
		rc_connections[player] = rc_connections[player] or {};
		table.insert(rc_connections[player], conn);
	end;

	local function rc_cleanup_player(player)
		if rc_connections[player] then
			for _, conn in ipairs(rc_connections[player]) do
				conn:Disconnect();
			end;
		end;
		rc_connections[player] = nil;
		rc_initialized[player] = nil;
	end;

	local function rc_setup_cash(player, leaderstats)
		local cash_value = leaderstats:FindFirstChild("Cash");

		if not cash_value then
			cash_value = Instance.new("NumberValue");
			cash_value.Name = "Cash";
			cash_value.Parent = leaderstats;
		end;

		local function sync_cash()
			cash_value.Value = player:GetAttribute("Cash") or 0;
		end;

		sync_cash();

		rc_add_conn(player, player:GetAttributeChangedSignal("Cash"):Connect(sync_cash));
	end;

	local function rc_setup_leaderstats(player)
		if rc_initialized[player] then
			return;
		end;
		rc_initialized[player] = true;

		local leaderstats = player:WaitForChild("leaderstats");
		rc_setup_cash(player, leaderstats);
	end;

	local rc_player_added_conn = nil;
	local rc_player_removing_conn = nil;

	local function rc_start()
		for _, player in ipairs(players:GetPlayers()) do
			task.spawn(rc_setup_leaderstats, player);
		end;

		rc_player_added_conn = players.PlayerAdded:Connect(function(player)
			task.spawn(rc_setup_leaderstats, player);
		end);

		rc_player_removing_conn = players.PlayerRemoving:Connect(function(player)
			rc_cleanup_player(player);
		end);
	end;

	local function rc_stop()
		if rc_player_added_conn then
			rc_player_added_conn:Disconnect();
			rc_player_added_conn = nil;
		end;

		if rc_player_removing_conn then
			rc_player_removing_conn:Disconnect();
			rc_player_removing_conn = nil;
		end;

		for player, _ in pairs(rc_initialized) do
			rc_cleanup_player(player);
		end;

		table.clear(rc_initialized);
	end;

	local rc_running = false;

	if Toggles.reveal_cash then
		Toggles.reveal_cash:on_changed(function()
			local enabled = Toggles.reveal_cash.value;

			if enabled and not rc_running then
				rc_running = true;
				rc_start();
			elseif not enabled and rc_running then
				rc_running = false;
				rc_stop();
			end;
		end);
	end;
end;

Options.menu_bind.no_ui = true;
Options.ct_toggle.no_ui = true;
Options.menu_bind.permanent_no_ui = true;
Options.ct_toggle.permanent_no_ui = true;
Options.menu_bind:update();
Options.ct_toggle:update();
library.toggle_keybind = Options.menu_bind;
thememanager:set_library(library);
savemanager:set_library(library);
thememanager:apply_to_tab(tabs.settings);
savemanager:build_config_section(tabs.settings);
savemanager:load_autoload_config();
