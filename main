			last_look_vector = nil;
			smoothed_blur = 0;
			if (enabled) then
				blur_effect = instance_new("BlurEffect");
				blur_effect.Size = 0;
				blur_effect.Parent = lighting;
			end;
			update_world_visuals_binding();
		end;
	});

