		},
	};
	
	do
		if not isfolder(FolderLocation) then
			makefolder(FolderLocation);
		end;
		if not isfolder(FolderLocation .. "\\Fonts") then
			makefolder(FolderLocation .. "\\Fonts");
		end;
	end;
	
	do
		local Fonts = getgenv().Fonts;
		if not Fonts then
			getgenv().Fonts = {
				Loaded = {}
			};
			Fonts = getgenv().Fonts;
		end;

		if not isfolder(FolderLocation .. "\\Fonts") then
			makefolder(FolderLocation .. "\\Fonts");
		end;

		local function loadfonts()
			for name, tbl in FontsToDownload do
				local ext = tbl.Ext or ".ttf";
				local fullpath = FolderLocation .. "\\Fonts\\" .. name .. ext;

				if not isfile(fullpath) then
					local data = game:HttpGet(tbl.Link);
					if data then
						writefile(fullpath, data);
					end;
				end;

				if not isfile(FolderLocation .. "\\Fonts\\" .. name .. ".font") then
					local cfg = {
						name = name,
						faces = {{
							name = "Regular",
							weight = 400,
							style = "normal",
							assetId = getcustomasset(fullpath)
						}}
					};
					writefile(FolderLocation .. "\\Fonts\\" .. name .. ".font", HttpService:JSONEncode(cfg));
				end;
			end;

			for _, fontpath in listfiles(FolderLocation .. "\\Fonts") do
				local name = fontpath:match("([^\\/]+)%.font$");
				if name and not Fonts.Loaded[name] then
					Fonts.Loaded[name] = font_new(getcustomasset(fontpath), enum.FontWeight.Regular);
				end;
			end;
			ESP.Font = Fonts.Loaded[cached_settings.Font];
		end;
		task_spawn(loadfonts);
	end;

	do
		add_connection = function(Signal, Function)
			local Connection = Signal:Connect(Function);
			if ConnectionsTable then
				ConnectionsTable[#ConnectionsTable + 1] = Connection;
			end;
			return Connection;
		end;

		create_object = function(Type, Properties, Hidden)
			local Object = instance_new(Type);
			for Index, Value in Properties do Object[Index] = Value; end;
			return Object;
		end;

		calculate_box = LPH_JIT_MAX(function(Target, RootPart, BaseParts)
			if not cur_cam or not WorldToViewportPoint then
				return 0, 0, 0, 0, false;
			end;
			local Position, OnScreen = WorldToViewportPoint(cur_cam, RootPart.Position);
			if not OnScreen or Position.Z <= 0 then
				return 0, 0, 0, 0, false;
			end;

			if cached_settings.BoxDynamicBox then
				local MinX, MinY, MaxX, MaxY = 9000, 9000, -9000, -9000;
				local parts = BaseParts;
				if parts then
					for i = 1, #parts do
						local Part = parts[i];
						local Size = Part.Size * 0.5;
						local CF = Part.CFrame;
						local cf_pos = CF.Position;
						local cf_up = CF.UpVector * Size.Y;
						local Top, TopOnScreen = WorldToViewportPoint(cur_cam, cf_pos + cf_up);
						local Bottom, BottomOnScreen = WorldToViewportPoint(cur_cam, cf_pos - cf_up);
						if TopOnScreen or BottomOnScreen then
							local Height = math_abs(Top.Y - Bottom.Y);
							local Width = Height * (Size.X / Size.Y);
							local CenterX = (Top.X + Bottom.X) * 0.5;
							local CenterY = (Top.Y + Bottom.Y) * 0.5;
							local left = CenterX - Width;
							local right = CenterX + Width;
							local topY = CenterY - Height;
							local botY = CenterY + Height;
							if left < MinX then MinX = left; end;
							if topY < MinY then MinY = topY; end;
							if right > MaxX then MaxX = right; end;
							if botY > MaxY then MaxY = botY; end;
						end;
					end;
				end;
				if MinX == 9000 then
					return 0, 0, 0, 0, false;
				end;
				return MaxX - MinX, MaxY - MinY, MinX, MinY, true;
			else
				local Scale = (RootPart.Size.Y * cur_precomputed_scale) / Position.Z;
				local BoxWidth = 3 * Scale;
				local BoxHeight = 4.5 * Scale;
				return BoxWidth, BoxHeight, Position.X - (BoxWidth * 0.5), Position.Y - (BoxHeight * 0.5), true;
			end;
		end);

		get_font_type = function(Text)
			if not Text then return ""; end;
			local mode = cached_settings.FontTypeMode;
			if mode == 1 then
				return string_upper(Text);
			elseif mode == 2 then
				return string_lower(Text);
			end;
			return Text;
		end;

		Utility.AddConnection = add_connection;
		Utility.CreateObject = create_object;
		Utility.CalculateBox = calculate_box;
		Utility.GetFontType = get_font_type;
	end;

	local function get_scaled_fontsize()
		return cached_settings.FontSize or 9;
	end;

	add_connection(Workspace:GetPropertyChangedSignal("CurrentCamera"), function()
