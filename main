		function ESP.AddTarget(Target)
			if ESP.Targets[Target] then return; end;
			local TargetInfo = {
				Objects = {},
				CharacterObjects = {},
				CharacterConnection = nil,
				HealthConnection = nil,
				ToolConnection = { Added = nil, Removed = nil, ItemChanged = nil, InfoChildAdded = nil, InfoChildRemoved = nil, ItemRenamed = nil },
				CurrentTool = get_font_type("none"),
				TargetName = get_font_type(raw_settings.Name.UseDisplay and (Target:IsA("Player") and Target.DisplayName or Target.Name) or Target.Name),
				DistanceEnding = get_font_type(raw_settings.Distance.Ending),
				HealthBarValue = 1,
				LastHealth = 100,
				LastMaxHealth = 100,
				FlagsDelay = 0,
				CachedFlagsString = "",
				LastTick = os_clock(),
				LastLazyUpdate = 0,
				LastDistanceText = "",
				LastDistanceValue = -1,
				HolderVisible = false,
				BoxVisible = false,
				GlowVisible = false,
				FillVisible = false,
				HpBarHolderVisible = false,
				ArmBarHolderVisible = false,
				HpTextVisible = false,
				ArmTextVisible = false,
				NameVisible = false,
				DistVisible = false,
				WeapVisible = false,
				FlagsVisible = false,
				LastBoxX = -9999,
				LastBoxY = -9999,
				LastBoxW = -9999,
				LastBoxH = -9999,
				BoxSizeChanged = true,
				HpBarDisp = 1,
				ArmBarDisp = 1,
				LastAppliedHpDisp = -999,
				LastAppliedArmDisp = -999,
				LastHpTextInt = -999,
				LastArmTextInt = -999,
				LastHpTextStr = "",
				LastArmTextStr = "",
				LastDistInt = -1,
				LastDistStr = "",
				LastWeapStr = "",
				LastFlagsStr = "",
				RawName = nil,
				FormattedName = nil,
			};

			local Objects = TargetInfo.Objects;
			local ToolConnection = TargetInfo.ToolConnection;
			local CharacterObjects = TargetInfo.CharacterObjects;
			local ESPFont = ESP.Font;
			local ESPFontSize = get_scaled_fontsize();
			local ESPHolder = ESP.Holder;
			local is_player = Target:IsA("Player");

			CharacterObjects.Character = is_player and Target.Character or Target;
			CharacterObjects.BodyParts = {};
			CharacterObjects.AllParts = {};

			local function cache_character_parts(char)
				if not char then
					CharacterObjects.BodyParts = {};
					CharacterObjects.AllParts = {};
					return;
				end;
				local allParts = {};
				local bodyParts = {};
				local allCount = 0;
				local bodyCount = 0;
				local desc = char:GetDescendants();
				for i = 1, #desc do
					local d = desc[i];
					if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
						allCount = allCount + 1;
						allParts[allCount] = d;
						if d.Parent == char then
							bodyCount = bodyCount + 1;
							bodyParts[bodyCount] = d;
						end;
					end;
				end;
				CharacterObjects.AllParts = allParts;
				CharacterObjects.BodyParts = (bodyCount > 0) and bodyParts or allParts;
			end;

			if is_player then
				CharacterObjects.HumanoidRootPart = CharacterObjects.Character and CharacterObjects.Character:FindFirstChild("HumanoidRootPart") or nil;
				CharacterObjects.Humanoid = CharacterObjects.Character and CharacterObjects.Character:FindFirstChildWhichIsA("Humanoid") or nil;
			end;
			cache_character_parts(CharacterObjects.Character);

			do
				local function bind_tool_tracking(char)
					if ToolConnection.ItemChanged then
						ToolConnection.ItemChanged:Disconnect();
						ToolConnection.ItemChanged = nil;
					end;
					if ToolConnection.InfoChildAdded then
						ToolConnection.InfoChildAdded:Disconnect();
						ToolConnection.InfoChildAdded = nil;
					end;
					if ToolConnection.InfoChildRemoved then
						ToolConnection.InfoChildRemoved:Disconnect();
						ToolConnection.InfoChildRemoved = nil;
					end;
					if ToolConnection.ItemRenamed then
						ToolConnection.ItemRenamed:Disconnect();
						ToolConnection.ItemRenamed = nil;
					end;

					TargetInfo.CurrentTool = get_font_type("none");
					if not char then return; end;

					local function update_tool(itemVal)
						if not itemVal or itemVal.Name ~= "Item" then
							TargetInfo.CurrentTool = get_font_type("none");
							return;
						end;
						local item = itemVal.Value;
						TargetInfo.CurrentTool = get_font_type(item and item.Name or "none");
					end;

					local function hook_info(info)
						local function try_hook_item()
							local itemVal = info:FindFirstChild("Item");
							if itemVal and not ToolConnection.ItemChanged then
								update_tool(itemVal);
								ToolConnection.ItemChanged = add_connection(itemVal:GetPropertyChangedSignal("Value"), function() update_tool(itemVal); end);
								ToolConnection.ItemRenamed = add_connection(itemVal:GetPropertyChangedSignal("Name"), function() update_tool(itemVal); end);
							end;
						end;

						try_hook_item();
						if not ToolConnection.ItemChanged then
							TargetInfo.CurrentTool = get_font_type("none");
						end;

						ToolConnection.InfoChildAdded = add_connection(info.ChildAdded, function(child)
							if child.Name == "Item" then
								try_hook_item();
							end;
						end);

						ToolConnection.InfoChildRemoved = add_connection(info.ChildRemoved, function(child)
							if child.Name == "Item" then
								if ToolConnection.ItemChanged then
									ToolConnection.ItemChanged:Disconnect();
									ToolConnection.ItemChanged = nil;
								end;
								TargetInfo.CurrentTool = get_font_type("none");
							end;
						end);
					end;

					local info = char:FindFirstChild("Info");
					if info then
						hook_info(info);
					else
						local conn;
						conn = add_connection(char.ChildAdded, function(child)
							if child.Name == "Info" then
								conn:Disconnect();
								hook_info(child);
							end;
						end);
					end;
				end;

				function TargetInfo.Init()
					if #Objects > 0 then return; end;

					if is_player then
						local function on_character(Character)
							CharacterObjects.Character = Character;
							CharacterObjects.HumanoidRootPart = Character:WaitForChild("HumanoidRootPart", 10);
							local Humanoid = Character:WaitForChild("Humanoid", 10);
							CharacterObjects.Humanoid = Humanoid;

							task_delay(0.5, function()
								cache_character_parts(Character);
							end);

							if Humanoid then
								TargetInfo.LastHealth = Humanoid.Health;
								TargetInfo.LastMaxHealth = Humanoid.MaxHealth;
								TargetInfo.HealthBarValue = TargetInfo.LastHealth / TargetInfo.LastMaxHealth;
								if TargetInfo.HealthConnection then
									TargetInfo.HealthConnection:Disconnect();
								end;
								TargetInfo.HealthConnection = add_connection(Humanoid.HealthChanged, function(Health)
									TargetInfo.LastHealth = Health;
									TargetInfo.LastMaxHealth = Humanoid.MaxHealth;
									TargetInfo.HealthBarValue = TargetInfo.LastHealth / TargetInfo.LastMaxHealth;
								end);
							end;

							bind_tool_tracking(Character);
						end;

						TargetInfo.CharacterConnection = add_connection(Target.CharacterAdded, on_character);
						if Target.Character then
							on_character(Target.Character);
						end;
					else
						local function bind_humanoid()
							local humanoid = Target:FindFirstChildWhichIsA("Humanoid");
							if not humanoid then return; end;

							TargetInfo.LastHealth = humanoid.Health;
							TargetInfo.LastMaxHealth = humanoid.MaxHealth;
							TargetInfo.HealthBarValue = humanoid.Health / humanoid.MaxHealth;

							if TargetInfo.HealthConnection then
								TargetInfo.HealthConnection:Disconnect();
								TargetInfo.HealthConnection = nil;
							end;

							TargetInfo.HealthConnection = humanoid.HealthChanged:Connect(function(health)
								if humanoid.Parent == nil then return; end;
								TargetInfo.LastHealth = health;
								TargetInfo.LastMaxHealth = humanoid.MaxHealth;
								TargetInfo.HealthBarValue = health / humanoid.MaxHealth;
							end);
						end;

						bind_humanoid();
						cache_character_parts(Target);

						Target.ChildAdded:Connect(function(child)
							if child:IsA("Humanoid") then
								bind_humanoid();
							elseif child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" then
								cache_character_parts(Target);
							end;
						end);
					end;

