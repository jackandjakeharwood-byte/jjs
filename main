	local proxy_cache = setmetatable({}, {__mode = "k"});
	local function create_proxy(real_tbl)
		local proxy = {};
		local proxy_metatable = {
			__index = function(_, key)
				local val = real_tbl[key];
				if type(val) == "table" then
					local cached = proxy_cache[val];
					if not cached then
						cached = create_proxy(val);
					end;
					return cached;
				end;
				return val;
			end,
			__newindex = function(_, key, val)
				real_tbl[key] = val;
				ESP.notify_settings_changed();
			end,
			__pairs = function()
				local function iterator(t, var)
					local k, v = next(real_tbl, var);
					if k ~= nil then
						if type(v) == "table" then
							local cached = proxy_cache[v];
							if not cached then
								cached = create_proxy(v);
							end;
							v = cached;
						end;
						return k, v;
					end;
				end;
				return iterator, proxy, nil;
			end,
			__iter = function()
				local function iterator(t, var)
					local k, v = next(real_tbl, var);
					if k ~= nil then
						if type(v) == "table" then
							local cached = proxy_cache[v];
							if not cached then
								cached = create_proxy(v);
							end;
							v = cached;
						end;
						return k, v;
					end;
				end;
				return iterator, proxy, nil;
			end,
			__len = function()
				return #real_tbl;
			end
		};
		setmetatable(proxy, proxy_metatable);
		proxy_cache[real_tbl] = proxy;
		return proxy;
	end;

	ESP.Settings = create_proxy(raw_settings);

