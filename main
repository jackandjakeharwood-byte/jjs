		compact = true;
	});

	local function hook(obj, fn)
		if not obj then return; end;
		if obj.on_changed then
			obj:on_changed(fn);
		elseif obj.OnChanged then
			obj:OnChanged(fn);
		end;
	end;

	hook(Toggles.atmosphere, apply_fog);
	hook(Options.Density, apply_fog);
	hook(Options.AtmosColor, apply_fog);
	hook(Options.DecayColor, apply_fog);
	hook(Options.Glare, apply_fog);
	hook(Options.Haze, apply_fog);
	hook(Options.AtmosphereOffset, apply_fog);
	hook(Options.Skybox, apply_skybox);
	hook(Toggles.Ambient, apply_ambience);
	hook(Options.AmbientColor, apply_ambience);
	hook(Options.OutdoorAmbientColor, apply_ambience);
	hook(Toggles.ColorShift_Bottom, apply_colorshift_bottom);
	hook(Options.ColorShift_BottomColor, apply_colorshift_bottom);
	hook(Toggles.ColorShift_Top, apply_colorshift_top);
	hook(Options.ColorShift_TopColor, apply_colorshift_top);
	hook(Toggles.FogColor, apply_legacy_fog_color);
	hook(Options.FogColorValue, apply_legacy_fog_color);
	hook(Toggles.FogEnd, apply_fog_end);
	hook(Options.FogEndValue, apply_fog_end);
	hook(Toggles.FogStart, apply_fog_start);
	hook(Options.FogStartValue, apply_fog_start);
	hook(Toggles.ClockTime, apply_clock);
	hook(Options.Time, apply_clock);
	hook(Toggles.ColorCorrection, apply_colorcorrection);
	hook(Options.ColorCorrectionColor, apply_colorcorrection);
	hook(Toggles.saturation_enabled, apply_colorcorrection);
	hook(Options.saturation_value, apply_colorcorrection);
	hook(Toggles.contrast_enabled, apply_colorcorrection);
	hook(Options.contrast_value, apply_colorcorrection);
	hook(Toggles.Brightness, apply_brightness);
	hook(Options.BrightnessValue, apply_brightness);
	hook(Toggles.Environmental, apply_environmental);
	hook(Options.EnvironmentValue, apply_environmental);
	hook(Toggles.Exposure, apply_exposure);
	hook(Options.ExposureValue, apply_exposure);

	lighting.ChildAdded:Connect(function(child)
		if child:IsA("Atmosphere") then
			child.Name = "atmosphere";
			task_defer(function()
				apply_fog();
				disable_atmosphere_for_legacy_fog();
			end);
		elseif child:IsA("Sky") then
			sky_instance = child;
			task_defer(apply_skybox);
		elseif child:IsA("ColorCorrectionEffect") then
			color_correction = child;
			task_defer(apply_colorcorrection);
		end;
	end);

	lighting.ChildRemoved:Connect(function(child)
		if child:IsA("ColorCorrectionEffect") then
			if child == color_correction then
				color_correction = nil;
			end;
			task_defer(apply_colorcorrection);
		elseif child:IsA("Sky") and child == sky_instance then
			sky_instance = nil;
			task_defer(apply_skybox);
		end;
	end);
end;

do
	local self_highlight = nil;
	local self_highlight_char_conn = nil;
	local self_material_char_conn = nil;
	local self_material_active = false;
	local particle_aura_conn = nil;
	local particle_aura_active = false;
	local aura_particles = {};

	local body_part_names = {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "HumanoidRootPart", "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot"};

	local original_part_data = {};

	local particle_aura_assets = {
		["starlight"] = "rbxassetid://134645216613107";
		["heavenly"] = "rbxassetid://139300897520961";
		["ribbon"] = "rbxassetid://132069507632161";
		["sakura"] = "rbxassetid://81755778619404";
		["angel"] = "rbxassetid://97658130917593";
		["flow"] = "rbxassetid://119913533725648";
		["star"] = "rbxassetid://73754563740680";
		["wind"] = "rbxassetid://94826631061683";
		["lightning aura"] = "rbxassetid://88833232287502";
		["cursed energy"] = "rbxassetid://92563396246933";
	};

	local particle_aura_cache = {};
	local current_aura_model = nil;

	local function load_aura(name)
		if (particle_aura_cache[name]) then
			return particle_aura_cache[name];
		end;
		local asset_id = particle_aura_assets[name];
		if (not asset_id) then return nil; end;
		local model = game:GetObjects(asset_id)[1];
		if (model) then
			particle_aura_cache[name] = model;
			return model;
		end;
		return nil;
	end;

	for name, _ in pairs(particle_aura_assets) do
		task.wait();
		load_aura(name);
	end;

	local function recolor_aura_model(model, color_value)
		if (not model) then return; end;
		local color_seq = colorsequence_new(color_value);
		local descs = model:GetDescendants();
		local n = #descs;
		for i = 1, n do
			local desc = descs[i];
			local cn = desc.ClassName;
			if (cn == "PointLight") then
				desc.Color = color_value;
			elseif (cn == "ParticleEmitter" or cn == "Beam" or cn == "Trail") then
				desc.Color = color_seq;
			end;
		end;
	end;

	local function clear_aura_particles()
		for i = 1, #aura_particles do
			if (aura_particles[i] and aura_particles[i].Parent) then
				aura_particles[i]:Destroy();
			end;
			aura_particles[i] = nil;
		end;
		aura_particles = {};
	end;

	local r15_to_r6 = {
		["uppertorso"] = "Torso",
		["lowertorso"] = "Torso",
		["torso"] = "Torso",
		["head"] = "Head",
		["humanoidrootpart"] = "HumanoidRootPart",
		["rootpart"] = "HumanoidRootPart",
		["root"] = "HumanoidRootPart",
		["leftupperarm"] = "Left Arm",
		["leftlowerarm"] = "Left Arm",
		["lefthand"] = "Left Arm",
		["leftarm"] = "Left Arm",
		["rightupperarm"] = "Right Arm",
		["rightlowerarm"] = "Right Arm",
		["righthand"] = "Right Arm",
		["rightarm"] = "Right Arm",
		["leftupperleg"] = "Left Leg",
		["leftlowerleg"] = "Left Leg",
		["leftfoot"] = "Left Leg",
		["leftleg"] = "Left Leg",
		["rightupperleg"] = "Right Leg",
		["rightlowerleg"] = "Right Leg",
		["rightfoot"] = "Right Leg",
		["rightleg"] = "Right Leg",
	};

	local function resolve_r6_target(char, name)
		if (not name or name == "") then
			return char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart");
		end;
		local direct = char:FindFirstChild(name);
		if (direct and direct:IsA("BasePart")) then
			return direct;
		end;
		local clean = string_lower(string_gsub(name, "%s+", ""));
		local mapped = r15_to_r6[clean];
		if (mapped) then
			local target = char:FindFirstChild(mapped);
			if (target and target:IsA("BasePart")) then
				return target;
			end;
		end;
		return char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart");
	end;

	local apply_aura = LPH_NO_VIRTUALIZE(function()
		clear_aura_particles();
		if (not particle_aura_active or not current_aura_model) then return; end;
		local char = localplayer.Character;
		if (not char) then return; end;
		local root = char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart");
		if (not root) then return; end;

		local cloned = current_aura_model:Clone();

		local base_parts = {};
		for _, desc in ipairs(cloned:GetDescendants()) do
			if (desc:IsA("BasePart")) then
				table_insert(base_parts, desc);
			end;
		end;
		if (#base_parts == 0 and cloned:IsA("BasePart")) then
			table_insert(base_parts, cloned);
		end;

		if (#base_parts > 0) then
			for i = 1, #base_parts do
				local part = base_parts[i];
				local target = resolve_r6_target(char, part.Name);
				if (target) then
					local children = part:GetChildren();
					for j = 1, #children do
						local child = children[j];
						if (child:IsA("ParticleEmitter") or child:IsA("Attachment") or child:IsA("Beam") or child:IsA("Trail") or child:IsA("PointLight")) then
							if (child:IsA("ParticleEmitter")) then
								child.Enabled = true;
							end;
							for _, sub in ipairs(child:GetDescendants()) do
								if (sub:IsA("ParticleEmitter")) then
									sub.Enabled = true;
								end;
							end;
							child.Name = "\0\0";
							child.Parent = target;
							aura_particles[#aura_particles + 1] = child;
						end;
					end;
				end;
			end;
		end;

		for _, desc in ipairs(cloned:GetDescendants()) do
			if (desc:IsA("Attachment") or desc:IsA("ParticleEmitter") or desc:IsA("Beam") or desc:IsA("Trail") or desc:IsA("PointLight")) then
				if (desc:IsDescendantOf(cloned) and not (desc:IsA("ParticleEmitter") and desc.Parent and desc.Parent:IsA("Attachment"))) then
					local target = resolve_r6_target(char, desc.Parent and desc.Parent.Name or "");
					if (target) then
						if (desc:IsA("ParticleEmitter")) then
							desc.Enabled = true;
						end;
						for _, sub in ipairs(desc:GetDescendants()) do
							if (sub:IsA("ParticleEmitter")) then
								sub.Enabled = true;
							end;
						end;
						desc.Name = "\0\0";
						desc.Parent = target;
						aura_particles[#aura_particles + 1] = desc;
					end;
				end;
			end;
		end;

		cloned:Destroy();
	end);

	local apply_self_highlight = LPH_JIT(function()
		if (not self_highlight) then return; end;
		local char = localplayer.Character;
		if (not char) then return; end;
		self_highlight.Adornee = char;
	end);

	local apply_self_material = LPH_NO_VIRTUALIZE(function()
		if (not self_material_active) then return; end;
		local char = localplayer.Character;
		if (not char) then return; end;

		local material_name = Options.self_material_type and Options.self_material_type.value or "Neon";
		local mat = enum.Material[material_name] or enum.Material.Neon;
		local col = Options.self_material_color and Options.self_material_color.value or color3_fromrgb(249, 217, 255);
		local trans = Options.self_material_transparency and Options.self_material_transparency.transparency or 0.2;

		for _, name in ipairs(body_part_names) do
			local part = char:FindFirstChild(name);
			if (part and part:IsA("BasePart")) then
				if (not original_part_data[part]) then
					original_part_data[part] = {
						material = part.Material;
						color = part.Color;
						transparency = part.Transparency;
					};
				end;
				if (part.Name == "HumanoidRootPart" or part.Transparency >= 1) then
				else
					part.Material = mat;
					part.Color = col;
					part.Transparency = trans;
				end;
			end;
		end;

		for _, child in ipairs(char:GetChildren()) do
			if (child:IsA("Accessory")) then
				local handle = child:FindFirstChild("Handle");
				if (handle and handle:IsA("MeshPart")) then
					if (not original_part_data[handle]) then
						original_part_data[handle] = {
							material = handle.Material;
							color = handle.Color;
							transparency = handle.Transparency;
							texture_id = handle.TextureID;
						};
					end;
					handle.Material = mat;
					handle.TextureID = "";
					handle.Color = col;
					handle.Transparency = trans;
				end;
			end;
		end;

		local shirt = char:FindFirstChildOfClass("Shirt");
		if (shirt and shirt.ShirtTemplate ~= "") then
			if (not shirt:GetAttribute("_orig_shirt")) then
				shirt:SetAttribute("_orig_shirt", shirt.ShirtTemplate);
			end;
			shirt.ShirtTemplate = "";
		end;

		local pants = char:FindFirstChildOfClass("Pants");
		if (pants and pants.PantsTemplate ~= "") then
			if (not pants:GetAttribute("_orig_pants")) then
				pants:SetAttribute("_orig_pants", pants.PantsTemplate);
			end;
			pants.PantsTemplate = "";
		end;
	end);

	local restore_self_material = LPH_JIT(function()
		local char = localplayer.Character;
		if (not char) then
			original_part_data = {};
			return;
		end;

		for part, data in pairs(original_part_data) do
			if (part and part.Parent) then
				part.Material = data.material;
				part.Color = data.color;
				part.Transparency = data.transparency;
				if (data.texture_id and part:IsA("MeshPart")) then
					part.TextureID = data.texture_id;
				end;
			end;
		end;
		original_part_data = {};

		local shirt = char:FindFirstChildOfClass("Shirt");
		if (shirt) then
			local orig = shirt:GetAttribute("_orig_shirt");
			if (orig) then
				shirt.ShirtTemplate = orig;
				shirt:SetAttribute("_orig_shirt", nil);
			end;
		end;

		local pants = char:FindFirstChildOfClass("Pants");
		if (pants) then
			local orig = pants:GetAttribute("_orig_pants");
			if (orig) then
				pants.PantsTemplate = orig;
				pants:SetAttribute("_orig_pants", nil);
			end;
		end;
	end);

	self_visuals:add_toggle("self_highlight_enabled", {
		text = "character highlight";
		default = false;
		callback = function(enabled)
			if (self_highlight_char_conn) then
				self_highlight_char_conn:Disconnect();
				self_highlight_char_conn = nil;
			end;

			if (self_highlight) then
				self_highlight:Destroy();
				self_highlight = nil;
			end;

			if (enabled) then
				local fill_color = Options.self_highlight_fill_color and Options.self_highlight_fill_color.value or color3_fromrgb(255, 255, 255);
				local outline_color = Options.self_highlight_outline_color and Options.self_highlight_outline_color.value or color3_fromrgb(255, 255, 255);
				local fill_trans = Options.self_highlight_fill_color and Options.self_highlight_fill_color.transparency or 0.5;
				local outline_trans = Options.self_highlight_outline_color and Options.self_highlight_outline_color.transparency or 0.5;

				self_highlight = instance_new("Highlight");
				self_highlight.FillColor = fill_color;
				self_highlight.FillTransparency = fill_trans;
				self_highlight.OutlineColor = outline_color;
				self_highlight.OutlineTransparency = outline_trans;
				self_highlight.DepthMode = enum.HighlightDepthMode.AlwaysOnTop;
				self_highlight.Enabled = true;
				self_highlight.Parent = gethui();

				apply_self_highlight();

				self_highlight_char_conn = localplayer.CharacterAdded:Connect(function()
					task_wait(0.1);
					apply_self_highlight();
				end);
			end;
		end;
	}):add_color_picker("self_highlight_fill_color", {
		default = color3_fromrgb(255, 255, 255);
		title = "fill";
		transparency = 0.5;
		callback = function(value)
			if (self_highlight) then
				self_highlight.FillColor = value;
			end;
		end;
	}):add_color_picker("self_highlight_outline_color", {
		default = color3_fromrgb(255, 255, 255);
		title = "outline";
		transparency = 0.5;
		callback = function(value)
			if (self_highlight) then
				self_highlight.OutlineColor = value;
			end;
		end;
	});

	self_visuals:add_toggle("self_material_enabled", {
		text = "character material";
		default = false;
