local update_movement_connection;
local update_click_teleport_connection;

local whitelisted_players = {};
local selected_whitelist_player = nil;

local is_player_whitelisted = LPH_NO_VIRTUALIZE(function(player)
	if not player then return false; end;
	if not Toggles.whitelist or not Toggles.whitelist.value then return false; end;

	local check_types = Options.whitelist_check and Options.whitelist_check.value or {};

	local t = typeof(player);
	local name_lower = nil;

	if t == "string" then
		name_lower = string_lower(player);
	elseif t == "Instance" then
		name_lower = string_lower(player.Name);
	end;

	if name_lower and Options.high_priority_players and Options.high_priority_players.value then
		for v, selected in pairs(Options.high_priority_players.value) do
			if selected and string_lower(v) == name_lower then
				return true;
			end;
		end;
	end;
	if check_types["friends"] then
		local player_instance = player;
		if typeof(player) == "string" then
			player_instance = players:FindFirstChild(player);
		end;
		if player_instance and typeof(player_instance) == "Instance" and player_instance:IsA("Player") then
			local is_friend = localplayer:IsFriendsWith(player_instance.UserId);
			if is_friend then
				return true;
			end;
		end;
	end;

	if check_types["whitelist"] then
		local t = typeof(player);
		local name_lower = nil;

		if t == "string" then
			name_lower = string_lower(player);
		elseif t == "Instance" then
			name_lower = string_lower(player.Name);
		end;

		if name_lower then
			if whitelisted_players[name_lower] == true then
				return true;
			end;
			if Options.whitelist_players and Options.whitelist_players.value then
				for v, selected in pairs(Options.whitelist_players.value) do
					if selected and string_lower(v) == name_lower then
						return true;
					end;
				end;
			end;
		end;
	end;

	return false;
end);

local teleport = LPH_JIT_MAX(function(cf)
	local hrp = localplayer.Character and localplayer.Character:FindFirstChild("HumanoidRootPart");
	if (not hrp) then return; end;
	hrp.CFrame = cf;
	hrp.AssemblyLinearVelocity = vector3_zero;
	hrp.AssemblyAngularVelocity = vector3_zero;
end);

local create_connection = LPH_NO_VIRTUALIZE(function(signal, callback)
    local connection = signal:Connect(callback);
    connections[#connections + 1] = connection;

    return connection;
end);

local disconnect_connection = LPH_NO_VIRTUALIZE(function(conn)
    conn:Disconnect();
    local n = #connections;
    for i = n, 1, -1 do
        if connections[i] == conn then
            connections[i] = connections[n];
            connections[n] = nil;
            break;
        end;
    end;
end);

do
	local typeofcache = typeof;
	local tickcache = tick;
	local renderstepped = runservice.RenderStepped;
	local connection, currentlooptype, cframecallback, currentactive;
	local stopspoofing, executing = false, false;
	local activespoofs, registeredspoofs, persistentloops = {}, {}, {};

	local oncharacter = LPH_JIT(function(char)
		character = char;
		humanoid = char:WaitForChild("Humanoid");
		humanoidrootpart = char:WaitForChild("HumanoidRootPart");
		primarypart = humanoidrootpart;
		clientcframe = primarypart.CFrame;
	end);

	if localplayer.Character then
		oncharacter(localplayer.Character);
	end;
	localplayer.CharacterAdded:Connect(oncharacter);

	local looptypes = {
		heartbeat = runservice.Heartbeat,
		renderstepped = runservice.RenderStepped,
		stepped = runservice.Stepped
	};

	local evaluatecurrent = LPH_JIT_MAX(function()
		local best;
		local n = #activespoofs;
		for i = 1, n do
			local v = activespoofs[i];
			if not best or v.priority > best.priority or (v.priority == best.priority and v.timestamp < best.timestamp) then
				best = v;
			end;
		end;
		currentactive = best;
	end);

	local refreshconnection = LPH_JIT(function()
		if not currentactive then
			if connection then
				connection:Disconnect();
				connection = nil;
				currentlooptype = nil;
			end;
			return;
		end;
		
		local looptype = currentactive.looptype;
		if connection and currentlooptype == looptype then
			return;
		end;

		if connection then
			connection:Disconnect();
			connection = nil;
		end;

		currentlooptype = looptype;
		local event = looptypes[looptype] or runservice.Heartbeat;
		connection = event:Connect(LPH_JIT_MAX(function()
			if stopspoofing or executing then return; end;
			if not (primarypart and primarypart.Parent) then return; end;
			local spoof = currentactive;
			if not spoof then return; end;
			executing = true;

			clientcframe = primarypart.CFrame;
			local result = spoof.callback(clientcframe);
			if result and typeofcache(result) == "CFrame" then
				isspoofing = true;
				local target = result;

				do
					local an = #activespoofs;
					for ai = 1, an do
						local v = activespoofs[ai];
						if v ~= spoof and v.ignore_priority then
							local res = v.callback(clientcframe);
							if res and typeofcache(res) == "CFrame" then
								target = target * res;
							end;
						end;
					end;
				end;

                if spoof.direction then
                    local pos = clientcframe.Position + target.Position;
                    target = cframe_frommatrix(pos, result.RightVector, result.UpVector, result.LookVector);
                end;

				primarypart.CFrame = target;
				isspoofing = false;

				if cframecallback then
                    cframecallback(target);
                end;
			else
				warn("callback error " .. spoof.name .. ": " .. tostring(result));
			end;
			executing = false;
		end));
	end);

	serverposition = function(looptype, logicname, targetlogic, priority, direction, ignore_priority)
		if typeofcache(logicname) ~= "string" then
			warn("invalid logic name");
			return;
		end;
		
		if registeredspoofs[logicname] then
			warn("logic already registered: " .. logicname);
			return;
		end;
		
		if typeofcache(targetlogic) ~= "function" then
			warn("invalid callback for: " .. logicname);
			return;
		end;
		
		if priority ~= nil and typeofcache(priority) ~= "number" then
			warn("invalid priority for: " .. logicname);
			return;
		end;
		
		if typeofcache(looptype) ~= "string" then
			warn("invalid looptype for: " .. logicname);
			return;
		end;

		local lt = looptype:lower();
		registeredspoofs[logicname] = {
			priority = priority or 0,
			timestamp = tickcache(),
			callback = targetlogic,
			looptype = lt,
			name = logicname,
			direction = direction == true,
			ignore_priority = (direction == true) and (ignore_priority == true),
		};
	end;

	setrunning = function(logicname, booleanref, persistent)
		local spoofdata = registeredspoofs[logicname];
		if not spoofdata then
			warn("invalid name: " .. tostring(logicname));
			return;
		end;
		local function applystatus(s)
			local status = s;
			if typeofcache(s) == "function" then
				status = s();
			end;
			if status == true then
				local n = #activespoofs;
				for i = 1, n do
					if activespoofs[i].name == logicname then
						return;
					end;
				end;
				activespoofs[n + 1] = spoofdata;
				if not currentactive or spoofdata.priority > currentactive.priority or (spoofdata.priority == currentactive.priority and spoofdata.timestamp < currentactive.timestamp) then
					currentactive = spoofdata;
				end;
				refreshconnection();
			else
				local removedcurrent = false;
				local n = #activespoofs;
				for i = 1, n do
					local v = activespoofs[i];
					if v.name == logicname then
						if v == currentactive then
							removedcurrent = true;
						end;
						activespoofs[i] = activespoofs[n];
						activespoofs[n] = nil;
						break;
					end;
				end;
				if removedcurrent then
					evaluatecurrent();
				end;
				refreshconnection();
			end;
		end;

		applystatus(booleanref);
		if persistent then
			persistentloops[logicname] = persistentloops[logicname] or {};
			persistentloops[logicname].paused = false;
			persistentloops[logicname].getter = booleanref;
			if not persistentloops[logicname].connection then
				persistentloops[logicname].connection = create_connection(runservice.Heartbeat, LPH_NO_VIRTUALIZE(function()
					local loop = persistentloops[logicname];
					if not loop.paused then
						local desired;
						if typeofcache(loop.getter) == "function" then
							desired = loop.getter();
						else
							desired = loop.getter;
						end;
						if desired ~= getrunning(logicname) then
							applystatus(loop.getter);
						end;
					end;
				end));
			end;
		end;
	end;

	getrunning = function(logicname)
		if not registeredspoofs[logicname] then
			return false;
		end;
		local n = #activespoofs;
		for i = 1, n do
			if activespoofs[i].name == logicname then
				return true;
			end;
		end;
		return false;
	end;

	resetcframe = function()
		stopspoofing = true;
		isspoofing = false;
		executing = false;
		if primarypart and clientcframe then
			primarypart.CFrame = clientcframe;
		end;
		for name, _ in pairs(registeredspoofs) do
			local pl = persistentloops[name];
			if pl then
				pl.paused = true;
				if pl.connection then
					pl.connection:Disconnect();
					pl.connection = nil;
				end;
			end;
		end;
		local n = #activespoofs;
		for i = n, 1, -1 do
			activespoofs[i] = nil;
		end;
		currentactive = nil;
		if connection then
			connection:Disconnect();
			connection = nil;
			currentlooptype = nil;
		end;
		stopspoofing = false;
	end;

	clearspoofs = function()
		for _, v in pairs(persistentloops) do
			if v.connection then
				v.connection:Disconnect();
			end;
		end;

		activespoofs = {};
		registeredspoofs = {};
		persistentloops = {};
		currentactive = nil;
		if connection then
			connection:Disconnect();
			connection = nil;
			currentlooptype = nil;
		end;
	end;

	retrieve_position = function(callback)
		if typeof(callback) ~= "function" then
			warn("invalid callback for retrieve_position");
			return;
		end;
		cframecallback = LPH_JIT_MAX(function(cf)
			local is_spoofing = cf ~= clientcframe and currentactive and currentactive.name ~= "exclude";
			callback(cf, is_spoofing);
		end);
	end;
end;

do
	local noclip_connections = {};
	local noclip_parts = {};

	noclip = function()
		for i = 1, #noclip_connections do
			noclip_connections[i]:Disconnect();
		end;
		noclip_connections = {};

		local char = localplayer.Character;
		if not char then
			noclip_parts = {};
			return;
		end;

		if not config.noclip_enabled then
			for i = 1, #noclip_parts do
				local part = noclip_parts[i];
				if part and part.Parent and part.Name == "HumanoidRootPart" then
					if part.CanCollide ~= true then
						part.CanCollide = true;
					end;
				end;
			end;
			noclip_parts = {};
			return;
		end;

		noclip_parts = {};

		local descs = char:GetDescendants();
		local n = #descs;
		for i = 1, n do
			local part = descs[i];
			if part:IsA("BasePart") then
				noclip_parts[#noclip_parts + 1] = part;
			end;
		end;

		local runservice_stepped = runservice.Stepped;
		table.insert(noclip_connections, runservice_stepped:Connect(LPH_JIT_MAX(function()
			for i = 1, #noclip_parts do
				local part = noclip_parts[i];
				if part and part.Parent then
					if part.CanCollide ~= false then
						part.CanCollide = false;
					end;
				end;
			end;
		end)));
	end;
end;

do
	getgenv().fc_speed = 300;
	local fc_running = false;
	local cam_pos, camera_rotation, camera_fov;
	local velocity_sprint, pan_spring;

	local Spring = {};
	Spring.__index = Spring;

	function Spring.new(value)
		return setmetatable({
			pos = value,
			vel = typeof(value) == "Vector3" and vector3_new() or vector2_new(),
			target = value,
			speed = 20,
			damper = 1,
		}, Spring);
	end;

	function Spring:Reset(value)
		self.pos = value;
		self.vel = typeof(value) == "Vector3" and vector3_new() or vector2_new();
		self.target = value;
	end;

	function Spring:Update(dt)
		local disp = self.pos - self.target;
		local sprint_force = -disp * self.speed;
		local damp_force = -self.vel * (2 * math.sqrt(self.speed) * self.damper);
		local accel = sprint_force + damp_force;
		self.vel = self.vel + accel * dt;
		self.pos = self.pos + self.vel * dt;
		return self.pos;
	end;


	velocity_sprint = Spring.new(vector3_new());
	pan_spring = Spring.new(vector2_new());

	local player_state = {}
	do
		local cache_cameratype;
		function player_state.push()
			cache_cameratype = camera.CameraType;
			camera.CameraType = Enum.CameraType.Scriptable;
			if localplayer.Character then
				local humanoid = localplayer.Character:FindFirstChildOfClass("Humanoid");
				if humanoid then
					humanoid.WalkSpeed = 0;
					humanoid.JumpPower = 0;
				end;
			end;
		end;

		function player_state.pop()
			camera.CameraType = cache_cameratype or Enum.CameraType.Custom
			if localplayer.Character then
				local humanoid = localplayer.Character:FindFirstChildOfClass("Humanoid");
				if humanoid then
					humanoid.WalkSpeed = 16;
					humanoid.JumpPower = 50;
				end;
			end;
		end;
	end;

	local input = {};
	do
		local rmb_down = false;
		local began_connection, end_connection, change_connection;

		function input.start_capture()
			began_connection = userinputservice.InputBegan:Connect(function(input, gpe)
				if gpe then return; end;
				if input.UserInputType == Enum.UserInputType.MouseButton2 then
					rmb_down = true;
					userinputservice.MouseBehavior = Enum.MouseBehavior.LockCenter;
				end;
			end);

			end_connection = userinputservice.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton2 then
					rmb_down = false;
					userinputservice.MouseBehavior = Enum.MouseBehavior.Default;
				end;
			end);

			change_connection = userinputservice.InputChanged:Connect(function(input)
				if not rmb_down then return; end;
				if input.UserInputType == Enum.UserInputType.MouseMovement then
					camera_rotation = camera_rotation + vector2_new(input.Delta.X, input.Delta.Y) * 0.01;
				end;
			end);
		end;

		function input.stop_capture()
			if began_connection then began_connection:Disconnect(); end;
			if end_connection then end_connection:Disconnect(); end;
			if change_connection then change_connection:Disconnect(); end;
			userinputservice.MouseBehavior = Enum.MouseBehavior.Default;
			rmb_down = false;
		end;

		function input.get_move_vector()
			local move_vector = vector3_zero;
			local W = userinputservice:IsKeyDown(Enum.KeyCode.W);
			local S = userinputservice:IsKeyDown(Enum.KeyCode.S);
			local A = userinputservice:IsKeyDown(Enum.KeyCode.A);
			local D = userinputservice:IsKeyDown(Enum.KeyCode.D);
			local E = userinputservice:IsKeyDown(Enum.KeyCode.E);
			local Q = userinputservice:IsKeyDown(Enum.KeyCode.Q);
			if W then move_vector = move_vector + vector3_new(0, 0, -1); end;
			if S then move_vector = move_vector + vector3_new(0, 0, 1); end;
			if A then move_vector = move_vector + vector3_new(-1, 0, 0); end;
			if D then move_vector = move_vector + vector3_new(1, 0, 0); end;
			if E then move_vector = move_vector + vector3_new(0, 1, 0); end;
			if Q then move_vector = move_vector + vector3_new(0, -1, 0); end;
			return move_vector;
		end;
	end;

	local step_fc = LPH_JIT(function(dt)
		local rotation_cframe = cframe_angles(0, -camera_rotation.X, 0) * cframe_angles(-camera_rotation.Y, 0, 0)
		local move_input = input.get_move_vector();
		local speed = getgenv().fc_speed or 80;
		local vel = (rotation_cframe:VectorToWorldSpace(move_input));
		if vel.Magnitude > 0 then
			vel = vel.Unit * speed;
		end;
		cam_pos = cam_pos + vel * dt;
		camera.CFrame = cframe_new(cam_pos) * rotation_cframe;
		camera.FieldOfView = camera_fov;
	end);

	getgenv().start_fc = function(pos)
		if fc_running then
			stop_fc();
		end;
		local cam_cframe = camera.CFrame;
		if pos then
			cam_cframe = pos;
		end;
		local pitch, yaw = cam_cframe:ToOrientation();
		camera_rotation = vector2_new(-yaw, -pitch);
		cam_pos = cam_cframe.p;
		camera_fov = camera.FieldOfView;
		player_state.push();
		runservice:BindToRenderStep("Freecam", Enum.RenderPriority.Camera.Value, step_fc);
		input.start_capture();
		fc_running = true;
	end;

	getgenv().stop_fc = function()
		if not fc_running then return; end;

		input.stop_capture();
		runservice:UnbindFromRenderStep("Freecam");
		if humanoidrootpart then
			local rotation = cframe_angles(0, -camera_rotation.X, 0);
			humanoidrootpart.CFrame = cframe_new(cam_pos + rotation.LookVector * 5) * rotation;
		end;

		player_state.pop();
		camera.FieldOfView = 70;

		fc_running = false;
	end;

	start_platform = function()
		local humanoid = localplayer.Character and localplayer.Character:FindFirstChildOfClass("Humanoid");
		if humanoid then
			humanoid.PlatformStand = true;
		end;
	end;

	stop_platform = function()
		local humanoid = localplayer.Character and localplayer.Character:FindFirstChildOfClass("Humanoid");
		if humanoid then
			humanoid.PlatformStand = false;
		end;
	end;
end;

local activeloops = {};
local loopsetters = {};
local last_states = {};

local bind_toggle = LPH_NO_VIRTUALIZE(function(togglename, keyname, setter)
	loopsetters[togglename] = {
		keyname = keyname;
		setter = setter;
	};
	local toggleon = Toggles[togglename] and Toggles[togglename].value;
	local option = Options[keyname];
	local new_state = toggleon and (option and option:get_state() or false);
	if last_states[togglename] ~= new_state then
		last_states[togglename] = new_state;
		setter(new_state);
	end;
end);

local cleanup_loops = LPH_NO_VIRTUALIZE(function()
	for togglename, data in pairs(loopsetters) do
		last_states[togglename] = nil;
		bind_toggle(togglename, data.keyname, data.setter);
	end;
end);

localplayer.CharacterAdded:Connect(LPH_JIT(function(char)
    character = char;
    humanoidrootpart = char:WaitForChild("HumanoidRootPart");
    humanoid = char:WaitForChild("Humanoid");
    camera = workspace.CurrentCamera;
    cleanup_loops();

    if config.noclip_enabled then
        task.wait(0.1);
        noclip();
    end;
end));

do
	local function targetcframe(cf)
		local x = math_random(-5000, 5000);
		local y = 10000;
		local z = math_random(-5000, 5000);
		return cframe_new(x, y, z);
	end;

	serverposition("heartbeat", "void_hide_logic", LPH_NO_VIRTUALIZE(function(cf)
		humanoidrootpart.AssemblyAngularVelocity = vector3_zero;
		humanoidrootpart.AssemblyLinearVelocity = vector3_zero;
		return targetcframe(cf);
	end), 2);
	
	local space_down = false;
	local c_down = false;

	create_connection(userinputservice.InputBegan, LPH_JIT_MAX(function(input, gpe)
		if gpe then return; end;
		if input.KeyCode == enum.KeyCode.Space or input.KeyCode == enum.KeyCode.E then
			space_down = true;
		end;
		if input.KeyCode == enum.KeyCode.C then
			c_down = true;
		end;
	end));

	create_connection(userinputservice.InputEnded, LPH_JIT_MAX(function(input, gpe)
		if input.KeyCode == enum.KeyCode.Space or input.KeyCode == enum.KeyCode.E then
			space_down = false;
		end;

		if input.KeyCode == enum.KeyCode.C then
			c_down = false;
		end;
	end));

	local fly_cleaned_up = false;
	local movement_connection = nil;
	update_movement_connection = LPH_NO_VIRTUALIZE(function()
		local need_connection = config.fly_enabled or (config.velocity_enabled and config.velocity_speed);
		if need_connection then
			if not movement_connection then
				movement_connection = create_connection(runservice.Heartbeat, LPH_JIT_MAX(function(delta_time)
					if not humanoidrootpart then return; end;
					if (getrunning("strafe_logic")) then return; end;
					if (config.fly_enabled) then
						fly_cleaned_up = false;
						fly_cframe = fly_cframe or humanoidrootpart.CFrame;
						humanoidrootpart.Velocity = vector3_zero;
						humanoidrootpart.RotVelocity = vector3_zero;
						local camera_cframe = workspace.CurrentCamera.CFrame;
						local move_direction = humanoid.MoveDirection;
						local vertical = (space_down and 1 or 0) - (c_down and 1 or 0);
						local move = (move_direction.Magnitude > 0 or vertical ~= 0) and ((camera_cframe.LookVector * move_direction:Dot(vector3_new(camera_cframe.LookVector.X, 0, camera_cframe.LookVector.Z).Unit) + camera_cframe.RightVector * move_direction:Dot(vector3_new(camera_cframe.RightVector.X, 0, camera_cframe.RightVector.Z).Unit) + vector3_new(0, 1, 0) * vertical)).Unit or vector3_zero;
						local new_position = (fly_cframe + move * config.fly_speed * delta_time).Position;
						fly_cframe = cframe_new(new_position, new_position + camera_cframe.LookVector);
						humanoidrootpart.CFrame = fly_cframe;

						if (config.fly_platformstand) then
							if (humanoid.PlatformStand ~= true) then
								humanoid.PlatformStand = true;
							end;
						else
							if (humanoid.PlatformStand ~= false) then
								humanoid.PlatformStand = false;
							end;
						end;
					else
						if not fly_cleaned_up then
							fly_cleaned_up = true;
							fly_cframe = nil;
							if (humanoid and humanoid.PlatformStand) then
								humanoid.PlatformStand = false;
							end;
						end;
					end;

					if config.velocity_enabled and config.velocity_speed then
						local move_direction = humanoid.MoveDirection;
						if move_direction.Magnitude > 0 then
							local method = config.speed_method or "velocity";
							if (method == "velocity") then
								local velocity = humanoidrootpart.AssemblyLinearVelocity;
								local horizontal = vector3_new(move_direction.X, 0, move_direction.Z).Unit;
								humanoidrootpart.AssemblyLinearVelocity = vector3_new(horizontal.X * config.velocity_speed, velocity.Y, horizontal.Z * config.velocity_speed);
							elseif (method == "cframe") then
								local horizontal = vector3_new(move_direction.X, 0, move_direction.Z).Unit;
								local current_cf = humanoidrootpart.CFrame;
								humanoidrootpart.CFrame = current_cf + horizontal * config.velocity_speed * delta_time;
							end;
						else
							if (config.speed_method == "velocity") then
								local velocity = humanoidrootpart.AssemblyLinearVelocity;
								humanoidrootpart.AssemblyLinearVelocity = vector3_new(0, velocity.Y, 0);
							end;
						end;
					end;
				end));
			end;
		else
			if movement_connection then
				disconnect_connection(movement_connection);
				movement_connection = nil;
			end;
			if not fly_cleaned_up then
				fly_cleaned_up = true;
				fly_cframe = nil;
				if (humanoid and humanoid.PlatformStand) then
					humanoid.PlatformStand = false;
				end;
			end;
		end;
	end);
end;

do
	local click_teleport_connection = nil;

	update_click_teleport_connection = LPH_NO_VIRTUALIZE(function()
		if config.click_teleport_enabled then
			if not click_teleport_connection then
				click_teleport_connection = create_connection(userinputservice.InputBegan, function(input, gpe)
					if gpe then return; end;
					local keybind_option = Options.ct_toggle;
					if (not keybind_option) then return; end;
					local bound_key = keybind_option.value;
					local is_mouse = (bound_key == "MouseButton1" and input.UserInputType == enum.UserInputType.MouseButton1);
					local is_key = (bound_key ~= "" and input.KeyCode == enum.KeyCode[bound_key]);
					if (not is_mouse and not is_key) then return; end;

					local hrp = localplayer.Character and localplayer.Character:FindFirstChild("HumanoidRootPart");
					if (not hrp) then return; end;

					local mouse = localplayer:GetMouse();
					local hit_pos = mouse.Hit and mouse.Hit.Position;

					if (not hit_pos or (mouse.Target == nil)) then
						local mouse_pos = userinputservice:GetMouseLocation();
						local ray = camera:ViewportPointToRay(mouse_pos.X, mouse_pos.Y);
						local origin = ray.Origin;
						local direction = ray.Direction;
						local char_y = hrp.Position.Y;
						if (math_abs(direction.Y) > 0.001) then
							local t = (char_y - origin.Y) / direction.Y;
							if (t > 0) then
								hit_pos = origin + direction * t;
							else
								hit_pos = origin + direction * 200;
							end;
						else
							hit_pos = origin + direction * 200;
						end;
					end;

					if (hit_pos) then
						teleport(cframe_new(hit_pos + vector3_new(0, hrp.Size.Y / 2 + 0.5, 0)));
					end;
				end);
			end;
		else
			if click_teleport_connection then
				disconnect_connection(click_teleport_connection);
				click_teleport_connection = nil;
			end;
		end;
	end);
end;

local function update_keybind_ui(option, mode)
	if (option.type ~= "KeyPicker") then return; end;
	if (option.permanent_no_ui) then return; end;
	if (mode == "all") then
		option.no_ui = false;
	elseif (mode == "active") then
		local owning_toggle = nil;
		for name, toggle in pairs(Toggles) do
			local opt = Options[name .. "_keybind"] or Options[name .. "_bind"] or Options[name .. "_key"];
			if (opt == option) then
				owning_toggle = toggle;
				break;
			end;
		end;

		if (owning_toggle) then
			option.no_ui = not owning_toggle.value;
		end;
	elseif (mode == "none") then
		option.no_ui = true;
	end;
	option:update();
end;

local function update_keybinds(mode)
	if (not library.keybind_frame) then return; end;
	if (mode == "none") then
		library.keybind_frame.Visible = false;
		return;
	end;

	library.keybind_frame.Visible = true;
	for _, option in pairs(Options) do
		update_keybind_ui(option, mode);
	end;
	library:refresh_keybinds();
end;

local current_keybind = "all";

local function on_toggle_changed()
	if (current_keybind == "active") then
		update_keybinds("active");
	end;
end;

do
	local angle = 0;
	local random_t = 0;
	local orbit_cframe = cframe_new();
	local strafe_active = true;
	local current_target, stick_target = nil;

	local strafe_angle_connection = nil;
	local function update_strafe_angle_connection(state)
		if state then
			if not strafe_angle_connection then
				strafe_angle_connection = create_connection(runservice.Heartbeat, LPH_JIT_MAX(function(dt)
					local teleport_speed_value = config.strafe_speed or 10;
					angle = (angle + dt * teleport_speed_value) % (2 * math_pi);
					random_t = random_t + dt * (teleport_speed_value * 0.75);
				end));
			end;
		else
			if strafe_angle_connection then
				disconnect_connection(strafe_angle_connection);
				strafe_angle_connection = nil;
			end;
		end;
	end;

	local prev_target_cframe = nil;
	local prev_target_time = nil;
	local delta_history = {};
	local HISTORY_SIZE = 6;

	local function get_ping()
		local result = stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000;
		return (result) or 0.08;
	end;

	local function get_smoothed_delta(new_delta)
		local n = #delta_history + 1;
		delta_history[n] = new_delta;
		if (n > HISTORY_SIZE) then
			local removed = delta_history[1];
			for i = 2, n do
				delta_history[i - 1] = delta_history[i];
			end;
			delta_history[n] = nil;
			n = n - 1;
		end;
		local avg = vector3_zero;
		for i = 1, n do
			avg = avg + delta_history[i];
		end;
		return avg / n;
	end;

	serverposition("heartbeat", "strafe_logic", LPH_JIT_MAX(function(real_cframe)
		local char = localplayer.Character;
		if (not char) then return real_cframe; end;
		local hrp = char:FindFirstChild("HumanoidRootPart");
		if (not hrp) then return real_cframe; end;
		local target = current_target;
		if (not target) then return real_cframe; end;
		local target_character = target.Character;
		if (not target_character) then return real_cframe; end;
		local target_primarypart = target_character:FindFirstChild("HumanoidRootPart");
		if (not target_primarypart) then return real_cframe; end;

		local now = tick();
		local current_cframe = target_primarypart.CFrame;
		local predicted_cframe = current_cframe;

		sethiddenproperty(hrp, "PhysicsRepRootPart", target_primarypart);

		if (Toggles.strafe_prediction and Toggles.strafe_prediction.value) then
			if (prev_target_cframe and prev_target_time) then
				local dt = now - prev_target_time;

				if (dt > 0 and dt < 0.2) then
					local raw_delta = current_cframe.Position - prev_target_cframe.Position;
					local smoothed = get_smoothed_delta(raw_delta);
					local velocity = smoothed / dt;

					local ping = get_ping();
					local mult = Options.strafe_pred_mult and Options.strafe_pred_mult.value or 1;
					local base = Options.strafe_pred_base and Options.strafe_pred_base.value or 0;

					local lookahead = ping + (dt * 0.5);
					local offset = vector3_new(
						velocity.X * mult * lookahead,
						velocity.Y * base * lookahead,
						velocity.Z * mult * lookahead
					);

					local MAX_PRED  = 40;
					if (offset.Magnitude > MAX_PRED) then
						offset = offset.Unit * MAX_PRED;
					end;

					predicted_cframe = current_cframe + offset;
				else
					delta_history = {};
				end;
			end;

			prev_target_cframe = current_cframe;
			prev_target_time = now;
		else
			prev_target_cframe = nil;
			prev_target_time = nil;
			delta_history = {};
		end;

		local teleport_speed_value = config.strafe_speed or 10;

		hrp.AssemblyLinearVelocity = vector3_zero;
		hrp.AssemblyAngularVelocity = vector3_zero;

		local function apply_look(pos)
			if (Toggles.strafe_look and Toggles.strafe_look.value) then
				return cframe_new(pos, predicted_cframe.Position);
			end;
			return cframe_new(pos, pos + predicted_cframe.LookVector);
		end;

		local target_cframe;

		if (Toggles.strafe_random_toggle and Toggles.strafe_random_toggle.value) then
			local range = Options.random_range and Options.random_range.value or 5;
			local nx = math.noise(random_t, 1.7) * range * 2;
			local ny = math.noise(random_t, 3.1) * range * 2;
			local nz = math.noise(random_t, 5.3) * range * 2;
			local pos = predicted_cframe.Position + vector3_new(nx, ny, nz);
			target_cframe = apply_look(pos);
		else
			local rx = Options.orbit_radius_x and Options.orbit_radius_x.value or 5;
			local ry = Options.orbit_height_y and Options.orbit_height_y.value or 0;
			local pos = predicted_cframe.Position + vector3_new(math_cos(angle) * rx, ry, math_sin(angle) * rx);
			target_cframe = apply_look(pos);
		end;

		return target_cframe;
	end), 1);

	local is_teleport_allowed = LPH_JIT_MAX(function(player)
		if (not player) then
			return false;
		end;
		if is_player_whitelisted(player) then
			return false;
		end;
		if (player.Parent ~= players) then
			return false;
		end;
		local char = player.Character;
		if (not char) then
			return false;
		end;
		local hum = char:FindFirstChildOfClass("Humanoid");
		local hrp = char:FindFirstChild("HumanoidRootPart");
		if (not hum or not hrp) then
			return false;
		end;
		return true;
	end);

	local elapsed = 0;
	local cleared = false;

	local reset_camera = LPH_JIT(function()
		if not character then return; end;

		local camera_subject;
		if character:GetAttribute("CameraSubject") then
			camera_subject = character:FindFirstChild(character:GetAttribute("CameraSubject"));
		else
			camera_subject = character:FindFirstChildOfClass("Humanoid");
		end;

		if camera_subject and camera.CameraSubject ~= camera_subject then
			camera.CameraSubject = camera_subject;
		end;
	end);

	local saved_cframe;
	local targeting_connection = nil;
	
	update_targeting_connection = LPH_NO_VIRTUALIZE(function()
		local any_active = config.teleport_to_enemy or config.stick or config.spectate_enemy or config.targeting_player;
		if any_active then
			if not targeting_connection then
				targeting_connection = create_connection(runservice.Heartbeat, LPH_JIT(function(dt)
		elapsed += dt;
		if elapsed < 0.1 then return; end;
		elapsed = 0;
		local any_active = config.teleport_to_enemy or config.stick or config.spectate_enemy;
		if not any_active then
			if not cleared then
				cleared = true;
				current_target = nil;
				stick_target = nil;
				config.stick_target = nil;
				setrunning("strafe_logic", false);
				update_strafe_angle_connection(false);
			end;

			reset_camera();
			return;
		end;
		cleared = false;
		if (not character) then
			current_target = nil;
			setrunning("strafe_logic", false);
			update_strafe_angle_connection(false);
			return;
		end;

		if (not config.stick and not config.targeting_player) then
			stick_target = nil;
			config.stick_target = nil;
		end;

		if (not any_active) then
			current_target = nil;
		else
			if (config.stick and stick_target and stick_target.Character and not is_player_whitelisted(stick_target)) then
				current_target = stick_target;
			else
				if (config.stick and stick_target and is_player_whitelisted(stick_target)) then
					stick_target = nil;
					config.stick_target = nil;
				end;
				local closest_distance = math_huge;
				local mouse_position = userinputservice:GetMouseLocation();
				local new_target = nil;
				
				for _, player in ipairs(players:GetPlayers()) do
					if player ~= localplayer and not is_player_whitelisted(player) then
						local char = player.Character;
						if char then
							local hrp = char:FindFirstChild("HumanoidRootPart");
							if hrp then
								local screen_position, on_screen = camera:WorldToViewportPoint(hrp.Position);
								if on_screen then
									local dist = (vector2_new(screen_position.X, screen_position.Y) - mouse_position).Magnitude;
									if dist < closest_distance then
										closest_distance = dist;
										new_target = player;
									end;
								end;
							end;
						end;
					end;
				end;

				current_target = new_target;
				if (config.stick and current_target) then
					stick_target = current_target;
					config.stick_target = current_target;
				end;
			end;
		end;

		local camera_subject;
		if (character:GetAttribute("CameraSubject")) then
			camera_subject = character:FindFirstChild(character:GetAttribute("CameraSubject"));
		else
			camera_subject = character:FindFirstChildOfClass("Humanoid");
		end;

		if (current_target and is_teleport_allowed(current_target) and config.teleport_to_enemy) then
			setrunning("strafe_logic", true);
			update_strafe_angle_connection(true);
		else
			setrunning("strafe_logic", false);
			update_strafe_angle_connection(false);
		end;

		if (config.spectate_enemy and current_target and current_target.Character) then
			local enemy_hum = current_target.Character:FindFirstChildOfClass("Humanoid");
			if enemy_hum and camera.CameraSubject ~= enemy_hum then
				camera.CameraSubject = enemy_hum;
			end;
		elseif (camera_subject and camera.CameraSubject ~= camera_subject) then
			camera.CameraSubject = camera_subject;
		end;
	end));
			end;
		else
			if targeting_connection then
				disconnect_connection(targeting_connection);
				targeting_connection = nil;
			end;
			if not cleared then
				cleared = true;
				current_target = nil;
				stick_target = nil;
				config.stick_target = nil;
				setrunning("strafe_logic", false);
				update_strafe_angle_connection(false);
			end;
			reset_camera();
		end;
	end);
end;

local function esp1()
	local GetService = game.GetService;
	local Service = function(Name)
		return cloneref(GetService(game, Name));
	end;

	local Players = Service("Players");
	local HttpService = Service("HttpService");
	local Workspace = Service("Workspace");
	local RunService = runservice or Service("RunService");
	local FindFirstChild = game.FindFirstChild;
