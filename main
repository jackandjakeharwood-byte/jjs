				apply_self_material();
				self_material_char_conn = localplayer.CharacterAdded:Connect(function(char)
					task_wait(0.5);
					if (self_material_active) then
						original_part_data = {};
						apply_self_material();
					end;
				end);
			else
				restore_self_material();
			end;
		end;
	}):add_color_picker("self_material_color", {
		default = color3_fromrgb(249, 217, 255);
		title = "color";
		transparency = 0.2;
		callback = function(value)
			if (self_material_active) then
				apply_self_material();
			end;
		end;
	});

	self_visuals:add_dropdown("self_material_type", {
		text = "material";
		default = "Neon";
		values = {"Neon", "ForceField", "Glass", "SmoothPlastic", "Ice"};
		callback = function(value)
			if (self_material_active) then
				apply_self_material();
			end;
		end;
	});

	self_visuals:add_toggle("particle_aura_enabled", {
		text = "particle aura";
		default = false;
		callback = function(enabled)
			clear_aura_particles();

			if (particle_aura_conn) then
				particle_aura_conn:Disconnect();
				particle_aura_conn = nil;
			end;

			particle_aura_active = enabled;

			if (enabled) then
				local aura_name = Options.particle_aura_type and Options.particle_aura_type.value or "angel";
				task_spawn(function()
					current_aura_model = load_aura(aura_name);

					if (particle_aura_active and current_aura_model) then
						local col = Options.particle_aura_color and Options.particle_aura_color.value or color3_fromrgb(133, 220, 255);
						recolor_aura_model(current_aura_model, col);
						apply_aura();
					end;
				end);

				particle_aura_conn = localplayer.CharacterAdded:Connect(function()
					task_wait(0.5);
					if (particle_aura_active and current_aura_model) then
						apply_aura();
					end;
				end);
			end;
		end;
	}):add_color_picker("particle_aura_color", {
		default = color3_fromrgb(133, 220, 255);
		title = "aura color";
		transparency = 0.2;
		callback = function(value)
			for _, model in pairs(particle_aura_cache) do
				recolor_aura_model(model, value);
			end;
			local color_seq = colorsequence_new(value);
			for i = 1, #aura_particles do
				local p = aura_particles[i];
				if (p and p.Parent) then
					local cn = p.ClassName;
					if (cn == "PointLight") then
						p.Color = value;
					elseif (cn == "ParticleEmitter" or cn == "Beam" or cn == "Trail") then
						p.Color = color_seq;
					end;
					for _, desc in ipairs(p:GetDescendants()) do
						local dcn = desc.ClassName;
						if (dcn == "PointLight") then
							desc.Color = value;
						elseif (dcn == "ParticleEmitter" or dcn == "Beam" or dcn == "Trail") then
							desc.Color = color_seq;
						end;
					end;
				end;
			end;
		end;
	});

	self_visuals:add_dropdown("particle_aura_type", {
		text = "aura";
		default = "angel";
		values = {"starlight", "heavenly", "ribbon", "sakura", "angel", "wind", "flow", "star", "lightning aura", "cursed energy"};
		callback = function(value)
			task_spawn(function()
				local model = load_aura(value);
				if (model) then
					current_aura_model = model;
					local col = Options.particle_aura_color and Options.particle_aura_color.value or color3_fromrgb(133, 220, 255);
					recolor_aura_model(model, col);
					if (particle_aura_active) then
						apply_aura();
					end;
				end;
			end);
		end;
	});
end;

do
	local function format_player_label(plr)
		if not plr then return "none"; end;
		return string.format("%s (@%s)", plr.DisplayName, plr.Name);
	end;

	local current_target_label = players_group:add_label("current target: none");

	local function get_player_names()
		local list = {};
		for _, p in ipairs(players:GetPlayers()) do
			if p ~= localplayer then
				table.insert(list, p.Name);
			end;
		end;
		table.sort(list, function(a, b) return a:lower() < b:lower(); end);
		return list;
	end;

	local player_dropdown;
	player_dropdown = players_group:add_dropdown("whitelist_player_dropdown", {
		text = "players";
		values = get_player_names();
		allow_null = true;
		default = nil;
		callback = function(value)
			if value and value ~= "" and value ~= "--" then
				local target = players:FindFirstChild(value);
				selected_whitelist_player = target;
				current_target_label:set_text("current target: " .. format_player_label(target));
			else
				selected_whitelist_player = nil;
				current_target_label:set_text("current target: none");
			end;
		end;
	});

	local function refresh_player_dropdown()
		if player_dropdown then
			local names = get_player_names();
			player_dropdown:set_values(names);
			if selected_whitelist_player and not players:FindFirstChild(selected_whitelist_player.Name) then
				selected_whitelist_player = nil;
				current_target_label:set_text("current target: none");
			end;
		end;
	end;

	create_connection(players.PlayerAdded, function()
		task_wait(0.1);
		refresh_player_dropdown();
	end);

	create_connection(players.PlayerRemoving, function(plr)
		if selected_whitelist_player == plr then
			selected_whitelist_player = nil;
			if current_target_label then
				current_target_label:set_text("current target: none");
			end;
		end;
		task_wait(0.1);
		refresh_player_dropdown();
	end);

	local function levenshtein(s1, s2)
		local l1, l2 = #s1, #s2;
		if l1 == 0 then return l2; end;
		if l2 == 0 then return l1; end;

		local d = {};
		for i = 0, l1 do
			d[i] = {[0] = i};
		end;
		for j = 0, l2 do
			d[0][j] = j;
		end;

		for i = 1, l1 do
			local b1 = string.byte(s1, i);
			for j = 1, l2 do
				local cost = (b1 == string.byte(s2, j)) and 0 or 1;
				local del = d[i - 1][j] + 1;
				local ins = d[i][j - 1] + 1;
				local sub = d[i - 1][j - 1] + cost;
				d[i][j] = math.min(del, ins, sub);
			end;
		end;
		return d[l1][l2];
	end;

	players_group:add_input("whitelist_search_input", {
		text = "search player";
		placeholder = "username or display name...";
		callback = function(query)
			query = query:match("^%s*(.-)%s*$");
			if not query or query == "" then
				refresh_player_dropdown();
				return;
			end;

			local query_lower = query:lower();
			local scored = {};

			for _, p in ipairs(players:GetPlayers()) do
				if p ~= localplayer then
					local name_lower = p.Name:lower();
					local disp_lower = p.DisplayName:lower();

					local d_name = levenshtein(query_lower, name_lower);
					local d_disp = levenshtein(query_lower, disp_lower);
					local min_dist = math.min(d_name, d_disp);

					if name_lower:find(query_lower, 1, true) or disp_lower:find(query_lower, 1, true) then
						min_dist = min_dist - 10;
					end;

					table.insert(scored, { player = p, dist = min_dist });
				end;
			end;

			table.sort(scored, function(a, b) return a.dist < b.dist; end);

			local sorted_names = {};
			for _, item in ipairs(scored) do
				table.insert(sorted_names, item.player.Name);
			end;

			if #sorted_names > 0 then
				player_dropdown:set_values(sorted_names);
				local best = scored[1].player;
				selected_whitelist_player = best;
				current_target_label:set_text("current target: " .. format_player_label(best));
				player_dropdown:set_value(best.Name);
			end;
		end;
	});

	players_group:add_button("teleport", function()
		if not selected_whitelist_player then return; end;
		local target_char = selected_whitelist_player.Character;
		local target_hrp = target_char and target_char:FindFirstChild("HumanoidRootPart");
		if target_hrp then
			teleport(target_hrp.CFrame + vector3_new(0, 3, 0));
		end;
	end);

	players_group:add_button("whitelist", function()
		if not selected_whitelist_player then return; end;
		local name_lower = selected_whitelist_player.Name:lower();
		if whitelisted_players[name_lower] then
			library:notify(selected_whitelist_player.Name .. " has already been whitelisted");
			return;
		end;
		whitelisted_players[name_lower] = true;
		if config.stick_target == selected_whitelist_player then
			config.stick_target = nil;
		end;
		library:notify(selected_whitelist_player.Name .. " has been whitelisted");
	end);

	players_group:add_button("unwhitelist", function()
		if not selected_whitelist_player then return; end;
		local name_lower = selected_whitelist_player.Name:lower();
		if not whitelisted_players[name_lower] then
			library:notify(selected_whitelist_player.Name .. " is not whitelisted");
			return;
		end;
		whitelisted_players[name_lower] = nil;
		library:notify(selected_whitelist_player.Name .. " has been unwhitelisted");
	end);

	players_group:add_button("set high priority", function()
		if not selected_whitelist_player then return; end;
		local name = selected_whitelist_player.Name;
		if Options.high_priority_players then
			if Options.high_priority_players.value and Options.high_priority_players.value[name] then
				library:notify(name .. " is already high priority");
				return;
			end;
			local current = Options.high_priority_players.value or {};
			current[name] = true;
			Options.high_priority_players:set_value(current);
			library:notify(name .. " set as high priority");
		end;
	end);

	players_group:add_button("set low priority", function()
		if not selected_whitelist_player then return; end;
		local name = selected_whitelist_player.Name;
		if Options.high_priority_players then
			if not Options.high_priority_players.value or not Options.high_priority_players.value[name] then
				library:notify(name .. " is low priority");
				return;
			end;
			local current = Options.high_priority_players.value or {};
			current[name] = nil;
			Options.high_priority_players:set_value(current);
			library:notify(name .. " removed from high priority");
		end;
	end);
end;

do
	whitelist_group:add_toggle("whitelist", {
		text = "whitelist";
		default = false;
	});

	local whitelist_dependency = whitelist_group:add_dependency_box();
	whitelist_dependency:setup_dependencies({{
		Toggles.whitelist, true;
	}});

	local function get_all_player_names()
		local list = {};
		for _, p in ipairs(players:GetPlayers()) do
			if p ~= localplayer then
				table.insert(list, p.Name);
			end;
		end;
		table.sort(list, function(a, b) return a:lower() < b:lower(); end);
		return list;
	end;

	local whitelist_players_dropdown = whitelist_dependency:add_dropdown("whitelist_players", {
		text = "players";
		values = get_all_player_names();
		multi = true;
		allow_null = true;
		default = nil;
	});

	whitelist_dependency:add_dropdown("whitelist_check", {
		text = "check";
		values = { "friends", "whitelist" };
		multi = true;
		allow_null = true;
		default = nil;
	});

	whitelist_dependency:add_dropdown("high_priority_players", {
		text = "high priority";
		values = get_all_player_names();
		multi = true;
		allow_null = true;
		default = nil;
	});

	local function refresh_whitelist_players()
		if whitelist_players_dropdown then
			local names = get_all_player_names();
			whitelist_players_dropdown:set_values(names);
			if Options.high_priority_players then
				Options.high_priority_players:set_values(names);
			end;
		end;
	end;

	create_connection(players.PlayerAdded, function()
		task_wait(0.1);
		refresh_whitelist_players();
	end);

	create_connection(players.PlayerRemoving, function(plr)
		if plr and Options.whitelist_players and Options.whitelist_players.value then
			local is_high_priority = Options.high_priority_players and Options.high_priority_players.value and Options.high_priority_players.value[plr.Name];
			if not is_high_priority then
				Options.whitelist_players.value[plr.Name] = nil;
			end;
		end;
		task_wait(0.1);
		refresh_whitelist_players();
	end);
end;

do
	anim_group:add_toggle("silent_animation", {
		text = "silent animation";
		default = false;
	});

	local anim_dependency = anim_group:add_dependency_box();

	anim_dependency:setup_dependencies({{
		Toggles.silent_animation, true;
	}});

	anim_dependency:add_toggle("block_animation", {
		text = "block";
		default = false;
	});

	anim_dependency:add_toggle("melee_animation", {
		text = "melee";
		default = false;
	});

	local animation = repstorage.Animations;
	local misc_folder = animation.Misc;

	local folders = {
		misc_folder.Block;
		misc_folder.Hits;
	};
	local ignored_animations = {
		["rbxassetid://120133391090244"] = true;
		["rbxassetid://138196552148011"] = true;
	}
	local block_animations = {};
	local melee_animations = {};

	for _, folder in ipairs(folders) do
		for _, obj in ipairs(folder:GetDescendants()) do
			if obj:IsA("Animation") then
				block_animations[obj.AnimationId] = true;
			end;
		end;
	end;

	for _, folder in ipairs(animation:GetChildren()) do
		if folder.Name ~= "Misc" then
			for _, obj in ipairs(folder:GetDescendants()) do
				if obj:IsA("Animation") then
					local name = obj.Name;
					if (name:match("^Melee[1-4]$") or name == "Down" or name == "Up") then
						melee_animations[obj.AnimationId] = true;
					end;
				end;
			end;
		end;
	end;

	local presimulation_connection;
	local function hook_humanoid(humanoid)
		if (presimulation_connection) then
			presimulation_connection:Disconnect();
			presimulation_connection = nil;
		end;

		presimulation_connection = runservice.PreSimulation:Connect(function()
			if (not Toggles.silent_animation.value) then
				presimulation_connection:Disconnect();
				presimulation_connection = nil;
				return;
			end;

			for _, track in humanoid:GetPlayingAnimationTracks() do
				local anim = track.Animation;
				if not anim then
					continue;
				end;

				local id = anim.AnimationId;
				if (ignored_animations[id]) then
					continue;
				end;

				if (Toggles.melee_animation.value and melee_animations[id]) then
					track:AdjustSpeed(0);
					track:Stop(0);
				elseif (Toggles.block_animation.value and block_animations[id]) then
					track:AdjustSpeed(0);
					track:Stop(0);
				end;
			end;
		end);
	end;

	hook_humanoid(humanoid);
	localplayer.CharacterAdded:Connect(function(character)
		hook_humanoid(character:WaitForChild("Humanoid"));
	end);

	local stun_connection;

	local stun_names = {
		Stun = true;
		NoSprint = true;
		NoJump = true;
		Block = true;
	};

	local setup_stun = LPH_JIT(function(char)
		local info = char:FindFirstChild("Info");
		if not info then
			info = char:WaitForChild("Info", 5);
		end;

		if not info then
			return;
		end;

		for _, child in ipairs(info:GetChildren()) do
			if stun_names[child.Name] then
				child:Destroy();
			end;
		end;

		stun_connection = create_connection(info.ChildAdded, LPH_JIT_MAX(function(child)
			if stun_names[child.Name] then
				task.defer(child.Destroy, child);
			end;
		end));
	end);

	stun_group:add_toggle("no_stun", {
		text = "no stun";
		default = false;
		callback = function(enabled)
			if stun_connection then
				disconnect_connection(stun_connection);
				stun_connection = nil;
			end;

			if enabled then
				local char = localplayer.Character;
				if char then
					setup_stun(char);
				end;
			end;
		end;
	});

	local blackhole_stepped_connection;
	local blackhole_destroyed_connection;
	local effects_child_connection;
	local effects_added_connection;
	local current_black_hole;
	local math_clamp = math.clamp;
	local air_material = Enum.Material.Air;
	local effects_folder = workspace:FindFirstChild("Effects");

	local start_blackhole_polling;
	local stop_blackhole_polling;

	stop_blackhole_polling = function()
		if blackhole_stepped_connection then
			disconnect_connection(blackhole_stepped_connection);
			blackhole_stepped_connection = nil;
		end;

		if blackhole_destroyed_connection then
			disconnect_connection(blackhole_destroyed_connection);
			blackhole_destroyed_connection = nil;
		end;

		current_black_hole = nil;

		if Toggles.anti_blackhole and Toggles.anti_blackhole.value and effects_folder then
			local next_black_hole = effects_folder:FindFirstChild("BlackHole2");
			if next_black_hole and next_black_hole:IsA("BasePart") then
				start_blackhole_polling(next_black_hole);
			end;
		end;
	end;

	start_blackhole_polling = function(black_hole)
		if blackhole_stepped_connection then
			disconnect_connection(blackhole_stepped_connection);
			blackhole_stepped_connection = nil;
		end;

		if blackhole_destroyed_connection then
			disconnect_connection(blackhole_destroyed_connection);
			blackhole_destroyed_connection = nil;
		end;

		current_black_hole = black_hole;

		blackhole_destroyed_connection = create_connection(black_hole.AncestryChanged, function(_, parent)
			if not parent then
				stop_blackhole_polling();
			end;
		end);

		blackhole_stepped_connection = create_connection(runservice.Stepped, LPH_JIT_MAX(function(_, dt)
			if not (current_black_hole and current_black_hole.Parent) then
				stop_blackhole_polling();
				return;
			end;

			if current_black_hole.Size.Magnitude < 1 then
				return;
			end;

			local char = localplayer.Character;
			local root = char and char:FindFirstChild("HumanoidRootPart");
			if not root then
				return;
			end;

			local offset = current_black_hole.Position - root.Position;
			local distance = offset.Magnitude;
			if distance <= 0 or distance > 100 then
				return;
			end;

			local direction = offset.Unit;
			local strength = 1 - math_clamp(distance / 100, 0, 1);
			local humanoid = char:FindFirstChildOfClass("Humanoid");

			local pull_strength;
			if humanoid and humanoid.FloorMaterial == air_material then
				pull_strength = strength * 300;
			else
				pull_strength = strength * 2000;
			end;

			local dust_collect = current_black_hole:FindFirstChild("DustCollect");
			if dust_collect then
				local emitter = dust_collect:FindFirstChildWhichIsA("ParticleEmitter");
				if emitter and not emitter.Enabled then
					stop_blackhole_polling();
					return;
				end;
			end;

			root.AssemblyLinearVelocity -= direction * (pull_strength * dt);
		end));
	end;

	local function cleanup_blackhole_listeners()
		stop_blackhole_polling();

		if effects_child_connection then
			disconnect_connection(effects_child_connection);
			effects_child_connection = nil;
		end;

		if effects_added_connection then
			disconnect_connection(effects_added_connection);
			effects_added_connection = nil;
		end;
	end;

	local function setup_effects_listener()
		if effects_child_connection then
			disconnect_connection(effects_child_connection);
			effects_child_connection = nil;
		end;

		if not (effects_folder and effects_folder.Parent) then
			effects_folder = workspace:FindFirstChild("Effects");
		end;

		if effects_folder then
			effects_child_connection = create_connection(effects_folder.ChildAdded, function(child)
				if child.Name == "BlackHole2" and child:IsA("BasePart") then
					start_blackhole_polling(child);
				end;
			end);

			local existing = effects_folder:FindFirstChild("BlackHole2");
			if existing and existing:IsA("BasePart") then
				start_blackhole_polling(existing);
			end;
		end;
	end;

	stun_group:add_toggle("anti_blackhole", {
		text = "anti blackhole";
		default = false;
		callback = function(enabled)
			cleanup_blackhole_listeners();

			if enabled then
				setup_effects_listener();

				if not effects_folder then
					effects_added_connection = create_connection(workspace.ChildAdded, function(child)
						if child.Name == "Effects" then
							effects_folder = child;
							setup_effects_listener();
						end;
					end);
				end;
			end;
		end;
	});

	localplayer.CharacterAdded:Connect(function(char)
		if Toggles.no_stun and Toggles.no_stun.value then
			if stun_connection then
				disconnect_connection(stun_connection);
				stun_connection = nil;
			end;
			setup_stun(char);
		end;
	end);
end;

do
	local qte_connection;
	local qte_child_connection;
	local qte_poll_thread;
	local listen_for_qte;

	local beam_connection;
	local beam_child_connection;
	local beam_poll_thread;
	local listen_for_beam_qte;

	local function fire_remote()
		for _, plr in ipairs(players:GetPlayers()) do
			local character = plr.Character;
			if (not character) then
				continue;
			end;

			local remote = character:FindFirstChild("RemoteEvent");
			if (remote) then
				remote:FireServer(true);
			end;
		end;
	end;

	local function fire_beam_remotes()
		local beams = workspace:FindFirstChild("Beams");
		if (not beams) then
			return;
		end;

		for _, child in ipairs(beams:GetChildren()) do
			if (child:IsA("RemoteEvent")) then
				child:FireServer(true);
			end;
		end;
	end;

	local function cleanup_qte()
		if (qte_poll_thread) then
			task.cancel(qte_poll_thread);
			qte_poll_thread = nil;
		end;

		if (qte_connection) then
			qte_connection:Disconnect();
			qte_connection = nil;
		end;
	end;

	local function cleanup_child()
		if (qte_child_connection) then
			qte_child_connection:Disconnect();
			qte_child_connection = nil;
		end;
	end;

	local function cleanup_beam_qte()
		if (beam_poll_thread) then
			task.cancel(beam_poll_thread);
			beam_poll_thread = nil;
		end;

		if (beam_connection) then
			beam_connection:Disconnect();
			beam_connection = nil;
		end;
	end;

	local function cleanup_beam_child()
		if (beam_child_connection) then
			beam_child_connection:Disconnect();
			beam_child_connection = nil;
		end;
	end;

	local function handle_qte(qte)
		cleanup_qte();

		if (not qte) then
			return;
		end;

		if (not Toggles.auto_qte_minigame.value) then
			return;
		end;

		qte_connection = qte.AncestryChanged:Connect(function(_, parent)
			if (parent == nil) then
				cleanup_qte();

				task.defer(function()
					if (Toggles.auto_qte_minigame.value) then
						listen_for_qte();
					end;
				end);
			end;
		end);

		qte_poll_thread = task.spawn(function()
			while (Toggles.auto_qte_minigame.value and qte and qte.Parent) do
				fire_remote();
				task.wait(Options.qte_click_delay.value);
			end;
		end);
	end;

	listen_for_qte = function()
		cleanup_child();

		local qte_gui = localplayer.PlayerGui:FindFirstChild("QTE");
		local qte_pc = qte_gui and qte_gui:FindFirstChild("QTE_PC");

		if (qte_pc) then
			task.spawn(handle_qte, qte_pc);
			return;
		end;

		local watch_target = qte_gui or localplayer.PlayerGui;

		qte_child_connection = watch_target.ChildAdded:Connect(function(child)
			if (qte_gui) then
				if (child.Name == "QTE_PC") then
					cleanup_child();
					task.spawn(handle_qte, child);
				end;
			else
				if (child.Name == "QTE") then
					cleanup_child();

					local qte_pc_inner = child:FindFirstChild("QTE_PC");

					if (qte_pc_inner) then
						task.spawn(handle_qte, qte_pc_inner);
					else
						qte_child_connection = child.ChildAdded:Connect(function(inner)
							if (inner.Name == "QTE_PC") then
								cleanup_child();
								task.spawn(handle_qte, inner);
							end;
						end);
					end;
				end;
			end;
		end);
	end;

	local function handle_beam_qte(beam_qte)
		cleanup_beam_qte();

		if (not beam_qte) then
			return;
		end;

		if (not Toggles.auto_qte_minigame.value) then
			return;
		end;

		beam_connection = beam_qte.AncestryChanged:Connect(function(_, parent)
			if (parent == nil) then
				cleanup_beam_qte();

				task.defer(function()
					if (Toggles.auto_qte_minigame.value) then
						listen_for_beam_qte();
					end;
				end);
			end;
		end);

		beam_poll_thread = task.spawn(function()
			while (Toggles.auto_qte_minigame.value and beam_qte and beam_qte.Parent) do
				fire_beam_remotes();
				task.wait(Options.qte_click_delay.value);
			end;
		end);
	end;

	listen_for_beam_qte = function()
		cleanup_beam_child();

		local beam_qte = localplayer.PlayerGui:FindFirstChild("BeamQTE");

		if (beam_qte) then
			task.spawn(handle_beam_qte, beam_qte);
			return;
		end;

		beam_child_connection = localplayer.PlayerGui.ChildAdded:Connect(function(child)
			if (child.Name == "BeamQTE") then
				cleanup_beam_child();
				task.spawn(handle_beam_qte, child);
			end;
		end);
	end;

	auto_group:add_toggle("auto_qte_minigame", {
		text = "auto qte minigame";
		default = false;
	});

	auto_group:add_slider("qte_click_delay", {
		text = "qte click delay";
		default = 0;
		min = 0;
		max = 1;
		rounding = 2;
		suffix = "s";
		compact = true;
	});

	Toggles.auto_qte_minigame:on_changed(function()
		if (Toggles.auto_qte_minigame.value) then
			listen_for_qte();
			listen_for_beam_qte();
		else
			cleanup_qte();
			cleanup_child();
			cleanup_beam_qte();
			cleanup_beam_child();
		end;
	end);
	
	local todo_remote = repstorage.Knit.Knit.Services.TodoService.RE.Activated;
	local right_activated_remote = repstorage.Knit.Knit.Services.TodoService.RE.RightActivated;

	local valid_swap_anims = {
		["rbxassetid://131358603583212"] = true;
		["rbxassetid://91074768993486"] = true;
		["rbxassetid://116040503139675"] = true;
	};

	local waiting_for_swap = false;
	local locked_target = nil;
	local stored_target = nil;
	local animation_start_distance = nil;

	local function get_target_character(target)
		if not target then
			return nil;
		end;

		if typeof(target) ~= "Instance" then
			return nil;
		end;

		if target:IsA("Player") then
			return target.Character;
		end;

		if target:IsA("Model") then
			if target:FindFirstChildOfClass("Humanoid") or target:FindFirstChild("HumanoidRootPart") or players:GetPlayerFromCharacter(target) then
				return target;
			end;
		end;

		if target:IsA("BasePart") then
			local model = target:FindFirstAncestorOfClass("Model");
			if model and (model:FindFirstChildOfClass("Humanoid") or model:FindFirstChild("HumanoidRootPart") or players:GetPlayerFromCharacter(model)) then
				return model;
			end;
		end;

		return nil;
	end;

	local function parse_target(target)
		if not target or typeof(target) ~= "Instance" then
			return nil;
		end;

		local char = get_target_character(target);
		if char then
			return {
				type = "player";
				target = char;
			};
		end;

		return {
			type = "object";
			target = target;
		};
	end;

	local function capture_animation_start_distance(target_data)
		animation_start_distance = nil;

		if not target_data or target_data.type ~= "player" then
			return;
		end;

		local my_character = localplayer.Character;
		local my_hrp = my_character and my_character:FindFirstChild("HumanoidRootPart");
		local target_character = get_target_character(target_data.target);
		local target_hrp = target_character and target_character:FindFirstChild("HumanoidRootPart");

		if my_hrp and target_hrp then
			animation_start_distance = vector3_new(my_hrp.Position.X - target_hrp.Position.X, 0, my_hrp.Position.Z - target_hrp.Position.Z).Magnitude;
		end;
	end;

	local function get_comp_time()
		if not locked_target then
			return nil;
		end;

		local ping = stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000;

		if locked_target.type == "object" then
			return math.max(0, 0.25 - ping);
		end;

		local character = get_target_character(locked_target.target);
		if not character then
			return math.max(0, 0.25 - ping);
		end;

		local in_todo_ult = localplayer.Character and localplayer.Character:GetAttribute("InUlt");
		local value = character:GetAttribute("Ragdoll");
		local ragdolled = value and value > 0;

		if in_todo_ult or ragdolled then
			return math.max(0, 0.30 - ping);
		end;

		if locked_target.type == "player" then
			local my_char = localplayer.Character;
			local my_hrp = my_char and my_char:FindFirstChild("HumanoidRootPart");
			local target_hrp = character:FindFirstChild("HumanoidRootPart");

			if my_hrp and target_hrp then
				local distance = animation_start_distance or vector3_new(my_hrp.Position.X - target_hrp.Position.X, 0, my_hrp.Position.Z - target_hrp.Position.Z).Magnitude;

				if distance >= 31 and distance <= 35 then
					return math.max(0, 0.40 - ping);
				end;

				local max_distance = 60;
				local midpoint = 30;
				local steepness = 0.25;
				local alpha = 1 / (1 + math.exp(-(distance - midpoint) * steepness));
				local min_curve = 1 / (1 + math.exp(-(-midpoint) * steepness));
				local max_curve = 1 / (1 + math.exp(-(max_distance - midpoint) * steepness));

				local normalized_alpha = (alpha - min_curve) / (max_curve - min_curve);
				normalized_alpha = math.clamp(normalized_alpha, 0, 1);

				local wait_time = 0.30 + (0.60 - 0.30) * normalized_alpha;

				return math.max(0, wait_time - ping);
			end;
		end;

		return math.max(0, 0.30 - ping);
	end;

	local function is_todo()
		if (userinputservice:GetFocusedTextBox()) then
			return false;
		end;
		local char = localplayer.Character;
		if (not char) then
			return false;
		end;
		if (char:GetAttribute("Moveset") ~= "Todo") then
			return false;
		end;
		return true;
	end;

	local function handle_swap_anim(track)
		if (not Toggles.auto_todo_swap.value) then return; end;
		local anim = track.Animation;
		if (not anim) then return; end;
		local anim_id = anim.AnimationId;
		if (not valid_swap_anims[anim_id]) then return; end;
		if (waiting_for_swap) then return; end;
		if (not is_todo()) then return; end;
		locked_target = locked_target or stored_target;
		if (not locked_target) then return; end;
		if (not animation_start_distance) then
			capture_animation_start_distance(locked_target);
		end;
		local delay_time = get_comp_time();
		if (not delay_time) then return; end;
		waiting_for_swap = true;
		task.delay(delay_time, function()
			waiting_for_swap = false;
			if (not is_todo()) then return; end;
			if (not locked_target) then return; end;
			todo_remote:FireServer(false);
			stored_target = nil;
			locked_target = nil;
			animation_start_distance = nil;
		end);
	end;

	local function setup_char(char)
		local humanoid = char:WaitForChild("Humanoid");
		humanoid.AnimationPlayed:Connect(handle_swap_anim);
	end;

	if (localplayer.Character) then
		setup_char(localplayer.Character);
	end;
	localplayer.CharacterAdded:Connect(setup_char);

	auto_group:add_toggle("auto_todo_swap", {
		text = "auto todo swap";
		default = false;
	});

	local yuki_firing = false;
	local yuki_connections = {};
	local yuki_char_connection = nil;
	local yuki_right_activated_remote = nil;
	local yuki_right_deactivated_remote = nil;

	local function is_yuki()
		local char = localplayer.Character;
		if not char then
			return false;
		end;
		return char:GetAttribute("Moveset") == "Yuki";
	end;

	local function get_yuki_remotes()
		if yuki_right_activated_remote and yuki_right_activated_remote.Parent and yuki_right_deactivated_remote and yuki_right_deactivated_remote.Parent then
			return yuki_right_activated_remote, yuki_right_deactivated_remote;
		end;

		local knit_pkg = repstorage:FindFirstChild("Knit");
		local knit = knit_pkg and knit_pkg:FindFirstChild("Knit");
		local services = knit and knit:FindFirstChild("Services");
		local yuki_service = services and services:FindFirstChild("YukiService");
		local re = yuki_service and yuki_service:FindFirstChild("RE");

		if re then
			yuki_right_activated_remote = re:FindFirstChild("RightActivated");
			yuki_right_deactivated_remote = re:FindFirstChild("RightDeactivated");
		end;

		return yuki_right_activated_remote, yuki_right_deactivated_remote;
	end;

	local function on_yuki_blackhole()
		if yuki_firing then
			return;
		end;
		if not Toggles.auto_yuki_blackhole or not Toggles.auto_yuki_blackhole.value then
			return;
		end;
		if not is_yuki() then
			return;
		end;

		yuki_firing = true;
		task_spawn(function()
			local right_act, right_deact = get_yuki_remotes();

			if right_act and right_deact then
				for i = 1, 100 do
					if not Toggles.auto_yuki_blackhole or not Toggles.auto_yuki_blackhole.value then
						break;
					end;
					local char = localplayer.Character;
					if not char or not char.Parent or not is_yuki() then
						break;
					end;

					right_act:FireServer();
					runservice.Heartbeat:Wait();
					right_deact:FireServer();
				end;
			end;
			yuki_firing = false;
		end);
	end;

	local function cleanup_yuki_connections()
		for _, conn in ipairs(yuki_connections) do
			conn:Disconnect();
		end;
		table.clear(yuki_connections);
	end;

	local function setup_yuki_char(char)
		cleanup_yuki_connections();
		if not char then return; end;

		local hrp = char:WaitForChild("HumanoidRootPart", 5);
		if not hrp then return; end;

		local function check_sound(inst)
			if not inst:IsA("Sound") then return; end;

			local function evaluate()
				if not is_yuki() then return; end;
				if inst.Playing and inst.SoundId:find("15048731914") then
					on_yuki_blackhole();
				end;
			end;

			evaluate();

			table.insert(yuki_connections, inst.Played:Connect(function()
				if is_yuki() and inst.SoundId:find("15048731914") then
					on_yuki_blackhole();
				end;
			end));

			table.insert(yuki_connections, inst:GetPropertyChangedSignal("Playing"):Connect(evaluate));
			table.insert(yuki_connections, inst:GetPropertyChangedSignal("SoundId"):Connect(evaluate));
		end;

		for _, child in ipairs(hrp:GetChildren()) do
			check_sound(child);
		end;

		table.insert(yuki_connections, hrp.ChildAdded:Connect(check_sound));
	end;

	auto_group:add_toggle("auto_yuki_blackhole", {
		text = "auto yuki blackhole";
		default = false;
		callback = function(enabled)
			cleanup_yuki_connections();

			if yuki_char_connection then
				yuki_char_connection:Disconnect();
				yuki_char_connection = nil;
			end;

			if not enabled then
				return;
			end;

			if localplayer.Character then
				setup_yuki_char(localplayer.Character);
			end;

			yuki_char_connection = localplayer.CharacterAdded:Connect(setup_yuki_char);
		end;
	});

	auto_group:add_toggle("auto_nanami_ratio", {
		text = "auto nanami ratio";
		default = false;
	});

	local nanami_service = repstorage:FindFirstChild("Knit") and repstorage.Knit:FindFirstChild("Knit") and repstorage.Knit.Knit:FindFirstChild("Services") and repstorage.Knit.Knit.Services:FindFirstChild("NanamiService");
	local nanami_right_activated_remote = nanami_service and nanami_service:FindFirstChild("RE") and nanami_service.RE:FindFirstChild("RightActivated");

	local function get_nanami_right_activated_remote()
		if nanami_right_activated_remote and nanami_right_activated_remote.Parent then
			return nanami_right_activated_remote;
		end;
		local svc = repstorage:FindFirstChild("Knit") and repstorage.Knit:FindFirstChild("Knit") and repstorage.Knit.Knit.Services:FindFirstChild("NanamiService");
		if svc and svc:FindFirstChild("RE") then
			nanami_right_activated_remote = svc.RE:FindFirstChild("RightActivated");
		end;
		return nanami_right_activated_remote;
	end;

	local waiting_for_nanami = false;
	local nanami_self_firing = false;

	local function is_nanami()
		if (userinputservice:GetFocusedTextBox()) then
			return false;
		end;
		local char = localplayer.Character;
		if (not char) then
			return false;
		end;
		if (char:GetAttribute("Moveset") ~= "Nanami") then
			return false;
		end;
		return true;
	end;

	local function get_nanami_fallback_character()
		local my_char = localplayer.Character;
		local my_hrp = my_char and my_char:FindFirstChild("HumanoidRootPart");
		if not my_hrp then
			return nil;
		end;

		local closest_char = nil;
		local closest_dist = 60;

		local function check_model(model)
			if not model or model == my_char or not model:IsA("Model") then
				return;
			end;
			local hum = model:FindFirstChildOfClass("Humanoid");
			local hrp = model:FindFirstChild("HumanoidRootPart");
			if hum and hum.Health > 0 and hrp then
				local dist = (my_hrp.Position - hrp.Position).Magnitude;
				if dist < closest_dist then
					closest_dist = dist;
					closest_char = model;
				end;
			end;
		end;

		local chars_folder = workspace:FindFirstChild("Characters");
		if chars_folder then
			for _, child in ipairs(chars_folder:GetChildren()) do
				check_model(child);
			end;
		end;

		for _, player in ipairs(players:GetPlayers()) do
			if player ~= localplayer and player.Character then
				check_model(player.Character);
			end;
		end;

		return closest_char;
	end;

	local function get_nanami_health_ratio(target)
		local character = get_target_character(target);
		if not character or (character:FindFirstChildOfClass("Humanoid") and character:FindFirstChildOfClass("Humanoid").Health <= 0) then
			character = get_nanami_fallback_character();
		end;

		if not character then
			return 1;
		end;

		local humanoid = character:FindFirstChildOfClass("Humanoid");
		if humanoid and humanoid.MaxHealth and humanoid.MaxHealth > 0 then
			local hp = humanoid.Health;
			local max_hp = humanoid.MaxHealth;
			if typeof(hp) == "number" and typeof(max_hp) == "number" and hp >= 0 and max_hp > 0 then
				return math.clamp(hp / max_hp, 0, 1);
			end;
		end;

		return 1;
	end;

	local function get_nanami_comp_time(target)
		local ratio = get_nanami_health_ratio(target);
		local hp_percent = math.clamp(ratio * 100, 0, 100);

		local base_time;
		if hp_percent >= 65 and hp_percent <= 75 then
			base_time = 0.50;
		else
			local smooth_ratio = math.clamp(ratio, 0, 1);
			smooth_ratio = smooth_ratio * smooth_ratio * (3 - 2 * smooth_ratio);

			local min_timing = 0.45;
			local max_timing = 0.62;
			base_time = min_timing + (max_timing - min_timing) * smooth_ratio;
		end;

		local jitter = (math.random() - 0.5) * 0.01;
		local wait_time = base_time + jitter;

		if typeof(wait_time) ~= "number" or wait_time ~= wait_time then
			return 0.6;
		end;

		return math.clamp(wait_time, 0.15, 0.62);
	end;

	local function handle_nanami_right_activated(raw_target)
		if not Toggles.auto_nanami_ratio or not Toggles.auto_nanami_ratio.value then
			return;
		end;

		if not is_nanami() then
			return;
		end;

		if waiting_for_nanami then
			return;
		end;

		waiting_for_nanami = true;

		local delay_time = get_nanami_comp_time(raw_target);

		task.delay(delay_time, function()
			if not is_nanami() or not Toggles.auto_nanami_ratio or not Toggles.auto_nanami_ratio.value then
				waiting_for_nanami = false;
				return;
			end;

			local remote = get_nanami_right_activated_remote();
			if remote then
				local fire_target = raw_target;
				if typeof(fire_target) == "Instance" then
					if not fire_target.Parent then
						local fallback = get_nanami_fallback_character();
						if fallback then
							fire_target = fallback:FindFirstChild("HumanoidRootPart") or fallback;
						end;
					end;
				end;

				nanami_self_firing = true;
				remote:FireServer(fire_target);
				nanami_self_firing = false;
			end;

			waiting_for_nanami = false;
		end);
	end;

	dash_group:add_toggle("dash_cooldown", {
		text = "dash cooldown";
		default = false;
	});

	dash_group:add_toggle("no_parkour_cd", {
		text = "infinite parkour";
		default = false;
	});

	dash_group:add_slider("dash_cooldown_value", {
		text = "cooldown";
		compact = true;
		rounding = 1;
		default = 0.2;
		min = 0;
		max = 3;
		suffix = "s";
	});

	dash_group:add_toggle("force_front_dash", {
		text = "force front dash";
		default = false;
	});

	local knit = require(repstorage.Knit.Knit);
	local movement_controller = knit.GetController("MovementController");

	local function get_upvalue_by_type(fn, expected_type, filter_fn)
		if not debug or not debug.getupvalues then return nil; end;
		local uvs = debug.getupvalues(fn);
		if not uvs then return nil; end;
		for idx, val in pairs(uvs) do
			if type(val) == expected_type then
				if not filter_fn or filter_fn(val) then
					return idx, val;
				end;
			end;
		end;
		return nil;
	end;

	local last_front_dash = 0;
	userinputservice.InputBegan:Connect(function(input, gpe)
		if gpe then return; end;
		if input.KeyCode ~= Enum.KeyCode.Q then
			return;
		end;
		if not character or not character.Parent then
			return;
		end;
		if (not Toggles.force_front_dash.value) then
			return;
		end;
		if tick() - last_front_dash < Options.dash_cooldown_value.value then
			return;
		end;
		local info = character:FindFirstChild("Info")
		if not info then
			return;
		end;
		if (info:FindFirstChild("InSkill")) then
			return;
		end;
		if info:FindFirstChild("DisableChase") then
			last_front_dash = tick();
			movement_controller:Dash(localplayer, character, "Front");
		end;
	end);

	local old2; old2 = hookfunction(movement_controller.Parkour, newcclosure(function(...)
		if Toggles.no_parkour_cd.value then
			local pk_idx = get_upvalue_by_type(old2, "number", function(v) return v >= 0 and v < 1000000; end);
			if pk_idx then
				debug.setupvalue(old2, pk_idx, 0);
			end;
		end;
		return old2(...);
	end));

	local last = 0;
	local old; old = hookfunction(movement_controller.DashRequest, newcclosure(function(self, ...)
		if (not checkcaller() and Toggles.dash_cooldown.value) then
			if (tick() - last >= Options.dash_cooldown_value.value) then
				last = tick();
				local ts_idx = get_upvalue_by_type(old, "number", function(v) return v > 1000000000; end);
				local cnt_idx = get_upvalue_by_type(old, "number", function(v) return v >= 0 and v <= 10; end);
				if ts_idx then
					debug.setupvalue(old, ts_idx, 0);
				end;
				if cnt_idx then
					debug.setupvalue(old, cnt_idx, 2);
				end;
			end;
		end;
		return old(self, ...);
	end));

	local burst_connection;
	local burst_char_connection;
	local burst_retry_token = 0;

	local get_burst_direction = LPH_JIT_MAX(function()
		local hum = (localplayer.Character and localplayer.Character:FindFirstChildOfClass("Humanoid")) or humanoid;
		local move_direction = hum and hum.MoveDirection or vector3_zero;

		if move_direction.Magnitude > 0.1 then
			local hrp = localplayer.Character and localplayer.Character:FindFirstChild("HumanoidRootPart");
			if hrp then
				local cf = hrp.CFrame;
				local right = math.round(move_direction:Dot(cf.RightVector));
				local forward = math.round(move_direction:Dot(cf.LookVector));

				if right == 1 then return "Right"; end;
				if right == -1 then return "Left"; end;
				if forward == 1 then return "Front"; end;
				if forward == -1 then return "Back"; end;
			end;
		end;

		local w = userinputservice:IsKeyDown(Enum.KeyCode.W);
		local a = userinputservice:IsKeyDown(Enum.KeyCode.A);
		local d = userinputservice:IsKeyDown(Enum.KeyCode.D);
		local s = userinputservice:IsKeyDown(Enum.KeyCode.S);

		if a and d then
			return math_random(0, 1) == 0 and "Left" or "Right";
		elseif a then
			return "Left";
		elseif d then
			return "Right";
		elseif w then
			return "Front";
		elseif s then
			return "Back";
		end;

		return "Left";
	end);

	local function try_burst(char, dir)
		repstorage.Knit.Knit.Services.MovementService.RE.Dash:FireServer(dir, true);
	end;

	local setup_burst = LPH_JIT(function(char)
		if burst_connection then
			disconnect_connection(burst_connection);
			burst_connection = nil;
		end;

		if not char then return; end;

		burst_connection = create_connection(
			char:GetAttributeChangedSignal("Burst"),
			LPH_JIT_MAX(function()
				if not Toggles.auto_burst or not Toggles.auto_burst.value then
					return;
				end;

				if char:GetAttribute("Burst") == true then
					local dir = get_burst_direction();
					try_burst(char, dir);
				end;
			end)
		);
	end);

	stun_group:add_toggle("auto_burst", {
		text = "auto burst";
		default = false;
		callback = function(enabled)
			burst_retry_token += 1;
			local current_token = burst_retry_token;

			if burst_connection then
				disconnect_connection(burst_connection);
				burst_connection = nil;
			end;

			if burst_char_connection then
				disconnect_connection(burst_char_connection);
				burst_char_connection = nil;
			end;

			if not enabled then
				return;
			end;

			local char = localplayer.Character;
			if char then
				setup_burst(char);
			end;

			burst_char_connection = create_connection(localplayer.CharacterAdded, function(new_char)
				setup_burst(new_char);
			end);

			task.spawn(function()
				while Toggles.auto_burst and Toggles.auto_burst.value and current_token == burst_retry_token do
					local current_char = localplayer.Character;
					if current_char and current_char:GetAttribute("Burst") == true then
						local dir = get_burst_direction();
						try_burst(current_char, dir);
					end;
					task.wait(0.02);
				end;
			end);
		end;
	});

	local domain_kill_all_state = "IDLE";
	local domain_kill_all_token = 0;
	local domain_sound_connections = {};
	local domain_char_connection;

	local function clear_domain_sound_connections()
		for _, conn in ipairs(domain_sound_connections) do
			if typeof(conn) == "RBXScriptConnection" then
				conn:Disconnect();
			end;
		end;
		table.clear(domain_sound_connections);
	end;

	local function get_domain_sound_type(sound)
		if not sound or not sound:IsA("Sound") then return nil; end;
		local sound_id = tostring(sound.SoundId or "");
		local sound_name = tostring(sound.Name or "");
		local sound_name_lower = sound_name:lower();

		if sound_name == "ShortDomain" or sound_id:find("136494030417281") or sound_name:find("136494030417281") then
			return "SHORT_DOMAIN";
		end;

		if sound_id:find("86891100502580") or sound_name:find("86891100502580") then
			return "SOUND_8689";
		end;

		if sound_name == "Boost1" or sound_name_lower == "boost1" or sound_name_lower:find("boost1") or sound_name_lower == "boost 1" then
			return "BOOST_1";
		end;

		if sound_name == "Boost2" or sound_name_lower == "boost2" or sound_name_lower:find("boost2") or sound_name_lower == "boost 2" then
			return "BOOST_2";
		end;

		if sound_name == "Barrage" or sound_name_lower == "barrage" or sound_name_lower:find("barrage") then
			return "BARRAGE";
		end;

		return nil;
	end;

	local domain_startup_animations = {
		Gojo = "rbxassetid://132725601768618",
		Hakari = "rbxassetid://118861398234801",
		Hanami = "rbxassetid://105801749091005",
		Heian = "rbxassetid://73048386765082",
		Hiromi = "rbxassetid://101617544363219",
		Itadori = "rbxassetid://121984128639453",
		Mahito = "rbxassetid://75736902190737",
		Naoya = "rbxassetid://115561023870463",
		Yuta = "rbxassetid://125335594549446",
	};

	local domain_startup_animation_ids = {
		["132725601768618"] = true,
		["118861398234801"] = true,
		["105801749091005"] = true,
		["73048386765082"] = true,
		["101617544363219"] = true,
		["121984128639453"] = true,
		["75736902190737"] = true,
		["115561023870463"] = true,
		["125335594549446"] = true,
	};

	local function is_playing_domain_startup_anim(target_char)
		local hum = target_char:FindFirstChildOfClass("Humanoid");
		if not hum then return false; end;

		local animator = hum:FindFirstChildOfClass("Animator") or hum;
		local tracks = animator:GetPlayingAnimationTracks();

		local moveset = target_char:GetAttribute("Moveset") or target_char:GetAttribute("Character");
		local specific_anim = moveset and domain_startup_animations[moveset];
		local specific_id = specific_anim and specific_anim:match("%d+");

		for _, track in ipairs(tracks) do
			if track.IsPlaying then
				local anim = track.Animation;
				local anim_id = (anim and anim.AnimationId) or track.Name or "";

				if specific_id and anim_id:find(specific_id) then
					return true;
				end;

				for raw_id in pairs(domain_startup_animation_ids) do
					if anim_id:find(raw_id) then
						return true;
					end;
				end;
			end;
		end;

		return false;
	end;

	local function get_active_domain_centers()
		local centers = {};

		for _, plr in ipairs(players:GetPlayers()) do
			local char = plr.Character;
			if char and is_playing_domain_startup_anim(char) then
				local hrp = char:FindFirstChild("HumanoidRootPart");
				local pos = hrp and hrp.Position or (char.PrimaryPart and char.PrimaryPart.Position) or (char:IsA("Model") and char:GetPivot().Position);
				if pos then
					table.insert(centers, pos);
				end;
			end;
		end;

		local effects = workspace:FindFirstChild("Effects");
		if effects then
			for _, effect in ipairs(effects:GetChildren()) do
				if effect.Name == "DomainBurst" or effect.Name:find("DomainBurst") then
					local burst_pos = (effect:IsA("BasePart") and effect.Position)
						or (effect:IsA("Model") and effect:GetPivot().Position)
						or (effect:FindFirstChild("HumanoidRootPart") and effect.HumanoidRootPart.Position)
						or (effect:FindFirstChildOfClass("BasePart") and effect:FindFirstChildOfClass("BasePart").Position);

					if burst_pos then
						table.insert(centers, burst_pos);
					end;
				end;
			end;
		end;

		return centers;
	end;

	local function is_in_domain_radius(target_char, domain_centers)
		local target_hrp = target_char:FindFirstChild("HumanoidRootPart");
		local target_pos = target_hrp and target_hrp.Position or (target_char.PrimaryPart and target_char.PrimaryPart.Position) or (target_char:IsA("Model") and target_char:GetPivot().Position);
		if not target_pos then return false; end;

		local centers = domain_centers or get_active_domain_centers();
		for _, center_pos in ipairs(centers) do
			if (target_pos - center_pos).Magnitude <= 75 then
				return true;
			end;
		end;

		return false;
	end;

	local function is_target_protected(target_char, domain_centers)
		if not target_char then return true; end;

		if target_char:FindFirstChild("IFrame", true) then
			return true;
		end;

		if is_playing_domain_startup_anim(target_char) then
			return true;
		end;

		if is_in_domain_radius(target_char, domain_centers) then
			return true;
		end;

		local info = target_char:FindFirstChild("info") or target_char:FindFirstChild("Info");
		local has_domain_data = (info and info:FindFirstChild("DomainData")) or target_char:FindFirstChild("DomainData", true);

		if has_domain_data then
			if is_playing_domain_startup_anim(target_char) then
				return true;
			end;
		else
			if target_char:FindFirstChild("DomainTag", true) then
				return true;
			end;
		end;

		return false;
	end;

	local function is_character_dead(char)
		if not char then return true; end;
		return char:GetAttribute("Dead") == true or char:GetAttribute("DeathP") == true;
	end;

	local function get_valid_domain_targets()
		local valid_targets = {};
		local seen = {};
		local domain_centers = get_active_domain_centers();

		local my_char = localplayer.Character;
		local my_hrp = my_char and my_char:FindFirstChild("HumanoidRootPart");
		local has_domain_tag = my_char and my_char:FindFirstChild("DomainTag", true) ~= nil;

		local function add_target(char)
			if not char or seen[char] then return; end;
			seen[char] = true;

			local hrp = char:FindFirstChild("HumanoidRootPart");
			if not hrp then return; end;

			if has_domain_tag and my_hrp then
				if (hrp.Position - my_hrp.Position).Magnitude > 75 then
					return;
				end;
				if char:FindFirstChild("IFrame", true) or is_playing_domain_startup_anim(char) then
					return;
				end;
			else
				if is_target_protected(char, domain_centers) then
					return;
				end;
			end;

			if not is_character_dead(char) then
				table_insert(valid_targets, char);
			end;
		end;

		for _, plr in ipairs(players:GetPlayers()) do
			if plr ~= localplayer and not is_player_whitelisted(plr) then
				add_target(plr.Character);
			end;
		end;

		local chars_folder = workspace:FindFirstChild("Characters");
		if chars_folder then
			for _, child in ipairs(chars_folder:GetChildren()) do
				if child:IsA("Model") and child.Name == "Dummy" and child ~= localplayer.Character then
					add_target(child);
				end;
			end;
		end;

		for _, child in ipairs(workspace:GetChildren()) do
			if child:IsA("Model") and child.Name == "Dummy" and child ~= localplayer.Character then
				add_target(child);
			end;
		end;

		table.sort(valid_targets, function(a, b)
			local a_hum = a:FindFirstChildOfClass("Humanoid");
			local b_hum = b:FindFirstChildOfClass("Humanoid");
			local a_health = a_hum and a_hum.Health or math.huge;
			local b_health = b_hum and b_hum.Health or math.huge;
			return a_health < b_health;
		end);

		return valid_targets;
	end;

	local function run_domain_teleport_loop(target_state, token)
		task_spawn(function()
			while Toggles.point_two_kill_all and Toggles.point_two_kill_all.value and domain_kill_all_state == target_state and domain_kill_all_token == token do
				local target_chars = get_valid_domain_targets();
				for _, target_char in ipairs(target_chars) do
					if not (Toggles.point_two_kill_all and Toggles.point_two_kill_all.value and domain_kill_all_state == target_state and domain_kill_all_token == token) then
						break;
					end;

					if not is_character_dead(target_char) then
						local target_hrp = target_char:FindFirstChild("HumanoidRootPart");
						if target_hrp then
							local my_char = localplayer.Character;
							local my_hrp = my_char and my_char:FindFirstChild("HumanoidRootPart");
							if my_hrp then
								my_hrp.CFrame = target_hrp.CFrame;
								my_hrp.AssemblyLinearVelocity = vector3_zero;
								my_hrp.AssemblyAngularVelocity = vector3_zero;
							end;
							task_wait(0.01);
						end;
					end;
				end;
				task_wait(0.01);
			end;
		end);
	end;


	local function handle_domain_sound(sound, force)
		if not Toggles.point_two_kill_all or not Toggles.point_two_kill_all.value then
			return;
		end;

		local stype = get_domain_sound_type(sound);
		if not stype then return; end;

		if stype == "SHORT_DOMAIN" then
			domain_kill_all_token = domain_kill_all_token + 1;
			domain_kill_all_state = "WAITING_BOOST1";
		elseif stype == "BOOST_1" and (force or domain_kill_all_state == "WAITING_BOOST1" or domain_kill_all_state == "IDLE") then
			domain_kill_all_state = "TELEPORTING_1";
			domain_kill_all_token = domain_kill_all_token + 1;
			run_domain_teleport_loop("TELEPORTING_1", domain_kill_all_token);
		elseif stype == "SOUND_8689" and (force or domain_kill_all_state == "TELEPORTING_1" or domain_kill_all_state == "WAITING_BOOST1" or domain_kill_all_state == "IDLE") then
			domain_kill_all_state = "WAITING_BOOST2";
			domain_kill_all_token = domain_kill_all_token + 1;
			local token = domain_kill_all_token;
			local my_char = localplayer.Character;
			local my_hrp = my_char and my_char:FindFirstChild("HumanoidRootPart");
			if my_hrp then
				local sky_cframe = my_hrp.CFrame + vector3_new(0, 5000, 0);
				my_hrp.CFrame = sky_cframe;
				my_hrp.AssemblyLinearVelocity = vector3_zero;
				my_hrp.AssemblyAngularVelocity = vector3_zero;

				task_spawn(function()
					while Toggles.point_two_kill_all and Toggles.point_two_kill_all.value
						and domain_kill_all_state == "WAITING_BOOST2"
						and domain_kill_all_token == token
						and sound and sound.Parent and (sound.Playing or sound.TimePosition > 0) do
						local current_char = localplayer.Character;
						local current_hrp = current_char and current_char:FindFirstChild("HumanoidRootPart");
						if current_hrp then
							current_hrp.CFrame = sky_cframe;
							current_hrp.AssemblyLinearVelocity = vector3_zero;
							current_hrp.AssemblyAngularVelocity = vector3_zero;
						end;
						runservice.Heartbeat:Wait();
					end;
				end);
			end;
		elseif stype == "BOOST_2" and (force or domain_kill_all_state == "WAITING_BOOST2" or domain_kill_all_state == "TELEPORTING_1" or domain_kill_all_state == "IDLE") then
			domain_kill_all_state = "TELEPORTING_2";
			domain_kill_all_token = domain_kill_all_token + 1;
			run_domain_teleport_loop("TELEPORTING_2", domain_kill_all_token);
		elseif stype == "BARRAGE" and (domain_kill_all_state == "TELEPORTING_2" or domain_kill_all_state == "WAITING_BOOST2") then
			domain_kill_all_state = "IDLE";
			domain_kill_all_token = domain_kill_all_token + 1;
		end;
	end;

	local function check_active_domain_sounds(char)
		if not char or not Toggles.point_two_kill_all or not Toggles.point_two_kill_all.value then
			return;
		end;

		local found_sounds = {};
		for _, desc in ipairs(char:GetDescendants()) do
			if desc:IsA("Sound") then
				local stype = get_domain_sound_type(desc);
				if stype and (desc.Playing or desc.TimePosition > 0) then
					found_sounds[stype] = desc;
				end;
			end;
		end;

		if found_sounds["BOOST_2"] then
			handle_domain_sound(found_sounds["BOOST_2"], true);
		elseif found_sounds["SOUND_8689"] then
			handle_domain_sound(found_sounds["SOUND_8689"], true);
		elseif found_sounds["BOOST_1"] then
			handle_domain_sound(found_sounds["BOOST_1"], true);
		elseif found_sounds["SHORT_DOMAIN"] then
			handle_domain_sound(found_sounds["SHORT_DOMAIN"], true);
		end;
	end;

	local function setup_domain_sound_listener(char)
		clear_domain_sound_connections();
		if not char then return; end;

		local function bind_sound(child)
			if child:IsA("Sound") then
				local played_conn = child.Played:Connect(function()
					handle_domain_sound(child);
				end);
				local playing_conn = child:GetPropertyChangedSignal("Playing"):Connect(function()
					if child.Playing then
						handle_domain_sound(child);
					end;
				end);
				table_insert(domain_sound_connections, played_conn);
				table_insert(domain_sound_connections, playing_conn);

				if child.Playing or child.TimePosition > 0 then
					handle_domain_sound(child);
				end;
			end;
		end;

		for _, desc in ipairs(char:GetDescendants()) do
			if desc:IsA("Sound") then
				bind_sound(desc);
			end;
		end;

		local desc_added_conn = char.DescendantAdded:Connect(bind_sound);
		table_insert(domain_sound_connections, desc_added_conn);

		check_active_domain_sounds(char);
	end;

	local function setup_domain_kill_all(char)
		if char then
			setup_domain_sound_listener(char);
		end;
	end;

	stun_group:add_toggle("point_two_kill_all", {
		text = "0.2 kill all";
		default = false;
		callback = function(enabled)
			domain_kill_all_token = domain_kill_all_token + 1;
			domain_kill_all_state = "IDLE";
			clear_domain_sound_connections();

			if domain_char_connection then
				disconnect_connection(domain_char_connection);
				domain_char_connection = nil;
			end;

			if not enabled then
				return;
			end;

			local char = localplayer.Character;
			if char then
				setup_domain_kill_all(char);
			end;

			domain_char_connection = create_connection(localplayer.CharacterAdded, function(new_char)
				domain_kill_all_state = "IDLE";
				domain_kill_all_token = domain_kill_all_token + 1;
				setup_domain_kill_all(new_char);
			end);
		end;
	});

	local teleport_re = repstorage.Knit.Knit.Services.AntiCheatService.RE.Teleport;
	local teleport_fire_count = 0;

	local old_fire; old_fire = hookfunction(teleport_re.FireServer, newcclosure(function(self, ...)
		if not checkcaller() and self == teleport_re then
			teleport_fire_count = teleport_fire_count + 1;
		end;
		return old_fire(self, ...);
	end));

	local old_namecall; old_namecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		if not checkcaller() then
			local method = getnamecallmethod();
			if method == "FireServer" then
				if (typeof(self) == "Instance" and self.Name == "RightActivated") or self == right_activated_remote or self == nanami_right_activated_remote then
					local parent_service = self.Parent and self.Parent.Parent and self.Parent.Parent.Name;
					if self == right_activated_remote or parent_service == "TodoService" then
						local target = ...;
						if target ~= nil then
							task.spawn(function()
								local parsed = parse_target(target);
								if parsed then
									stored_target = parsed;
									locked_target = parsed;
									capture_animation_start_distance(parsed);
								end;
							end);
						end;
					elseif self == nanami_right_activated_remote or parent_service == "NanamiService" then
						if not nanami_self_firing then
							local target = ...;
							if target ~= nil then
								task.spawn(function()
									handle_nanami_right_activated(target);
								end);
							end;
						end;
					end;
				elseif self == teleport_re then
					teleport_fire_count = teleport_fire_count + 1;
				end;
			end;
		end;
		return old_namecall(self, ...);
	end));

	localplayer.CharacterAdded:Connect(function()
		teleport_fire_count = 0;
		waiting_for_nanami = false;
		nanami_self_firing = false;
	end);
	
	stun_group:add_button("secret", function()
		local char = localplayer.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		
		hrp.CFrame = cframe_new(hrp.CFrame.Position.X, 1000, hrp.CFrame.Position.Z);
		fly_cframe = cframe_new(hrp.CFrame.Position.X, 1000, hrp.CFrame.Position.Z);
		task.wait(0.1);
		if teleport_fire_count % 2 ~= 0 then
			local pos = hrp.CFrame.Position;
			hrp.CFrame = cframe_new(pos.X + 9999, pos.Y, pos.Z);
			task.wait(0.1);
			hrp.CFrame = cframe_new(pos.X, pos.Y, pos.Z);
			task.wait(0.1);
		end;
		repstorage.Knit.Knit.Services.JoinService.RE.Change:FireServer(tostring(char:GetAttribute("Moveset")));
	end);

	main:add_toggle("fly", {
