		Connections = {},
		Errors = {},
		Objects = {},
		Targets = {},
		Folder = "ESP",
		Font = nil,
		Holder = nil,
		settings_version = 0,
		last_font_setting = nil,
		notify_settings_changed = function()
			ESP.settings_version = ESP.settings_version + 1;
			if update_esp_binding then
				update_esp_binding();
			end;
		end;
	};

	local proxy_cache = setmetatable({}, {__mode = "k"})
	local function create_proxy(real_tbl)
		local proxy = {}
		local proxy_metatable = {
			__index = function(_, key)
				local val = real_tbl[key]
				if type(val) == "table" then
					local cached = proxy_cache[val]
					if not cached then
						cached = create_proxy(val)
					end
					return cached
				end
				return val
			end,
			__newindex = function(_, key, val)
				real_tbl[key] = val
				ESP.notify_settings_changed()
			end,
			__pairs = function()
				local function iterator(t, var)
					local k, v = next(real_tbl, var)
					if k ~= nil then
						if type(v) == "table" then
							local cached = proxy_cache[v]
							if not cached then
								cached = create_proxy(v)
							end
							v = cached
						end
						return k, v
					end
				end
				return iterator, proxy, nil
			end,
			__iter = function()
				local function iterator(t, var)
					local k, v = next(real_tbl, var)
					if k ~= nil then
						if type(v) == "table" then
							local cached = proxy_cache[v]
							if not cached then
								cached = create_proxy(v)
							end
							v = cached
						end
						return k, v
					end
				end
				return iterator, proxy, nil
			end,
			__len = function()
				return #real_tbl
			end
		}
		setmetatable(proxy, proxy_metatable)
		proxy_cache[real_tbl] = proxy
		return proxy
	end

	ESP.Settings = create_proxy(ESP.Settings);

	local Client = Players.LocalPlayer;
	local Camera = Workspace.CurrentCamera or FindFirstChildWhichIsA(Workspace, "Camera");
	local Viewport = Camera and Camera.ViewportSize or Vector2.new(1920, 1080);
	local ConnectionsTable = ESP.Connections;
	local ObjectsTable = ESP.Objects;
	local FolderLocation = ESP.Folder;
	local ESPErrors = ESP.Errors;
	local ESPSettings = ESP.Settings;
	local WorldToViewportPoint = Camera and Camera.WorldToViewportPoint or nil;

	local RefreshCamera = LPH_JIT_MAX(function()
		local new_cam = Workspace.CurrentCamera;
		if new_cam and new_cam ~= Camera then
			Camera = new_cam;
			Viewport = Camera.ViewportSize;
			WorldToViewportPoint = Camera.WorldToViewportPoint;
		end;
	end);

	local Utility = {};
	local FontsToDownload = {
		["Tahoma"] = {
			Link = "https://github.com/xectray1/tahoma/raw/refs/heads/main/fs-tahoma-8px.otf";
			Ext = ".otf";
		},
		["Minecraftia"] = {
			Link = "https://github.com/LuckyHub1/LuckyHub/raw/refs/heads/main/Minecraftia.ttf";
			Ext = ".ttf";
		},
		["Silkscreen"] = {
			Link = "https://github.com/LuckyHub1/LuckyHub/raw/refs/heads/main/Silkscreen.ttf";
			Ext = ".ttf";
		},
	};
	
	do
		if not isfolder(FolderLocation) then
			makefolder(FolderLocation);
		end;
		if not isfolder(FolderLocation .. "\\Fonts") then
			makefolder(FolderLocation .. "\\Fonts");
		end;
	end;
	
	do
		local Fonts = getgenv().Fonts;
		if not Fonts then
			getgenv().Fonts = {
				Loaded = {}
			};
			Fonts = getgenv().Fonts;
		end;

		if not isfolder(FolderLocation .. "\\Fonts") then
			makefolder(FolderLocation .. "\\Fonts");
		end;

		local function loadfonts()
			for name, tbl in FontsToDownload do
				local ext = tbl.Ext or ".ttf";
				local fullpath = FolderLocation .. "\\Fonts\\" .. name .. ext;

				if not isfile(fullpath) then
					local ok, data = pcall(game.HttpGet, game, tbl.Link);
					if ok and data then
						writefile(fullpath, data);
					end;
				end;

				if not isfile(FolderLocation .. "\\Fonts\\" .. name .. ".font") then
					local cfg = {
						name = name,
						faces = {{
							name = "Regular",
							weight = 400,
							style = "normal",
							assetId = getcustomasset(fullpath)
						}}
					};
					writefile(FolderLocation .. "\\Fonts\\" .. name .. ".font", HttpService:JSONEncode(cfg));
				end;
			end

			for _, fontpath in listfiles(FolderLocation .. "\\Fonts") do
				local name = fontpath:match("([^\\/]+)%.font$");
				if name and not Fonts.Loaded[name] then
					Fonts.Loaded[name] = font_new(getcustomasset(fontpath), enum.FontWeight.Regular);
				end;
			end;
			ESP.Font = Fonts.Loaded[ESPSettings.Font];
		end;
		task_spawn(loadfonts);
	end

	do
		add_connection = function(Signal, Function)
			local Connection; Connection = Signal:Connect(function(...)
				local Args = {...};
				local Success, Message = pcall(function()
					coroutine_wrap(Function)(table.unpack(Args));
				end);
				if not Success and not ESPErrors[Message] then
					warn(string_format("[ERROR] | An error has occured:\n%s", Message));
					ESPErrors[Message] = Message;
					for i = #ConnectionsTable, 1, -1 do
						if ConnectionsTable[i] == Connection then
							table.remove(ConnectionsTable, i);
							break;
						end;
					end;
					Connection:Disconnect();
				end;
			end);
			if Connection and ConnectionsTable then
				ConnectionsTable[#ConnectionsTable + 1] = Connection;
			end;
			return Connection;
		end;

		create_object = function(Type, Properties, Hidden)
			local Object = instance_new(Type);
			for Index, Value in Properties do Object[Index] = Value; end;
			return Object;
		end;

		calculate_box = LPH_JIT_MAX(function(Target, RootPart, Parts)
			if not Camera or not WorldToViewportPoint then
				return 0, 0, 0, 0, false;
			end;
			local MinX, MinY, MaxX, MaxY = 9000, 9000, -9000, -9000;
			local BoxWidth, BoxHeight = 0, 0;
			local Position, OnScreen = WorldToViewportPoint(Camera, RootPart.Position);
			if cached_settings.BoxDynamicBox then
				for _, Part in Parts do
					if Part.ClassName ~= "HumanoidRootPart" and (Part:IsA("BasePart")) then
						local Size = Part.Size / 2;
						local CF = Part.CFrame;
						local Top, TopOnScreen = WorldToViewportPoint(Camera, (CF * cframe_new(0, Size.Y, 0)).Position);
						local Bottom, BottomOnScreen = WorldToViewportPoint(Camera, (CF * cframe_new(0, -Size.Y, 0)).Position);
						if TopOnScreen or BottomOnScreen then
							local Height = math_abs(Top.Y - Bottom.Y);
							local Width = Height * (Size.X / Size.Y);
							local Center = (Top + Bottom) / 2;
							MinX = math_min(MinX, Center.X - Width);
							MinY = math_min(MinY, Center.Y - Height);
							MaxX = math_max(MaxX, Center.X + Width);
							MaxY = math_max(MaxY, Center.Y + Height);
						end;
					end;
				end;
				BoxWidth, BoxHeight = MaxX - MinX, MaxY - MinY;
			else
				local BaseFOV = 70;
				local FOVScale = math_tan(math_rad(BaseFOV / 2)) / math_tan(math_rad(Camera.FieldOfView / 2));
				local Scale = (RootPart.Size.Y * Camera.ViewportSize.Y) / (Position.Z * 2) * FOVScale;
				BoxWidth, BoxHeight = 3 * Scale, 4.5 * Scale;
				MinX, MinY = Position.X - (BoxWidth / 2), Position.Y - (BoxHeight / 2);
			end;
			return BoxWidth, BoxHeight, MinX, MinY, OnScreen;
		end);

		get_font_type = function(Text)
			local FontType = string_lower(cached_settings.FontType or "normal");
			if (FontType == "uppercase") then
				return string_upper(Text);
			elseif (FontType == "lowercase") then
				return string_lower(Text);
			else
				return Text;
			end;
		end;

		Utility.AddConnection = add_connection;
		Utility.CreateObject = create_object;
		Utility.CalculateBox = calculate_box;
		Utility.GetFontType = get_font_type;
	end;

	local function get_scaled_fontsize()
		return cached_settings.FontSize or 9;
	end;

	add_connection(Workspace:GetPropertyChangedSignal("CurrentCamera"), function()
		RefreshCamera();
	end);

	do
		ESP.Font = Fonts.Loaded[ESPSettings.Font];
		ESP.Holder = create_object("ScreenGui", { Name = "\n", ScreenInsets = enum.ScreenInsets.DeviceSafeInsets, ZIndexBehavior = enum.ZIndexBehavior.Global, ResetOnSpawn = false, DisplayOrder = 1, IgnoreGuiInset = true, Parent = gethui(); });
		function ESP.AddTarget(Target)
			if ESP.Targets[Target] then return; end;
			local TargetInfo = { Objects = {}, CharacterObjects = {}, CharacterConnection = nil, HealthConnection = nil, ToolConnection = {Added = nil, Removed = nil, ItemChanged = nil, InfoChildAdded = nil, InfoChildRemoved = nil, ItemRenamed = nil}, CurrentTool = get_font_type("none"), TargetName = get_font_type(ESPSettings.Name.UseDisplay and (IsA(Target, "Player") and Target.DisplayName or Target.Name) or Target.Name), DistanceEnding = get_font_type(ESPSettings.Distance.Ending), HealthBarValue = 1, LastHealth = 100, LastMaxHealth = 100, FlagsDelay = 0, CachedFlagsString = "", LastTick = os_clock(), LastLazyUpdate = 0, LastDistanceText = "", LastDistanceValue = -1, };
			local Objects = TargetInfo.Objects;
			local ToolConnection = TargetInfo.ToolConnection;
			local CharacterObjects = TargetInfo.CharacterObjects;
			local ESPFont = ESP.Font;
			local ESPFontSize = get_scaled_fontsize();
			local ESPHolder = ESP.Holder;
			local is_player = IsA(Target, "Player");
			local TextAlignments = {
				["Left"] = "Right",
				["Right"] = "Left",
				["Top"] = "Center",
				["Bottom"] = "Center",
			};

			CharacterObjects.Character = is_player and Target.Character or Target;
			CharacterObjects.Children = CharacterObjects.Character and CharacterObjects.Character:GetChildren() or {};
			CharacterObjects.Descendants = CharacterObjects.Character and CharacterObjects.Character:GetDescendants() or {};
			if is_player then
				CharacterObjects.HumanoidRootPart = CharacterObjects.Character and CharacterObjects.Character:FindFirstChild("HumanoidRootPart") or nil;
				CharacterObjects.Humanoid = CharacterObjects.Character and CharacterObjects.Character:FindFirstChildWhichIsA("Humanoid") or nil;
			end;

			do
				local function bind_tool_tracking(char)
					if ToolConnection.ItemChanged then
						ToolConnection.ItemChanged:Disconnect();
						ToolConnection.ItemChanged = nil;
					end;

					if ToolConnection.InfoChildAdded then
						ToolConnection.InfoChildAdded:Disconnect();
						ToolConnection.InfoChildAdded = nil;
					end;

					if ToolConnection.InfoChildRemoved then
						ToolConnection.InfoChildRemoved:Disconnect();
						ToolConnection.InfoChildRemoved = nil;
					end;

					if ToolConnection.ItemRenamed then
						ToolConnection.ItemRenamed:Disconnect();
						ToolConnection.ItemRenamed = nil;
					end;

					TargetInfo.CurrentTool = get_font_type("none");

					local Info = char and char:WaitForChild("Info", 10);

					local function is_valid_item_name(name)
						return name == "Item";
					end;

					local function update_tool()
						local ItemValue = Info and Info:FindFirstChild("Item");

						if not ItemValue or ItemValue.Name ~= "Item" then
							TargetInfo.CurrentTool = get_font_type("none");
							return;
						end;

						local item = ItemValue.Value;
						TargetInfo.CurrentTool = get_font_type(item and item.Name or "none");
					end;

					local function try_hook_item()
						local ItemValue = Info and Info:FindFirstChild("Item");

						if ItemValue and not ToolConnection.ItemChanged then
							update_tool();
							ToolConnection.ItemChanged = add_connection(ItemValue:GetPropertyChangedSignal("Value"), update_tool);
							ToolConnection.ItemRenamed = add_connection(ItemValue:GetPropertyChangedSignal("Name"), update_tool);
						end;
					end;

					if Info then
						try_hook_item();
						if not ToolConnection.ItemChanged then
							TargetInfo.CurrentTool = get_font_type("none");
						end;

						ToolConnection.InfoChildAdded = add_connection(Info.ChildAdded, function(child)
							if is_valid_item_name(child.Name) then
								try_hook_item();
							end;
						end);

						ToolConnection.InfoChildRemoved = add_connection(Info.ChildRemoved, function(child)
							if is_valid_item_name(child.Name) then
								if ToolConnection.ItemChanged then
									ToolConnection.ItemChanged:Disconnect();
									ToolConnection.ItemChanged = nil;
								end;
								TargetInfo.CurrentTool = get_font_type("none");
							end;
						end);
					else
						TargetInfo.CurrentTool = get_font_type("none");
					end;
				end;

				function TargetInfo.Init()
					if #Objects > 0 then return; end;

					if is_player then
						local function on_character(Character)
							CharacterObjects.Character = Character;
							CharacterObjects.HumanoidRootPart = Character:WaitForChild("HumanoidRootPart", 10);
							local Humanoid = Character:WaitForChild("Humanoid", 10);
							CharacterObjects.Humanoid = Humanoid;

							task.delay(0.5, function()
								CharacterObjects.Children = Character:GetChildren();
								CharacterObjects.Descendants = Character:GetDescendants();
							end);

							if Humanoid then
								TargetInfo.LastHealth = Humanoid.Health;
								TargetInfo.LastMaxHealth = Humanoid.MaxHealth;
								TargetInfo.HealthBarValue = TargetInfo.LastHealth / TargetInfo.LastMaxHealth;
								if TargetInfo.HealthConnection then
									TargetInfo.HealthConnection:Disconnect();
								end;
								TargetInfo.HealthConnection = add_connection(Humanoid.HealthChanged, function(Health)
									TargetInfo.LastHealth = Health;
									TargetInfo.LastMaxHealth = Humanoid.MaxHealth;
									TargetInfo.HealthBarValue = TargetInfo.LastHealth / TargetInfo.LastMaxHealth;
								end);
							end;

							bind_tool_tracking(Character);
						end;

						TargetInfo.CharacterConnection = add_connection(Target.CharacterAdded, on_character);

						if Target.Character then
							on_character(Target.Character);
						end;
					end;

					if (not is_player) then
						local function bind_humanoid()
							local humanoid = Target:FindFirstChildWhichIsA("Humanoid");
							if not humanoid then return; end;

							TargetInfo.LastHealth = humanoid.Health;
							TargetInfo.LastMaxHealth = humanoid.MaxHealth;
							TargetInfo.HealthBarValue = humanoid.Health / humanoid.MaxHealth;

							if TargetInfo.HealthConnection then
								TargetInfo.HealthConnection:Disconnect();
								TargetInfo.HealthConnection = nil;
							end;

							TargetInfo.HealthConnection = humanoid.HealthChanged:Connect(function(health)
								if humanoid.Parent == nil then return; end;

								TargetInfo.LastHealth = health;
								TargetInfo.LastMaxHealth = humanoid.MaxHealth;
								TargetInfo.HealthBarValue = health / humanoid.MaxHealth;
							end);
						end;

						bind_humanoid();

						Target.ChildAdded:Connect(function(child)
							if child:IsA("Humanoid") then
								bind_humanoid();
							end;
						end);
					end;

					Objects.TargetHolder = Utility.CreateObject("Frame", {
						Parent = ESPHolder,
						Visible = true,
						BackgroundTransparency = 1,
						Position = udum2_new(0, 0, 0, 0),
