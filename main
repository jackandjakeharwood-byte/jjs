				atmosphere_effect.Color = Options.atmosphere_color and Options.atmosphere_color.value or color3_fromrgb(255, 255, 255);
				atmosphere_effect.Decay = Options.atmosphere_decay_color and Options.atmosphere_decay_color.value or color3_fromrgb(120, 120, 120);
				atmosphere_effect.Density = Options.atmosphere_density and Options.atmosphere_density.value or 0.35;
				atmosphere_effect.Glare = Options.atmosphere_glare and Options.atmosphere_glare.value or 10;
				atmosphere_effect.Haze = Options.atmosphere_haze and Options.atmosphere_haze.value or 1;
				atmosphere_effect.Offset = Options.atmosphere_offset and Options.atmosphere_offset.value or 0;
				atmosphere_effect.Parent = lighting;
			end;
		end;
	}):add_color_picker("atmosphere_color", {
		default = color3_fromrgb(255, 255, 255);
		title = "color";
		transparency = 0;
		callback = function(value)
			if (atmosphere_effect) then atmosphere_effect.Color = value; end;
		end;
	}):add_color_picker("atmosphere_decay_color", {
		default = color3_fromrgb(120, 120, 120);
		title = "decay";
		transparency = 0;
		callback = function(value)
			if (atmosphere_effect) then atmosphere_effect.Decay = value; end;
		end;
	});

	other_visuals:add_slider("atmosphere_density", {
