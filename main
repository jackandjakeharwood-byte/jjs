				local outline_color = Options.self_highlight_outline_color and Options.self_highlight_outline_color.value or color3_fromrgb(255, 255, 255);
				local fill_trans = Options.self_highlight_fill_color and Options.self_highlight_fill_color.transparency or 0.5;
				local outline_trans = Options.self_highlight_outline_color and Options.self_highlight_outline_color.transparency or 0.5;

				self_highlight = instance_new("Highlight");
				self_highlight.FillColor = fill_color;
				self_highlight.FillTransparency = fill_trans;
				self_highlight.OutlineColor = outline_color;
				self_highlight.OutlineTransparency = outline_trans;
				self_highlight.DepthMode = enum.HighlightDepthMode.AlwaysOnTop;
				self_highlight.Enabled = true;
				self_highlight.Parent = gethui();

				apply_self_highlight();

				self_highlight_char_conn = localplayer.CharacterAdded:Connect(function()
					task_wait(0.1);
					apply_self_highlight();
				end);
			end;
		end;
	}):add_color_picker("self_highlight_fill_color", {
		default = color3_fromrgb(255, 255, 255);
		title = "fill";
		transparency = 0.5;
		callback = function(value)
			if (self_highlight) then
				self_highlight.FillColor = value;
			end;
		end;
	}):add_color_picker("self_highlight_outline_color", {
		default = color3_fromrgb(255, 255, 255);
		title = "outline";
		transparency = 0.5;
		callback = function(value)
			if (self_highlight) then
				self_highlight.OutlineColor = value;
			end;
		end;
	});

	self_visuals:add_toggle("self_material_enabled", {
		text = "character material";
		default = false;
		callback = function(enabled)
			if (self_material_char_conn) then
				self_material_char_conn:Disconnect();
				self_material_char_conn = nil;
			end;

			self_material_active = enabled;

			if (enabled) then
				apply_self_material();
				self_material_char_conn = localplayer.CharacterAdded:Connect(function(char)
					task_wait(0.5);
					if (self_material_active) then
						original_part_data = {};
						apply_self_material();
					end;
				end);
			else
				restore_self_material();
			end;
		end;
	}):add_color_picker("self_material_color", {
		default = color3_fromrgb(249, 217, 255);
		title = "color";
		transparency = 0.2;
		callback = function(value)
			if (self_material_active) then
				apply_self_material();
			end;
		end;
	});

	self_visuals:add_dropdown("self_material_type", {
		text = "material";
		default = "Neon";
		values = {"Neon", "ForceField", "Glass", "SmoothPlastic", "Ice"};
		callback = function(value)
			if (self_material_active) then
				apply_self_material();
			end;
		end;
	});

	self_visuals:add_toggle("particle_aura_enabled", {
		text = "particle aura";
		default = false;
		callback = function(enabled)
			clear_aura_particles();

			if (particle_aura_conn) then
				particle_aura_conn:Disconnect();
				particle_aura_conn = nil;
			end;

			particle_aura_active = enabled;

			if (enabled) then
				local aura_name = Options.particle_aura_type and Options.particle_aura_type.value or "angel";
				current_aura_model = load_aura(aura_name);

				if (current_aura_model) then
					local col = Options.particle_aura_color and Options.particle_aura_color.value or color3_fromrgb(133, 220, 255);
					recolor_aura_model(current_aura_model, col);
					apply_aura();
				end;

				particle_aura_conn = localplayer.CharacterAdded:Connect(function()
					task_wait(0.5);
					if (particle_aura_active and current_aura_model) then
						apply_aura();
					end;
				end);
			end;
		end;
	}):add_color_picker("particle_aura_color", {
		default = color3_fromrgb(133, 220, 255);
		title = "aura color";
		transparency = 0.2;
		callback = function(value)
			for _, model in pairs(particle_aura_cache) do
				recolor_aura_model(model, value);
			end;
			local color_seq = colorsequence_new(value);
			for i = 1, #aura_particles do
				local p = aura_particles[i];
				if (p and p.Parent) then
					local cn = p.ClassName;
					if (cn == "PointLight") then
						p.Color = value;
					elseif (cn == "ParticleEmitter" or cn == "Beam" or cn == "Trail") then
						p.Color = color_seq;
					end;
					for _, desc in ipairs(p:GetDescendants()) do
						local dcn = desc.ClassName;
						if (dcn == "PointLight") then
							desc.Color = value;
						elseif (dcn == "ParticleEmitter" or dcn == "Beam" or dcn == "Trail") then
							desc.Color = color_seq;
						end;
					end;
				end;
			end;
		end;
	});

	self_visuals:add_dropdown("particle_aura_type", {
		text = "aura";
		default = "angel";
		values = {"starlight", "heavenly", "ribbon", "sakura", "angel", "wind", "flow", "star"};
		callback = function(value)
			local model = load_aura(value);
			if (model) then
				current_aura_model = model;
				local col = Options.particle_aura_color and Options.particle_aura_color.value or color3_fromrgb(133, 220, 255);
				recolor_aura_model(model, col);
				if (particle_aura_active) then
					apply_aura();
				end;
			end;
		end;
	});
end;

do
	anim_group:add_toggle("silent_animation", {
		text = "silent animation";
		default = false;
	});

	local anim_dependency = anim_group:add_dependency_box();

	anim_dependency:setup_dependencies({{
		Toggles.silent_animation, true;
	}});

	anim_dependency:add_toggle("block_animation", {
		text = "block";
		default = false;
	});

	anim_dependency:add_toggle("melee_animation", {
		text = "melee";
		default = false;
	});

	local animation = repstorage.Animations;
	local misc_folder = animation.Misc;

	local folders = {
		misc_folder.Block;
		misc_folder.Hits;
	};
	local ignored_animations = {
		["rbxassetid://120133391090244"] = true;
		["rbxassetid://138196552148011"] = true;
	}
	local block_animations = {};
	local melee_animations = {};

	for _, folder in ipairs(folders) do
		for _, obj in ipairs(folder:GetDescendants()) do
			if obj:IsA("Animation") then
				block_animations[obj.AnimationId] = true;
			end;
		end;
	end;

	for _, folder in ipairs(animation:GetChildren()) do
		if folder.Name ~= "Misc" then
			for _, obj in ipairs(folder:GetDescendants()) do
				if obj:IsA("Animation") then
					local name = obj.Name;
					if (name:match("^Melee[1-4]$") or name == "Down" or name == "Up") then
						melee_animations[obj.AnimationId] = true;
					end;
				end;
			end;
		end;
	end;

	local function hook_humanoid(humanoid)
		humanoid.AnimationPlayed:Connect(function(track)
			local anim = track.Animation;
			if not anim then
				return;
			end;
			local id = anim.AnimationId;
			if (ignored_animations[id]) then
				return;
			end;
			if (Toggles.silent_animation.value) then
				if (Toggles.melee_animation.value and melee_animations[anim.AnimationId]) then
					track:Stop(0);
				elseif (Toggles.block_animation.value and block_animations[anim.AnimationId]) then
					track:Stop(0);
				end;
			end;
		end);
	end;

	hook_humanoid(humanoid);
	localplayer.CharacterAdded:Connect(function()
		hook_humanoid(localplayer.Character:WaitForChild("Humanoid"));
	end);

	local stun_connection;

	local stun_names = {
		Stun = true;
		NoSprint = true;
		NoJump = true;
		Block = true;
	};

	local setup_stun = LPH_JIT(function(char)
		local info = char:FindFirstChild("Info");
		if not info then
			info = char:WaitForChild("Info", 5);
		end;

		if not info then
			return;
		end;

		for _, child in ipairs(info:GetChildren()) do
			if stun_names[child.Name] then
				child:Destroy();
			end;
		end;

		stun_connection = create_connection(info.ChildAdded, LPH_JIT_MAX(function(child)
			if stun_names[child.Name] then
				task.defer(child.Destroy, child);
			end;
		end));
	end);

	stun_group:add_toggle("no_stun", {
		text = "no stun";
		default = false;
		callback = function(enabled)
			if stun_connection then
				disconnect_connection(stun_connection);
				stun_connection = nil;
			end;

			if enabled then
				local char = localplayer.Character;
				if char then
					setup_stun(char);
				end;
			end;
		end;
	});

	stun_group:add_toggle("anti_blackhole", {
		text = "anti blackhole";
		default = false;
	});

	localplayer.CharacterAdded:Connect(function(char)
		if Toggles.no_stun and Toggles.no_stun.value then
			if stun_connection then
				disconnect_connection(stun_connection);
				stun_connection = nil;
			end;
			setup_stun(char);
		end;
	end);
	
	local qte_connection;
	local qte_child_connection;
	local qte_poll_thread;

	local function fire_remote()
		for _, plr in ipairs(players:GetPlayers()) do
			local character = plr.Character;
			if (not character) then
				continue;
			end;

			local remote = character:FindFirstChild("RemoteEvent");
			if (remote) then
				remote:FireServer(true);
			end;
		end;
	end;

	local function cleanup_qte()
		if (qte_poll_thread) then
			task.cancel(qte_poll_thread);
			qte_poll_thread = nil;
		end;

		if (qte_connection) then
			qte_connection:Disconnect();
			qte_connection = nil;
		end;
	end;

	local function cleanup_child()
		if (qte_child_connection) then
			qte_child_connection:Disconnect();
			qte_child_connection = nil;
		end;
	end;

	local function handle_qte(qte)
		cleanup_qte();

		if (not qte) then
			return;
		end;

		if (not Toggles.auto_qte_hiromi.value) then
			return;
		end;

		if (not Toggles.auto_qte_hiromi.value) then
			return;
		end;

		qte_connection = qte.AncestryChanged:Connect(function(_, parent)
			if (parent == nil) then
				cleanup_qte();

				task.defer(function()
					if (Toggles.auto_qte_hiromi.value) then
						listen_for_qte();
					end;
				end);
			end;
		end);

		qte_poll_thread = task.spawn(function()
			while (Toggles.auto_qte_hiromi.value) do
				fire_remote();
				task.wait(Options.qte_click_delay.value);
			end;
		end);
	end;

	listen_for_qte = function()
		cleanup_child();

		local qte_gui = localplayer.PlayerGui:FindFirstChild("QTE");
		local qte_pc = qte_gui and qte_gui:FindFirstChild("QTE_PC");

		if (qte_pc) then
			task.spawn(handle_qte, qte_pc);
			return;
		end;

		local watch_target = qte_gui or localplayer.PlayerGui;

		qte_child_connection = watch_target.ChildAdded:Connect(function(child)
			if (qte_gui) then
				if (child.Name == "QTE_PC") then
					cleanup_child();
					task.spawn(handle_qte, child);
				end;
			else
				if (child.Name == "QTE") then
					cleanup_child();

					local qte_pc_inner = child:FindFirstChild("QTE_PC");

					if (qte_pc_inner) then
						task.spawn(handle_qte, qte_pc_inner);
					else
						qte_child_connection = child.ChildAdded:Connect(function(inner)
							if (inner.Name == "QTE_PC") then
								cleanup_child();
								task.spawn(handle_qte, inner);
							end;
						end);
					end;
				end;
			end;
		end);
	end;

	auto_group:add_toggle("auto_qte_hiromi", {
		text = "auto qte hiromi";
		default = false;
	});

	auto_group:add_slider("qte_click_delay", {
		text = "qte click delay";
		default = 0;
		min = 0;
		max = 1;
		rounding = 2;
		suffix = "s";
		compact = true;
	});

	Toggles.auto_qte_hiromi:on_changed(function()
		if (Toggles.auto_qte_hiromi.value) then
			listen_for_qte();
		else
			cleanup_qte();
			cleanup_child();
		end;
	end);
	
	local todo_remote = repstorage.Knit.Knit.Services.TodoService.RE.Activated;
	local rayparams = RaycastParams.new();
	rayparams.FilterType = Enum.RaycastFilterType.Exclude;

	local valid_throwables = {
		Trash = true;
		Chair = true;
		Arcade = true;
		Arcade2 = true;
		Extinguish = true;
	};

	local valid_swap_anims = {
		["rbxassetid://131358603583212"] = true;
		["rbxassetid://91074768993486"] = true;
		["rbxassetid://116040503139675"] = true;
	};

	local waiting_for_swap = false;
	local locked_target = nil;

	local max_screen_dist = 140;

	local function get_mouse_target()
		local mouse_pos = userinputservice:GetMouseLocation();

		local best_target = nil;
		local best_dist = math.huge;

		local function check(model, t_type, ref)
			local hrp = model:FindFirstChild("HumanoidRootPart");
			if (not hrp) then return; end;

			local screen_pos, on_screen = camera:WorldToViewportPoint(hrp.Position);
			if (not on_screen) then return; end;

			local dist = (Vector2.new(screen_pos.X, screen_pos.Y) - mouse_pos).Magnitude;

			if (dist < best_dist and dist <= max_screen_dist) then
				best_dist = dist;
				best_target = { type = t_type, target = ref or model };
			end;
		end;

		local function check_object(model)
			local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart");
			if (not part) then return; end;

			local screen_pos, on_screen = camera:WorldToViewportPoint(part.Position);
			if (not on_screen) then return; end;

			local dist = (Vector2.new(screen_pos.X, screen_pos.Y) - mouse_pos).Magnitude;

			if (dist < best_dist and dist <= max_screen_dist) then
				best_dist = dist;
				best_target = { type = "object", target = model };
			end;
		end;

		for _, player in players:GetPlayers() do
			if (player ~= localplayer and player.Character) then
				check(player.Character, "player", player);
			end;
		end;

		local chars = workspace:FindFirstChild("Characters");
		if (chars) then
			for _, model in chars:GetChildren() do
				check(model, "player", model);
			end;
		end;

		local throwable = workspace.Map and workspace.Map:FindFirstChild("Destructible") and workspace.Map.Destructible:FindFirstChild("Throwable");

		if (throwable) then
			for _, model in throwable:GetChildren() do
				if (valid_throwables[model.Name]) then
					check_object(model);
				end;
			end;
		end;

		return best_target;
	end;

	local function get_comp_time()
		if (not locked_target) then
			return nil;
		end;
		local ping = stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000;
		local in_todo_ult = localplayer.Character:GetAttribute("InUlt");
		local character = locked_target.type == "player" and (locked_target.target:IsA("Player") and locked_target.target.Character or locked_target.target);
		local value = character and character:GetAttribute("Ragdoll");
		local ragdolled = value and value > 0;
		local wait_time = in_todo_ult and 0.30 or ((locked_target.type == "player" and not ragdolled) and 0.60 or 0.30);
		return math.max(0, wait_time - ping);
	end;

	local function is_todo()
		if (userinputservice:GetFocusedTextBox()) then
			return false;
		end;
		local char = localplayer.Character;
		if (not char) then
			return false;
		end;
		if (char:GetAttribute("Moveset") ~= "Todo") then
			return false;
		end;
		return true;
	end;

	local stored_target = nil;
	userinputservice.InputBegan:Connect(function(input, processed)
		if processed then return; end;

		if input.KeyCode == Enum.KeyCode.R and is_todo() then
			stored_target = get_mouse_target();
		end;
	end);

	local function handle_swap_anim(track)
		if (not Toggles.auto_todo_swap.value) then return; end;
		local anim = track.Animation;
		if (not anim) then return; end;
		local anim_id = anim.AnimationId;
		if (not valid_swap_anims[anim_id]) then return; end;
		if (waiting_for_swap) then return; end;
		if (not is_todo()) then return; end;
		locked_target = stored_target;
		local delay_time = get_comp_time();
		if (not delay_time) then return; end;
		waiting_for_swap = true;
		task.delay(delay_time, function()
			waiting_for_swap = false;
			if (not is_todo()) then return; end;
			if (not locked_target) then return; end;
			todo_remote:FireServer(false);
		end);
	end

	local function setup_char(char)
		local humanoid = char:WaitForChild("Humanoid");
		humanoid.AnimationPlayed:Connect(handle_swap_anim);
	end;

	if (localplayer.Character) then
		setup_char(localplayer.Character);
	end;
	localplayer.CharacterAdded:Connect(setup_char);

	auto_group:add_toggle("auto_todo_swap", {
		text = "todo swap";
		default = false;
	});

	dash_group:add_toggle("dash_cooldown", {
		text = "dash cooldown";
		default = false;
	});

	dash_group:add_slider("dash_cooldown_value", {
		text = "cooldown";
		compact = true;
		rounding = 1;
		default = 0.2;
		min = 0;
		max = 3;
		suffix = "s";
	});

	dash_group:add_toggle("force_front_dash", {
		text = "force front dash";
		default = false;
	});
	
	local Knit = require(repstorage.Knit.Knit);
	local movement_controller = Knit.GetController("MovementController");
	local original = rawget(movement_controller, "DashRequest");
	local dash;
	local upvals = debug.getupvalues(original);
	if #upvals >= 6 and type(upvals[4]) == "number" and type(upvals[6]) == "number" then
		dash = original;
	else
		for _, v in pairs(upvals) do
			if type(v) == "function" then
				local sub = debug.getupvalues(v);
				if #sub >= 6 and type(sub[4]) == "number" and type(sub[6]) == "number" then
					dash = v;
					break;
				end;
			end;
		end;
	end;

	local last_front_dash = 0;
	userinputservice.InputBegan:Connect(function(input, gpe)
		if gpe then return; end;
		if input.KeyCode ~= Enum.KeyCode.Q then
			return;
		end;
		if not character or not character.Parent then
			return;
		end;
		if (not Toggles.force_front_dash.value) then
			return;
		end;
		if tick() - last_front_dash < Options.dash_cooldown_value.value then
			return;
		end;
		local info = character:FindFirstChild("Info")
		if not info then
			return;
		end;
		if (info:FindFirstChild("InSkill")) then
			return;
		end;
		if info:FindFirstChild("DisableChase") then
			last_front_dash = tick();
			movement_controller:Dash(localplayer, character, "Front");
		end;
	end);

	local last = 0;
	local old; old = hookfunction(dash, newcclosure(function(self, ...)
		if (not checkcaller() and Toggles.dash_cooldown.value) then
			if (tick() - last >= Options.dash_cooldown_value.value) then
				last = tick();
				debug.setupvalue(old, 4, 0);
				debug.setupvalue(old, 6, 2);
			end;
		end;
		return old(self, ...);
	end));

	local burst_connection;
	local burst_char_connection;
	local burst_retry_token = 0;

	local get_burst_direction = LPH_JIT_MAX(function()
		local hum = (localplayer.Character and localplayer.Character:FindFirstChildOfClass("Humanoid")) or humanoid;
		local move_direction = hum and hum.MoveDirection or vector3_zero;

		if move_direction.Magnitude > 0.1 then
			local hrp = localplayer.Character and localplayer.Character:FindFirstChild("HumanoidRootPart");
			if hrp then
				local cf = hrp.CFrame;
				local right = math.round(move_direction:Dot(cf.RightVector));
				local forward = math.round(move_direction:Dot(cf.LookVector));

				if right == 1 then return "Right"; end;
				if right == -1 then return "Left"; end;
				if forward == 1 then return "Front"; end;
				if forward == -1 then return "Back"; end;
			end;
		end;

		local w = userinputservice:IsKeyDown(Enum.KeyCode.W);
		local a = userinputservice:IsKeyDown(Enum.KeyCode.A);
		local d = userinputservice:IsKeyDown(Enum.KeyCode.D);
		local s = userinputservice:IsKeyDown(Enum.KeyCode.S);

		if a and d then
			return math_random(0, 1) == 0 and "Left" or "Right";
		elseif a then
			return "Left";
		elseif d then
			return "Right";
		elseif w then
			return "Front";
		elseif s then
			return "Back";
		end;

		return "Left";
	end);

	local function try_burst(char, dir)
		repstorage.Knit.Knit.Services.MovementService.RE.Dash:FireServer(dir, true);
	end;

	local setup_burst = LPH_JIT(function(char)
		if burst_connection then
			disconnect_connection(burst_connection);
			burst_connection = nil;
		end;

		if not char then return; end;

		burst_connection = create_connection(
			char:GetAttributeChangedSignal("Burst"),
			LPH_JIT_MAX(function()
				if not Toggles.auto_burst or not Toggles.auto_burst.value then
					return;
				end;

				if char:GetAttribute("Burst") == true then
					local dir = get_burst_direction();
					try_burst(char, dir);
				end;
			end)
		);
	end);

	stun_group:add_toggle("auto_burst", {
		text = "auto burst";
		default = false;
		callback = function(enabled)
			burst_retry_token += 1;
			local current_token = burst_retry_token;

			if burst_connection then
				disconnect_connection(burst_connection);
				burst_connection = nil;
			end;

			if burst_char_connection then
				disconnect_connection(burst_char_connection);
				burst_char_connection = nil;
			end;

			if not enabled then
				return;
			end;

			local char = localplayer.Character;
			if char then
				setup_burst(char);
			end;

			burst_char_connection = create_connection(localplayer.CharacterAdded, function(new_char)
				setup_burst(new_char);
			end);

			task.spawn(function()
				while Toggles.auto_burst and Toggles.auto_burst.value and current_token == burst_retry_token do
					local current_char = localplayer.Character;
					if current_char and current_char:GetAttribute("Burst") == true then
						local dir = get_burst_direction();
						try_burst(current_char, dir);
					end;
					task.wait(0.02);
				end;
			end);
		end;
	});

	local teleport_re = game:GetService("ReplicatedStorage").Knit.Knit.Services.AntiCheatService.RE.Teleport;
	local teleport_fire_count = 0;

	local old_fire; old_fire = hookfunction(teleport_re.FireServer, newcclosure(function(self, ...)
		if not checkcaller() and self == teleport_re then
			teleport_fire_count = teleport_fire_count + 1;
		end;
		return old_fire(self, ...);
	end));

	local last_right_activated_args = nil;
	local old_namecall; old_namecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		if not checkcaller() then
			local method = getnamecallmethod();
			if self == teleport_re and method == "FireServer" then
				teleport_fire_count = teleport_fire_count + 1;
			elseif self == runservice.Stepped and method == "Connect" and Toggles.anti_blackhole and Toggles.anti_blackhole.value then
				local callback = ...;
				local info = debug.getinfo(callback);
				if info and info.source and info.source:lower():match("yuki") then
					return old_namecall(self, function() end);
				end;
			end;
		end;
		return old_namecall(self, ...);
	end));

	localplayer.CharacterAdded:Connect(function()
		teleport_fire_count = 0;
	end);
	
	stun_group:add_button("secret", function()
		local char = localplayer.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		
		hrp.CFrame = cframe_new(hrp.CFrame.Position.X, 1000, hrp.CFrame.Position.Z);
		fly_cframe = cframe_new(hrp.CFrame.Position.X, 1000, hrp.CFrame.Position.Z);
		task.wait(0.1);
		if teleport_fire_count % 2 ~= 0 then
			local pos = hrp.CFrame.Position;
			hrp.CFrame = cframe_new(pos.X + 9999, pos.Y, pos.Z);
			task.wait(0.1);
			hrp.CFrame = cframe_new(pos.X, pos.Y, pos.Z);
			task.wait(0.1);
		end;
		repstorage.Knit.Knit.Services.JoinService.RE.Change:FireServer(tostring(char:GetAttribute("Moveset")));
	end);

