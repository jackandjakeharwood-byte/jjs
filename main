	local function apply_skybox(name)
		if (not sky_instance) then return; end;
		local data = skybox_presets[name];
		if (not data) then return; end;
		for prop, val in pairs(data) do
			sky_instance[prop] = val;
		end;
	end;

	local function restore_skybox()
		if (not sky_instance or not original_sky) then return; end;
		for prop, val in pairs(original_sky) do
			sky_instance[prop] = val;
		end;
	end;

	local function create_weather(weather_type)
		if (weather_part) then
			weather_part:Destroy();
			weather_part = nil;
			weather_emitter = nil;
		end;

		weather_part = instance_new("Part");
		weather_part.Size = vector3_new(40, 40, 85);
		weather_part.CanCollide = false;
		weather_part.Massless = true;
		weather_part.CastShadow = false;
		weather_part.Transparency = 1;
		weather_part.Anchored = true;
		weather_part.Name = "\0";
		weather_part.Parent = workspace;

		local preset = weather_presets[weather_type];
		if (not preset) then return; end;

		weather_emitter = instance_new("ParticleEmitter");
		for prop, val in pairs(preset) do
			weather_emitter[prop] = val;
		end;

		local color = Options.weather_color and Options.weather_color.value or color3_fromrgb(255, 255, 255);
		weather_emitter.Color = colorsequence_new(color);
		weather_emitter.Parent = weather_part;
	end;

	local function destroy_weather()
		if (weather_part) then
			weather_part:Destroy();
			weather_part = nil;
			weather_emitter = nil;
		end;
	end;

	local function apply_world_time()
		if (Toggles.world_time_enabled and Toggles.world_time_enabled.value) then
			local v = Options.world_time_value and Options.world_time_value.value or 12;
			lighting.ClockTime = v;
		end;
	end;

	create_connection(lighting:GetPropertyChangedSignal("ClockTime"), function()
		apply_world_time();
	end);

	if (Toggles.world_time_enabled) then
		Toggles.world_time_enabled:on_changed(function()
			apply_world_time();
		end);
	end;

	if (Options.world_time_value) then
		Options.world_time_value:on_changed(function()
			apply_world_time();
		end);
	end;

	local function apply_ambient()
		if (Toggles.ambient_enabled and Toggles.ambient_enabled.value) then
			local c = Options.ambient_color and Options.ambient_color.value;
			local o = Options.outdoor_ambient_color and Options.outdoor_ambient_color.value;
			if (c) then
				lighting.Ambient = c;
			end;
			if (o) then
				lighting.OutdoorAmbient = o;
			end;
		end;
	end;

	create_connection(lighting:GetPropertyChangedSignal("Ambient"), function()
		apply_ambient();
	end);

	create_connection(lighting:GetPropertyChangedSignal("OutdoorAmbient"), function()
		apply_ambient();
	end);

	if (Toggles.ambient_enabled) then
		Toggles.ambient_enabled:on_changed(function()
			apply_ambient();
		end);
	end;

	if (Options.ambient_color) then
		Options.ambient_color:on_change(function()
			apply_ambient();
		end);
	end;

	if (Options.outdoor_ambient_color) then
		Options.outdoor_ambient_color:on_changed(function()
			apply_ambient();
		end);
	end;

	update_weather_connection = LPH_NO_VIRTUALIZE(function()
		local enabled = Toggles.weather_enabled and Toggles.weather_enabled.value;
		if enabled then
			if not weather_connection then
				weather_connection = create_connection(runservice.Heartbeat, LPH_JIT(function(dt)
					if (weather_part and weather_part.Parent) then
						weather_part.CFrame = cframe_new(camera.CFrame.Position + vector3_new(0, 20, 0));
					end;
				end));
			end;
		else
			if weather_connection then
				disconnect_connection(weather_connection);
				weather_connection = nil;
			end;
		end;
	end);

	local world_visuals_bound = false;
	update_world_visuals_binding = LPH_NO_VIRTUALIZE(function()
		local motion_blur = Toggles.motion_blur_enabled and Toggles.motion_blur_enabled.value;
		local aspect_ratio = Toggles.aspect_ratio_enabled and Toggles.aspect_ratio_enabled.value;
		local need_bind = motion_blur or aspect_ratio;

		if need_bind then
			if not world_visuals_bound then
				world_visuals_bound = true;
				runservice:BindToRenderStep("world_visuals_render", enum.RenderPriority.Camera.Value + 1, function(dt)
					if (Toggles.motion_blur_enabled and Toggles.motion_blur_enabled.value and blur_effect) then
						local look = camera.CFrame.LookVector;
						if (last_look_vector) then
							local intensity = Options.motion_blur_intensity and Options.motion_blur_intensity.value or 25;
							local delta = (look - last_look_vector).Magnitude * (intensity * 110) * dt;
							smoothed_blur = smoothed_blur + (delta - smoothed_blur) * math_min(dt * 900, 1);
							blur_effect.Size = smoothed_blur;
						end;
						last_look_vector = look;
					else
						last_look_vector = nil;
						smoothed_blur = 0;
					end;
					if (Toggles.aspect_ratio_enabled and Toggles.aspect_ratio_enabled.value) then
						local v = Options.aspect_ratio_value and Options.aspect_ratio_value.value or 1;
						camera.CFrame = camera.CFrame * cframe_new(0, 0, 0, 1, 0, 0, 0, v, 0, 0, 0, 1);
					end;
				end);
			end;
		else
			if world_visuals_bound then
				world_visuals_bound = false;
				runservice:UnbindFromRenderStep("world_visuals_render");
				last_look_vector = nil;
				smoothed_blur = 0;
			end;
		end;
	end);

