	other_world:add_toggle("background_noise_enabled", {
		text = "background noise";
		default = false;
		callback = function(enabled)
			if (ambient_sound) then
				ambient_sound:Destroy();
				ambient_sound = nil;
			end;
			if (enabled) then
				local stype = Options.background_noise_sound and Options.background_noise_sound.value or "night";
				local sid = sound_presets[stype];
				if (sid) then
					ambient_sound = instance_new("Sound");
					ambient_sound.SoundId = sid;
					ambient_sound.Volume = (Options.background_noise_volume and Options.background_noise_volume.value or 25) / 65;
					ambient_sound.Looped = true;
					ambient_sound.Name = "\0";
					ambient_sound.Parent = gethui();
					ambient_sound:Play();
				end;
			end;
		end;
	});

	other_world:add_dropdown("background_noise_sound", {
		text = "sound";
		default = "night";
		values = {"windy winter", "thunderstorm", "light rain", "night", "day"};
		callback = function(value)
			if (ambient_sound) then
				local sid = sound_presets[value];
				if (sid) then
					ambient_sound.SoundId = sid;
					ambient_sound:Stop();
					ambient_sound:Play();
				end;
			end;
		end;
	});

	other_world:add_slider("background_noise_volume", {
		text = "volume";
		default = 25;
		min = 0;
		max = 100;
		rounding = 0;
		compact = true;
		callback = function(value)
			if (ambient_sound) then
				ambient_sound.Volume = value / 65;
			end;
		end;
