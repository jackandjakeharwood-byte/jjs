do
	local cd_character_data = {};
	local cd_connections = {};
	local cd_global_connections = {};
	local cd_initialized_players = {};
	local stun_template_cache = nil;

	local burst_connections = {};
	local burst_vis_data = {};

	local function is_character_dead(char)
		if not char then return true; end;
		return char:GetAttribute("Dead") and char:GetAttribute("DeathP");
	end;

	local function clear_burst_visual(char)
		if not char then return; end;
		local data = burst_vis_data[char];
		if data then
			if data.highlight then
				data.highlight:Destroy();
				data.highlight = nil;
			end;
			if data.icon then
				data.icon:Destroy();
				data.icon = nil;
			end;
		end;
		local icon = char:FindFirstChild("BurstIcon");
		if icon and icon:IsA("BillboardGui") then
			icon:Destroy();
		end;
		local highlight = char:FindFirstChild("Highlight");
		if highlight and highlight:IsA("Highlight") and highlight.FillColor == Color3.fromRGB(255, 255, 255) and highlight.OutlineColor == Color3.fromRGB(255, 255, 255) then
			highlight:Destroy();
		end;
	end;

	local SPECIAL_READY_STYLES = {
